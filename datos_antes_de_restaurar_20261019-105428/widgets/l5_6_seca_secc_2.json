{
  "kind": "l5_6_seca_secc_2",
  "nombre": "L5 6 SECA SECC 2",
  "html": "<div class=\"ls56-widget\">\n  <svg\n    class=\"ls56-svg\"\n    viewBox=\"0 0 914 630\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Zona 3 Secador Línea 5\"\n  >\n    <defs>\n      <!-- Acabado metálico suave -->\n      <linearGradient\n        id=\"ls56-roller-metal\"\n        x1=\"15%\"\n        y1=\"0%\"\n        x2=\"85%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"ls56-metal-stop\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"ls56-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Sombra ambiental y de contacto -->\n      <filter\n        id=\"ls56-roller-shadow\"\n        x=\"-30%\"\n        y=\"-30%\"\n        width=\"160%\"\n        height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\"\n          dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\"\n          dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!--\n        Válvula transparente.\n        Actuador ovalado: rx=1.5, ry=6.5.\n        Unión horizontal: 0.7 px.\n      -->\n      <g id=\"ls56-valve\">\n        <path\n          class=\"ls56-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n\n        <path\n          class=\"ls56-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n\n        <line\n          class=\"ls56-valve-stem\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"13\"\n          y2=\"0\"\n        />\n\n        <ellipse\n          class=\"ls56-valve-actuator\"\n          cx=\"13\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n    </defs>\n\n    <!-- =====================================================\n         CIRCUITO SUPERIOR DE VAPOR\n         ===================================================== -->\n    <g>\n      <!-- Alimentación superior y calentador derecho -->\n      <path\n        class=\"ls56-steam ls56-valve-connection\"\n        d=\"\n          M 181 164\n          L 163 137\n          V 44\n          H 635\n          V 23\n          L 645 33\n          L 656 23\n          V 36\n        \"\n      />\n\n      <!-- Calentador izquierdo -->\n      <path\n        class=\"ls56-steam\"\n        d=\"\n          M 210 44\n          V 23\n          L 221 33\n          L 231 23\n          V 51\n        \"\n      />\n\n      <!-- Calentador central -->\n      <path\n        class=\"ls56-steam\"\n        d=\"\n          M 421 44\n          V 23\n          L 432 33\n          L 442 23\n          V 51\n        \"\n      />\n\n      <!-- Salida de la válvula superior -->\n      <path\n        class=\"ls56-steam ls56-valve-connection\"\n        d=\"\n          M 656 54\n          V 62\n        \"\n      />\n\n      <!-- Válvula superior -->\n      <use\n        href=\"#ls56-valve\"\n        transform=\"translate(656 45)\"\n      />\n    </g>\n\n    <!-- =====================================================\n         CONDENSADO SUPERIOR\n         ===================================================== -->\n    <path\n      class=\"ls56-condensate\"\n      d=\"\n        M 231 51\n        V 62\n        H 693\n        V 143\n        L 768 341\n        V 591\n\n        M 442 51\n        V 62\n      \"\n    />\n\n    <!-- Conexión de control hacia la cuba de pre-estiro -->\n    <g>\n      <path\n        class=\"ls56-control\"\n        d=\"\n          M 604 80\n          V 118\n          H 770\n        \"\n      />\n\n      <circle\n        class=\"ls56-control-node\"\n        cx=\"604\"\n        cy=\"80\"\n        r=\"3.5\"\n      />\n    </g>\n\n    <!-- =====================================================\n         CIRCUITO INFERIOR DE VAPOR\n         ===================================================== -->\n    <g>\n      <!--\n        Montante dividido alrededor de la válvula.\n        Termina en el colector de vapor.\n      -->\n      <path\n        class=\"ls56-steam ls56-valve-connection\"\n        d=\"\n          M 218 229\n          V 354\n\n          M 218 372\n          V 550\n        \"\n      />\n\n      <!-- Colector inferior y calentador derecho -->\n      <path\n        class=\"ls56-steam\"\n        d=\"\n          M 218 318\n          H 676\n          V 295\n          L 687 305\n          L 698 295\n          V 323\n        \"\n      />\n\n      <!-- Calentador izquierdo -->\n      <path\n        class=\"ls56-steam\"\n        d=\"\n          M 262 318\n          V 296\n          L 273 306\n          L 283 296\n          V 324\n        \"\n      />\n\n      <!-- Calentador central -->\n      <path\n        class=\"ls56-steam\"\n        d=\"\n          M 503 318\n          V 296\n          L 514 306\n          L 524 296\n          V 324\n        \"\n      />\n\n      <!-- Control de la válvula inferior -->\n      <path\n        class=\"ls56-control\"\n        d=\"\n          M 364 266\n          V 363\n          H 233\n        \"\n      />\n\n      <circle\n        class=\"ls56-control-node\"\n        cx=\"364\"\n        cy=\"266\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#ls56-valve\"\n        transform=\"translate(218 363)\"\n      />\n    </g>\n\n    <!-- =====================================================\n         CONDENSADO INFERIOR\n         ===================================================== -->\n    <path\n      class=\"ls56-condensate\"\n      d=\"\n        M 283 324\n        V 335\n        H 743\n        V 591\n\n        M 524 324\n        V 335\n\n        M 698 323\n        V 335\n      \"\n    />\n\n    <!-- =====================================================\n         COLECTORES PRINCIPALES\n         ===================================================== -->\n    <path\n      class=\"ls56-steam ls56-main\"\n      d=\"M 0 550 H 914\"\n    />\n\n    <path\n      class=\"ls56-condensate ls56-main\"\n      d=\"M 0 591 H 914\"\n    />\n\n    <!-- =====================================================\n         CUERDA\n\n         Recorrido continuo con entradas y salidas tangentes.\n         Se dibuja detrás de los cuerpos de las poleas.\n         ===================================================== -->\n    <path\n      class=\"ls56-fiber\"\n      d=\"\n        M 165 304\n        L 179.302 179.733\n\n        A 42 44 0 0 1 262.806 189.224\n        L 258.190 239.371\n\n        A 42 43.5 0 0 0 341.993 242.719\n        L 341.007 185.799\n\n        A 42 44 0 0 1 424.934 187.463\n        L 422.064 241.093\n\n        A 42 43.5 0 0 0 505.936 241.093\n        L 503.066 187.463\n\n        A 42 44 0 0 1 586.813 189.142\n        L 582.182 240.451\n\n        A 42 43.5 0 0 0 665.953 242.445\n        L 661 134\n      \"\n    />\n\n    <!-- =====================================================\n         POLEAS\n         ===================================================== -->\n    <g>\n      <!-- Polea 9 -->\n      <ellipse\n        class=\"ls56-roller-body\"\n        cx=\"221\"\n        cy=\"185\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 10 -->\n      <ellipse\n        class=\"ls56-roller-body\"\n        cx=\"300\"\n        cy=\"243.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Polea 11 -->\n      <ellipse\n        class=\"ls56-roller-body\"\n        cx=\"383\"\n        cy=\"185\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 12 -->\n      <ellipse\n        class=\"ls56-roller-body\"\n        cx=\"464\"\n        cy=\"243.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Polea 13 -->\n      <ellipse\n        class=\"ls56-roller-body\"\n        cx=\"545\"\n        cy=\"185\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 14 -->\n      <ellipse\n        class=\"ls56-roller-body\"\n        cx=\"624\"\n        cy=\"244.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n    </g>\n\n    <!-- =====================================================\n         NUMERACIÓN SOBRE LAS POLEAS\n         ===================================================== -->\n    <g class=\"ls56-roller-number\">\n      <text x=\"221\" y=\"134\">9</text>\n      <text x=\"300\" y=\"194\">10</text>\n      <text x=\"383\" y=\"134\">11</text>\n      <text x=\"464\" y=\"194\">12</text>\n      <text x=\"545\" y=\"134\">13</text>\n      <text x=\"624\" y=\"195\">14</text>\n    </g>\n\n    <!-- =====================================================\n         TEXTOS\n         ===================================================== -->\n    <g>\n      <text\n        class=\"ls56-equipment-label\"\n        x=\"793\"\n        y=\"71\"\n      >\n        <tspan x=\"793\" dy=\"0\">CUBA DE PRE-ESTIRO B</tspan>\n        <tspan x=\"793\" dy=\"16\">(LAVADORA)</tspan>\n      </text>\n\n      <text\n        class=\"ls56-zone-label\"\n        x=\"529\"\n        y=\"543\"\n      >ZONA 3</text>\n\n      <text\n        class=\"ls56-steam-label\"\n        x=\"27\"\n        y=\"542\"\n      >Vapor 15 bar</text>\n\n      <text\n        class=\"ls56-condensate-label\"\n        x=\"27\"\n        y=\"583\"\n      >Condensado</text>\n\n      <text\n        class=\"ls56-footer\"\n        x=\"864\"\n        y=\"619\"\n      >Zona 3 Secador Línea #5</text>\n    </g>\n  </svg>\n</div>",
  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ls56-widget {\n  --ls56-metal: #D7D8DB;\n  --ls56-outline: #4E4E4E;\n  --ls56-fiber: #0A638F;\n  --ls56-steam: #930606;\n  --ls56-condensate: #4E4E4E;\n  --ls56-control: #01524F;\n  --ls56-valve: #0E0E55;\n  --ls56-text: #000000;\n\n  display: grid;\n  place-items: center;\n\n  width: 100%;\n  height: 100%;\n\n  overflow: hidden;\n  background: transparent;\n\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  pointer-events: none;\n}\n\n.ls56-svg {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  overflow: hidden;\n  background: transparent;\n\n  shape-rendering: geometricPrecision;\n}\n\n/* Poleas */\n\n.ls56-metal-stop {\n  stop-color: var(--ls56-metal);\n}\n\n.ls56-roller-body {\n  fill: url(\"#ls56-roller-metal\");\n\n  stroke: var(--ls56-outline);\n  stroke-width: 2.2px;\n\n  filter: url(\"#ls56-roller-shadow\");\n}\n\n.ls56-roller-number {\n  fill: var(--ls56-text);\n  stroke: none;\n\n  font-family: \"IBM Plex Mono\", Consolas, monospace;\n  font-size: 13px;\n  font-weight: 700;\n\n  text-anchor: middle;\n}\n\n/* Cuerda */\n\n.ls56-fiber {\n  fill: none;\n\n  stroke: var(--ls56-fiber);\n  stroke-width: 1.8px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Tuberías */\n\n.ls56-steam,\n.ls56-condensate,\n.ls56-control {\n  fill: none;\n\n  stroke-width: 1.6px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ls56-steam {\n  stroke: var(--ls56-steam);\n}\n\n.ls56-condensate {\n  stroke: var(--ls56-condensate);\n}\n\n.ls56-control {\n  stroke: var(--ls56-control);\n}\n\n.ls56-main {\n  stroke-width: 2px;\n}\n\n.ls56-valve-connection {\n  stroke-linecap: butt;\n}\n\n.ls56-control-node {\n  fill: var(--ls56-control);\n  stroke: none;\n}\n\n/* Válvulas */\n\n.ls56-valve-body {\n  fill: none;\n\n  stroke: var(--ls56-valve);\n  stroke-width: 1.4px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ls56-valve-stem {\n  fill: none;\n\n  stroke: var(--ls56-valve);\n  stroke-width: 0.7px;\n  stroke-linecap: butt;\n}\n\n.ls56-valve-actuator {\n  fill: var(--ls56-valve);\n  stroke: var(--ls56-valve);\n  stroke-width: 1px;\n}\n\n/* Textos */\n\n.ls56-equipment-label {\n  fill: var(--ls56-text);\n\n  font-size: 13px;\n  font-weight: 600;\n  text-anchor: middle;\n}\n\n.ls56-zone-label {\n  fill: var(--ls56-text);\n\n  font-size: 16px;\n  font-weight: 700;\n  text-anchor: middle;\n}\n\n.ls56-steam-label {\n  fill: var(--ls56-steam);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls56-condensate-label {\n  fill: var(--ls56-condensate);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls56-footer {\n  fill: var(--ls56-text);\n\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
