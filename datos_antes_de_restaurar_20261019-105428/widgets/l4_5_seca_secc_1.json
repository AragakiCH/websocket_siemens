{
  "kind": "l4_5_seca_secc_1",
  "nombre": "L4 5 SECA SECC 1",
  "html": "<div class=\"secador-widget\">\n  <svg\n    class=\"secador-svg\"\n    viewBox=\"0 0 900 577\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Zona 1 y 2 - Secador Línea #2\"\n  >\n    <defs>\n      <!--\n        CILINDROS Y POLEA GUÍA\n\n        Mismo metal satinado de los widgets anteriores.\n        Reflejo diagonal suave sobre la base #D7D8DB.\n      -->\n      <linearGradient\n        id=\"sec1-roller-metal\"\n        x1=\"15%\"\n        y1=\"0%\"\n        x2=\"85%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"roller-metal-base\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"roller-metal-base\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Sombra ambiental y sombra corta de contacto -->\n      <filter\n        id=\"sec1-roller-shadow\"\n        x=\"-30%\"\n        y=\"-30%\"\n        width=\"160%\"\n        height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\"\n          dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\"\n          dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n    </defs>\n\n    <!--\n      VAPOR\n\n      Se conservan los recorridos originales.\n      Las conexiones llegan al borde de las válvulas,\n      sin atravesar sus cuerpos transparentes.\n    -->\n    <g class=\"steam-system\">\n      <!-- Colector principal -->\n      <path\n        class=\"steam-line steam-main\"\n        d=\"M 15 489 L 884 489\"\n      />\n\n      <!-- ZONA 1 -->\n\n      <!--\n        Válvula centrada en y=367.\n        Borde superior y=358; borde inferior y=376.\n      -->\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 219 489 L 219 376\"\n      />\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 219 358 L 219 226\"\n      />\n\n      <path\n        class=\"steam-line\"\n        d=\"M 219 317 L 408 317\"\n      />\n\n      <!-- Calentador inferior izquierdo -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 255 317\n          L 255 294\n          L 266 305\n          L 276 294\n          L 276 334\n        \"\n      />\n\n      <!-- Calentador inferior derecho -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 408 317\n          L 408 294\n          L 419 305\n          L 429 294\n          L 429 334\n        \"\n      />\n\n      <!-- Alimentación superior de zona 1 -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 219 226\n          L 219 186\n          L 165 137\n          L 165 47\n          L 366 47\n        \"\n      />\n\n      <!-- Calentador superior izquierdo -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 212 47\n          L 212 24\n          L 223 35\n          L 234 24\n          L 234 64\n        \"\n      />\n\n      <!-- Calentador superior derecho -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 366 47\n          L 366 24\n          L 377 35\n          L 388 24\n          L 388 64\n        \"\n      />\n\n      <!-- ZONA 2 -->\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 548 489 L 548 376\"\n      />\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 548 358 L 548 229\"\n      />\n\n      <path\n        class=\"steam-line\"\n        d=\"M 548 317 L 749 317\"\n      />\n\n      <!-- Calentador inferior izquierdo -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 584 317\n          L 584 294\n          L 595 305\n          L 605 294\n          L 605 335\n        \"\n      />\n\n      <!-- Calentador inferior -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 749 317\n          L 749 294\n          L 760 305\n          L 770 294\n          L 770 335\n        \"\n      />\n\n      <!-- Alimentación superior de zona 2 -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 548 229\n          L 548 188\n          L 493 141\n          L 493 48\n          L 695 48\n        \"\n      />\n\n      <!-- Calentador superior izquierdo -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 540 48\n          L 540 25\n          L 551 36\n          L 562 25\n          L 562 64\n        \"\n      />\n\n      <!-- Calentador superior derecho -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 695 48\n          L 695 25\n          L 706 36\n          L 717 25\n          L 717 64\n        \"\n      />\n    </g>\n\n    <!-- CONDENSADO: recorridos originales -->\n    <g class=\"condensate-system\">\n      <!-- Retorno superior de zona 1 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 234 64\n          L 430 64\n          L 430 108\n          L 527 249\n          L 527 530\n        \"\n      />\n\n      <!-- Retorno inferior de zona 1 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 276 334\n          L 484 334\n          L 484 530\n        \"\n      />\n\n      <!-- Retorno superior de zona 2 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 562 64\n          L 759 64\n          L 759 107\n          L 859 250\n          L 859 530\n        \"\n      />\n\n      <!-- Retorno inferior de zona 2 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 605 335\n          L 812 335\n          L 812 530\n        \"\n      />\n\n      <!-- Colector principal -->\n      <path\n        class=\"condensate-line condensate-main\"\n        d=\"M 884 530 L 14 530\"\n      />\n    </g>\n\n    <!-- CONTROL: zona 2 alineada a 20 px a la izquierda del centro de la polea 7 -->\n    <g class=\"control-system\">\n      <!-- Zona 1 -->\n      <path\n        class=\"control-line\"\n        d=\"\n          M 364 268\n          L 364 367\n          L 236 367\n        \"\n      />\n\n      <circle\n        class=\"control-node\"\n        cx=\"364\"\n        cy=\"268\"\n        r=\"4\"\n      />\n\n      <!-- Zona 2 -->\n      <path\n        class=\"control-line\"\n        d=\"\n          M 681 264\n          L 681 367\n          L 565 367\n        \"\n      />\n\n      <circle\n        class=\"control-node\"\n        cx=\"681\"\n        cy=\"264\"\n        r=\"4\"\n      />\n    </g>\n\n    <!--\n      VÁLVULAS PROPORCIONALES\n\n      Actuadores ovalados: rx=1.5, ry=6.5.\n      Unión horizontal entre centros: 0.7 px.\n\n      El borde derecho de cada óvalo queda en x=17,\n      conservando la conexión con las líneas de control.\n    -->\n    <g class=\"valve-system\">\n      <!-- Zona 1 -->\n      <g\n        class=\"valve valve-vertical\"\n        transform=\"translate(219 367)\"\n      >\n        <line\n          class=\"valve-link\"\n          x1=\"0\" y1=\"0\"\n          x2=\"15.5\" y2=\"0\"\n        />\n\n        <path class=\"valve-body\" d=\"M -9 -9 L 9 -9 L 0 0 Z\" />\n        <path class=\"valve-body\" d=\"M -9 9 L 9 9 L 0 0 Z\" />\n\n        <ellipse\n          class=\"valve-dot\"\n          cx=\"15.5\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n\n      <!-- Zona 2 -->\n      <g\n        class=\"valve valve-vertical\"\n        transform=\"translate(548 367)\"\n      >\n        <line\n          class=\"valve-link\"\n          x1=\"0\" y1=\"0\"\n          x2=\"15.5\" y2=\"0\"\n        />\n\n        <path class=\"valve-body\" d=\"M -9 -9 L 9 -9 L 0 0 Z\" />\n        <path class=\"valve-body\" d=\"M -9 9 L 9 9 L 0 0 Z\" />\n\n        <ellipse\n          class=\"valve-dot\"\n          cx=\"15.5\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n    </g>\n\n    <!--\n      CUERDA\n\n      Recorrido original íntegro.\n      Se conserva la salida de la polea 8:\n        punto tangencial = (826.895, 237.999)\n        extremo = (822.630, 177.000)\n    -->\n    <g class=\"fiber-system\">\n      <path\n        class=\"fiber\"\n        d=\"\n          M 28 242\n\n          L 153 242\n\n          A 12 12 0 0 0\n            164.892 231.610\n\n          L 172.389 176.231\n\n          A 43 43 0 0 1\n            257.635 187.590\n\n          L 251.365 235.410\n\n          A 43 43 0 1 0\n            336.940 238.729\n\n          L 334.060 184.271\n\n          A 43 43 0 1 1\n            419.890 185.068\n\n          L 416.110 237.932\n\n          A 43 43 0 1 0\n            501.739 236.274\n\n          L 496.261 186.726\n\n          A 43 43 0 1 1\n            581.635 187.590\n\n          L 575.365 235.410\n\n          A 43 43 0 1 0\n            660.940 238.729\n\n          L 658.060 184.271\n\n          A 43 43 0 1 1\n            743.940 184.271\n\n          L 741.060 238.729\n\n          A 43 43 0 1 0\n            826.895 237.999\n\n          L 822.630 177.000\n        \"\n      />\n    </g>\n\n    <!--\n      CILINDROS Y POLEA GUÍA\n\n      Centros y radios originales.\n      Sin anillos interiores.\n      Borde de 2.2 px y acabado metálico.\n    -->\n    <g class=\"rollers\">\n      <!-- Polea guía -->\n      <g class=\"roller-unit roller-guide\">\n        <circle\n          class=\"roller-body\"\n          cx=\"153\"\n          cy=\"230\"\n          r=\"12\"\n        />\n      </g>\n\n      <!-- Cilindro 1 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"215\"\n          cy=\"182\"\n          r=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 2 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"294\"\n          cy=\"241\"\n          r=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 3 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"377\"\n          cy=\"182\"\n          r=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 4 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"459\"\n          cy=\"241\"\n          r=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 5 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"539\"\n          cy=\"182\"\n          r=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 6 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"618\"\n          cy=\"241\"\n          r=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 7 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"701\"\n          cy=\"182\"\n          r=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 8 -->\n      <g class=\"roller-unit roller-large\">\n        <circle\n          class=\"roller-body\"\n          cx=\"784\"\n          cy=\"241\"\n          r=\"43\"\n        />\n      </g>\n    </g>\n\n    <!--\n      NUMERACIÓN\n\n      Se conserva la posición original sobre cada cilindro.\n      Color negro y tamaño de 13 px.\n    -->\n    <g class=\"roller-labels\">\n      <text class=\"roller-label\" x=\"215\" y=\"128\">1</text>\n      <text class=\"roller-label\" x=\"294\" y=\"187\">2</text>\n\n      <text class=\"roller-label\" x=\"377\" y=\"128\">3</text>\n      <text class=\"roller-label\" x=\"459\" y=\"187\">4</text>\n\n      <text class=\"roller-label\" x=\"539\" y=\"128\">5</text>\n      <text class=\"roller-label\" x=\"618\" y=\"187\">6</text>\n\n      <text class=\"roller-label\" x=\"701\" y=\"128\">7</text>\n      <text class=\"roller-label\" x=\"784\" y=\"187\">8</text>\n    </g>\n\n    <!-- TEXTOS: posiciones originales -->\n    <g class=\"labels\">\n      <text\n        class=\"text-wash-line\"\n        x=\"33\"\n        y=\"220\"\n      >\n        <tspan x=\"33\" dy=\"0\">Línea de</tspan>\n        <tspan x=\"33\" dy=\"13\">lavado</tspan>\n      </text>\n\n      <text\n        class=\"text-steam\"\n        x=\"13\"\n        y=\"481\"\n      >Vapor 15 bar</text>\n\n      <text\n        class=\"text-condensate\"\n        x=\"13\"\n        y=\"522\"\n      >Condensado</text>\n\n      <text\n        class=\"text-zone\"\n        x=\"354\"\n        y=\"515\"\n      >ZONA 1</text>\n\n      <text\n        class=\"text-zone\"\n        x=\"708\"\n        y=\"515\"\n      >ZONA 2</text>\n\n      <text\n        class=\"text-footer\"\n        x=\"625\"\n        y=\"565\"\n      >Zona 1 y 2 - Secador Línea #4</text>\n    </g>\n  </svg>\n</div>",
  "css": ":root {\n  /* Tipografía */\n  --sec-font-family: \"Segoe UI\", Arial, sans-serif;\n  --sec-number-font: \"IBM Plex Mono\", Consolas, monospace;\n\n  /* Textos */\n  --sec-text-primary: #000000;\n  --sec-text-secondary: #000000;\n\n  /* Cuerda */\n  --sec-fiber-color: #0A638F;\n\n  /* Cilindros y polea guía */\n  --sec-roller-fill: #D7D8DB;\n  --sec-roller-border: #4E4E4E;\n  --sec-roller-number: #000000;\n\n  /* Tuberías */\n  --sec-steam-color: #930606;\n  --sec-condensate-color: #4E4E4E;\n\n  /* Control */\n  --sec-control-color: #01524F;\n\n  /* Válvulas */\n  --sec-valve-color: #0E0E55;\n\n  /* Grosores */\n  --sec-fiber-width: 1.8px;\n  --sec-roller-border-width: 2.2px;\n  --sec-process-width: 1.6px;\n  --sec-process-main-width: 2px;\n  --sec-control-width: 1.6px;\n  --sec-valve-width: 1.4px;\n\n  /* Numeración */\n  --sec-roller-number-size: 13px;\n}\n\n/* ==========================================================\n   ENTORNO TRANSPARENTE\n   ========================================================== */\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.secador-widget {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  font-family: var(--sec-font-family);\n  pointer-events: none;\n}\n\n.secador-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n/* Representación completamente estática */\n.secador-widget,\n.secador-widget * {\n  animation: none !important;\n  transition: none !important;\n}\n\n/* ==========================================================\n   METAL SATINADO\n   ========================================================== */\n\n.roller-metal-base {\n  stop-color: var(--sec-roller-fill);\n}\n\n.roller-body {\n  fill: url(\"#sec1-roller-metal\");\n  stroke: var(--sec-roller-border);\n  stroke-width: var(--sec-roller-border-width);\n  filter: url(\"#sec1-roller-shadow\");\n}\n\n/* ==========================================================\n   CUERDA\n   ========================================================== */\n\n.fiber {\n  fill: none;\n  stroke: var(--sec-fiber-color);\n  stroke-width: var(--sec-fiber-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* ==========================================================\n   NUMERACIÓN\n   ========================================================== */\n\n.roller-label {\n  fill: var(--sec-roller-number);\n  font-family: var(--sec-number-font);\n  font-size: var(--sec-roller-number-size);\n  font-weight: 700;\n  text-anchor: middle;\n  dominant-baseline: middle;\n}\n\n/* ==========================================================\n   TUBERÍAS CONTINUAS\n   ========================================================== */\n\n.steam-line,\n.condensate-line,\n.control-line {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.steam-line {\n  stroke: var(--sec-steam-color);\n  stroke-width: var(--sec-process-width);\n}\n\n.condensate-line {\n  stroke: var(--sec-condensate-color);\n  stroke-width: var(--sec-process-width);\n}\n\n.steam-main,\n.condensate-main {\n  stroke-width: var(--sec-process-main-width);\n}\n\n/*\n * La tubería termina exactamente en el borde de la válvula,\n * sin prolongar el trazo hacia su interior.\n */\n.valve-connection {\n  stroke-linecap: butt;\n}\n\n.steam-node {\n  fill: var(--sec-steam-color);\n  stroke: var(--sec-steam-color);\n  stroke-width: 1px;\n}\n\n/* ==========================================================\n   CONTROL\n   ========================================================== */\n\n.control-line {\n  stroke: var(--sec-control-color);\n  stroke-width: var(--sec-control-width);\n}\n\n.control-node {\n  fill: var(--sec-control-color);\n  stroke: var(--sec-control-color);\n  stroke-width: 1px;\n}\n\n/* ==========================================================\n   VÁLVULAS TRANSPARENTES\n   ========================================================== */\n\n.valve-body {\n  fill: none;\n  stroke: var(--sec-valve-color);\n  stroke-width: var(--sec-valve-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.valve-dot {\n  fill: var(--sec-valve-color);\n  stroke: var(--sec-valve-color);\n  stroke-width: 1px;\n}\n\n/* Unión horizontal entre la válvula y su actuador */\n.valve-link {\n  fill: none;\n  stroke: var(--sec-valve-color);\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n}\n\n/* ==========================================================\n   TEXTOS\n   ========================================================== */\n\n.labels text {\n  font-family: var(--sec-font-family);\n}\n\n.text-wash-line {\n  fill: var(--sec-text-primary);\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.text-steam {\n  fill: var(--sec-steam-color);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.text-condensate {\n  fill: var(--sec-condensate-color);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.text-zone {\n  fill: var(--sec-text-primary);\n  font-size: 18px;\n  font-weight: 600;\n  text-anchor: middle;\n}\n\n.text-footer {\n  fill: var(--sec-text-secondary);\n  font-size: 16px;\n  font-weight: 500;\n  font-style: italic;\n}",
  "js": "\"use strict\";\n\n/*\n * Secador Línea 2 — Zonas 1 y 2.\n *\n * Widget gráfico completamente estático.\n *\n * El acabado metálico, los reflejos y las sombras se definen\n * mediante SVG y CSS.\n *\n * Se conserva el recorrido original de la cuerda y la salida\n * de la polea 8 hasta el punto (822.630, 177.000).\n *\n * No utiliza tags, variables del PLC, WIDGET, onWidgetUpdate,\n * temporizadores, animaciones ni recursos externos.\n */",
  "meta": {
