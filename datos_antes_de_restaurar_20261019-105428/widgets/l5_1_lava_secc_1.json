{
  "kind": "l5_1_lava_secc_1",
  "nombre": "L5 1 LAVA SECC 1",
  "html": "<div class=\"wl5-widget\">\n  <svg\n    class=\"wl5-svg\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    viewBox=\"0 0 863 623\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    role=\"img\"\n    aria-label=\"Pre-Estiramiento Lavadora Línea 5\"\n  >\n    <defs>\n      <!-- Acabado satinado de las poleas. -->\n      <linearGradient\n        id=\"wl5-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\"/>\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"43%\" class=\"wl5-metal-stop\"/>\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\"/>\n        <stop offset=\"74%\" class=\"wl5-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\"/>\n      </linearGradient>\n\n      <!-- Acabado metálico de las cubas. -->\n      <linearGradient\n        id=\"wl5-tank-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#ECEEF0\"/>\n        <stop offset=\"16%\" stop-color=\"#E2E4E7\"/>\n        <stop offset=\"46%\" class=\"wl5-metal-stop\"/>\n        <stop offset=\"62%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"84%\" class=\"wl5-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C6C8CD\"/>\n      </linearGradient>\n\n      <!-- Franja azul inferior. -->\n      <linearGradient\n        id=\"wl5-liquid-gradient\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#B4DCEF\"/>\n        <stop offset=\"35%\" class=\"wl5-liquid-stop\"/>\n        <stop offset=\"75%\" class=\"wl5-liquid-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#92C3DE\"/>\n      </linearGradient>\n\n      <!-- Sombra ambiental y de contacto de las poleas. -->\n      <filter\n        id=\"wl5-roller-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\"/>\n          <feMergeNode in=\"rollerContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!-- Sombra suave de las cubas. -->\n      <filter\n        id=\"wl5-tank-shadow\"\n        x=\"-5%\" y=\"-30%\"\n        width=\"110%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"2\"\n          result=\"tankAmbientBlur\"\n        />\n        <feOffset\n          in=\"tankAmbientBlur\"\n          dx=\"0\" dy=\"2.5\"\n          result=\"tankAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.10\"\n          result=\"tankAmbientColor\"\n        />\n        <feComposite\n          in=\"tankAmbientColor\"\n          in2=\"tankAmbientOffset\"\n          operator=\"in\"\n          result=\"tankAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.5\"\n          result=\"tankContactBlur\"\n        />\n        <feOffset\n          in=\"tankContactBlur\"\n          dx=\"0\" dy=\"0.8\"\n          result=\"tankContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.15\"\n          result=\"tankContactColor\"\n        />\n        <feComposite\n          in=\"tankContactColor\"\n          in2=\"tankContactOffset\"\n          operator=\"in\"\n          result=\"tankContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"tankAmbientShadow\"/>\n          <feMergeNode in=\"tankContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!--\n        Válvula transparente.\n        Actuador: rx=1.5, ry=6.5.\n        Unión horizontal: 0.7 px.\n      -->\n      <g id=\"wl5-valve\">\n        <path\n          class=\"wl5-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n        <path\n          class=\"wl5-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n        <line\n          class=\"wl5-valve-stem\"\n          x1=\"0\" y1=\"0\"\n          x2=\"13\" y2=\"0\"\n        />\n        <ellipse\n          class=\"wl5-valve-actuator\"\n          cx=\"13\" cy=\"0\"\n          rx=\"1.5\" ry=\"6.5\"\n        />\n      </g>\n    </defs>\n\n    <!-- Posición del conjunto dentro del lienzo de referencia. -->\n    <g transform=\"translate(10 5)\">\n\n      <!-- ==================================================\n           CUBA 2\n           ================================================== -->\n\n      <g class=\"wl5-tank\">\n        <rect\n          class=\"wl5-tank-body\"\n          x=\"74\" y=\"80\"\n          width=\"731\" height=\"36\"\n          rx=\"6\" ry=\"6\"\n        />\n        <rect\n          class=\"wl5-tank-liquid\"\n          x=\"78\" y=\"98\"\n          width=\"723\" height=\"14\"\n          rx=\"2\" ry=\"2\"\n        />\n        <path class=\"wl5-tank-highlight\" d=\"M 81 82 H 798\"/>\n        <path class=\"wl5-tank-shade\" d=\"M 81 114 H 798\"/>\n      </g>\n\n      <!-- ==================================================\n           CUBA 1\n           ================================================== -->\n\n      <g class=\"wl5-tank\">\n        <rect\n          class=\"wl5-tank-body\"\n          x=\"71\" y=\"209\"\n          width=\"746\" height=\"36\"\n          rx=\"6\" ry=\"6\"\n        />\n        <rect\n          class=\"wl5-tank-liquid\"\n          x=\"75\" y=\"227\"\n          width=\"738\" height=\"14\"\n          rx=\"2\" ry=\"2\"\n        />\n        <path class=\"wl5-tank-highlight\" d=\"M 78 211 H 810\"/>\n        <path class=\"wl5-tank-shade\" d=\"M 78 243 H 810\"/>\n      </g>\n\n      <!-- ==================================================\n           CUBA PRE-ESTIRAMIENTO\n           ================================================== -->\n\n      <g class=\"wl5-tank\">\n        <rect\n          class=\"wl5-tank-body\"\n          x=\"71\" y=\"344\"\n          width=\"744\" height=\"36\"\n          rx=\"6\" ry=\"6\"\n        />\n        <rect\n          class=\"wl5-tank-liquid\"\n          x=\"75\" y=\"362\"\n          width=\"736\" height=\"14\"\n          rx=\"2\" ry=\"2\"\n        />\n        <path class=\"wl5-tank-highlight\" d=\"M 78 346 H 808\"/>\n        <path class=\"wl5-tank-shade\" d=\"M 78 378 H 808\"/>\n      </g>\n\n      <!-- ==================================================\n           CONEXIONES ENTRE CUBAS\n           ================================================== -->\n\n      <path\n        class=\"wl5-transfer\"\n        d=\"\n          M 610 108 L 621 116 L 633 108\n          M 621 116 V 142 H 548 V 209\n        \"\n      />\n\n      <path\n        class=\"wl5-transfer\"\n        d=\"\n          M 211 237 L 223 245 L 235 237\n          M 223 245 V 263 H 302 V 344\n        \"\n      />\n\n      <!-- ==================================================\n           COLECTORES PRINCIPALES\n           ================================================== -->\n\n      <path\n        class=\"wl5-steam wl5-main\"\n        d=\"M 1 541 H 853\"\n      />\n\n      <path\n        class=\"wl5-condensate wl5-main\"\n        d=\"M 1 583 H 853\"\n      />\n\n      <!-- Montante de vapor, oculto detrás de las cubas. -->\n      <path\n        class=\"wl5-steam wl5-valve-connection\"\n        d=\"\n          M 323 541 V 380\n          M 323 344 V 245\n          M 323 209 V 180 H 360 V 151\n        \"\n      />\n\n      <!-- Montante de condensado. -->\n      <path\n        class=\"wl5-condensate\"\n        d=\"\n          M 315 583 V 380\n          M 315 344 V 245\n          M 315 209 V 159 H 340\n        \"\n      />\n\n      <!-- ==================================================\n           VAPOR Y CONTROL — CUBA 2\n\n           El extremo del calentador conserva el color rojo\n           hasta conectar con el condensado.\n           ================================================== -->\n\n      <path\n        class=\"wl5-steam wl5-valve-connection\"\n        d=\"\n          M 340 159 V 107\n          L 350 117\n          L 360 107\n          V 133\n        \"\n      />\n\n      <path\n        class=\"wl5-control\"\n        d=\"M 476 107 V 142 H 375\"\n      />\n\n      <circle\n        class=\"wl5-control-node\"\n        cx=\"476\" cy=\"107\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#wl5-valve\"\n        transform=\"translate(360 142)\"\n      />\n\n      <!-- ==================================================\n           VAPOR Y CONTROL — CUBA 1\n           ================================================== -->\n\n      <path\n        class=\"wl5-condensate\"\n        d=\"M 315 279 H 340\"\n      />\n\n      <path\n        class=\"wl5-steam wl5-valve-connection\"\n        d=\"\n          M 340 279 V 236\n          L 350 246\n          L 360 236\n          V 266\n          M 360 284 V 300 H 323\n        \"\n      />\n\n      <path\n        class=\"wl5-control\"\n        d=\"M 476 235 V 275 H 375\"\n      />\n\n      <circle\n        class=\"wl5-control-node\"\n        cx=\"476\" cy=\"235\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#wl5-valve\"\n        transform=\"translate(360 275)\"\n      />\n\n      <!-- ==================================================\n           VAPOR Y CONTROL — CUBA PRE-ESTIRAMIENTO\n           ================================================== -->\n\n      <path\n        class=\"wl5-steam wl5-valve-connection\"\n        d=\"\n          M 323 461 H 342 V 445\n\n          M 342 427 V 370\n          L 351 380\n          L 361 370\n          V 405\n\n          M 342 389 H 554 V 367\n          L 564 377\n          L 574 367\n          V 405\n        \"\n      />\n\n      <path\n        class=\"wl5-condensate\"\n        d=\"\n          M 315 481 H 361 V 405 H 574\n        \"\n      />\n\n      <path\n        class=\"wl5-control\"\n        d=\"M 476 372 V 436 H 357\"\n      />\n\n      <circle\n        class=\"wl5-control-node\"\n        cx=\"476\" cy=\"372\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#wl5-valve\"\n        transform=\"translate(342 436)\"\n      />\n\n      <!-- ==================================================\n           AIRE COMPRIMIDO\n           ================================================== -->\n\n      <path\n        class=\"wl5-air\"\n        d=\"\n          M 685 263 H 788\n          M 801 278 V 417\n        \"\n      />\n\n      <rect\n        class=\"wl5-air-box\"\n        x=\"788\" y=\"257\"\n        width=\"28\" height=\"21\"\n        rx=\"1.5\" ry=\"1.5\"\n      />\n\n      <path\n        class=\"wl5-air-arrow\"\n        d=\"M 801 417 L 793 426 H 809 Z\"\n      />\n\n      <!-- ==================================================\n           CUERDA\n\n           Se dibuja detrás de las poleas.\n           El tramo del extremo derecho de la polea 22\n           es horizontal, en y=91.5.\n           ================================================== -->\n\n      <path\n        class=\"wl5-fiber\"\n        d=\"\n          M 21 265\n          L 101.700 349.983\n          A 19.5 20.5 0 0 0 134.994 334.981\n\n          L 134.006 294.019\n          A 19.5 20.5 0 1 1 172.994 292.993\n\n          L 174.006 336.007\n          A 19.5 20.5 0 1 0 212.994 334.981\n\n          L 212.006 294.019\n          A 19.5 20.5 0 0 1 250.949 292.017\n\n          L 254.051 336.983\n          A 19.5 20.5 0 0 0 273.558 356.000\n\n          L 591.558 355.000\n          A 19.5 20.5 0 0 0 610.973 333.422\n\n          L 609.027 294.578\n          A 19.5 20.5 0 1 1 647.994 292.993\n\n          L 649.006 336.007\n          A 19.5 20.5 0 1 0 687.994 334.981\n\n          L 687.006 294.019\n          A 19.5 20.5 0 0 1 725.949 292.017\n\n          L 729.051 336.983\n          A 19.5 20.5 0 0 0 767.999 335.338\n\n          L 766.999 202.338\n          A 19.5 20.5 0 0 0 754.026 183.182\n\n          L 679.026 155.182\n          A 19.5 20.5 0 0 0 658.398 160.342\n\n          L 608.602 215.158\n          A 19.5 20.5 0 0 1 594.442 221.500\n\n          L 274.442 220.500\n          A 19.5 20.5 0 0 1 260.794 214.582\n\n          L 207.206 158.918\n          A 19.5 20.5 0 0 0 180.538 158.185\n\n          L 119.462 215.315\n          A 19.5 20.5 0 0 1 89.421 190.107\n\n          L 176.421 24.107\n          A 19.5 20.5 0 0 1 210.375 23.727\n\n          L 242.625 82.273\n          A 19.5 20.5 0 0 0 259.500 92.500\n\n          L 589.500 92.500\n          A 19.5 20.5 0 0 0 604.588 84.987\n\n          L 654.412 21.013\n          A 19.5 20.5 0 0 1 683.109 19.318\n\n          L 747.891 85.682\n          A 19.5 20.5 0 0 0 761.500 91.500\n\n          H 853\n        \"\n      />\n\n      <!-- ==================================================\n           POLEAS\n           Sin barras ni anillos interiores.\n           ================================================== -->\n\n      <g class=\"wl5-rollers\">\n        <!-- Nivel inferior. -->\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"115.5\" cy=\"335.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"153.5\" cy=\"293.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"193.5\" cy=\"335.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"231.5\" cy=\"293.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"273.5\" cy=\"335.5\" rx=\"19.5\" ry=\"20.5\"/>\n\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"591.5\" cy=\"334.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"628.5\" cy=\"293.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"668.5\" cy=\"335.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"706.5\" cy=\"293.5\" rx=\"19.5\" ry=\"20.5\"/>\n\n        <!-- Polea 10 tangente a la cuerda junto a la polea 9. -->\n        <circle class=\"wl5-roller-body\"\n          cx=\"685\" cy=\"263\" r=\"14.5\"/>\n\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"748.5\" cy=\"335.5\" rx=\"19.5\" ry=\"20.5\"/>\n\n        <!-- Nivel intermedio. -->\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"747.5\" cy=\"202.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"672.5\" cy=\"174.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"594.5\" cy=\"201\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"274.5\" cy=\"200\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"193.5\" cy=\"173.5\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"106.5\" cy=\"200\" rx=\"19.5\" ry=\"20.5\"/>\n\n        <!-- Nivel superior. -->\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"193.5\" cy=\"34\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"259.5\" cy=\"72\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"589.5\" cy=\"72\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"669.5\" cy=\"34\" rx=\"19.5\" ry=\"20.5\"/>\n        <ellipse class=\"wl5-roller-body\"\n          cx=\"761.5\" cy=\"71\" rx=\"19.5\" ry=\"20.5\"/>\n      </g>\n\n      <!-- ==================================================\n           NUMERACIÓN CENTRADA\n           ================================================== -->\n\n      <g>\n        <text class=\"wl5-roller-number\" x=\"115.5\" y=\"335.5\">1</text>\n        <text class=\"wl5-roller-number\" x=\"153.5\" y=\"293.5\">2</text>\n        <text class=\"wl5-roller-number\" x=\"193.5\" y=\"335.5\">3</text>\n        <text class=\"wl5-roller-number\" x=\"231.5\" y=\"293.5\">4</text>\n        <text class=\"wl5-roller-number\" x=\"273.5\" y=\"335.5\">5</text>\n        <text class=\"wl5-roller-number\" x=\"591.5\" y=\"334.5\">6</text>\n        <text class=\"wl5-roller-number\" x=\"628.5\" y=\"293.5\">7</text>\n        <text class=\"wl5-roller-number\" x=\"668.5\" y=\"335.5\">8</text>\n        <text class=\"wl5-roller-number\" x=\"706.5\" y=\"293.5\">9</text>\n\n        <text\n          class=\"wl5-roller-number\"\n          x=\"685\"\n          y=\"263\"\n        >10</text>\n\n        <text class=\"wl5-roller-number\" x=\"748.5\" y=\"335.5\">11</text>\n        <text class=\"wl5-roller-number\" x=\"747.5\" y=\"202.5\">12</text>\n        <text class=\"wl5-roller-number\" x=\"672.5\" y=\"174.5\">13</text>\n        <text class=\"wl5-roller-number\" x=\"594.5\" y=\"201\">14</text>\n        <text class=\"wl5-roller-number\" x=\"274.5\" y=\"200\">15</text>\n        <text class=\"wl5-roller-number\" x=\"193.5\" y=\"173.5\">16</text>\n        <text class=\"wl5-roller-number\" x=\"106.5\" y=\"200\">17</text>\n        <text class=\"wl5-roller-number\" x=\"193.5\" y=\"34\">18</text>\n        <text class=\"wl5-roller-number\" x=\"259.5\" y=\"72\">19</text>\n        <text class=\"wl5-roller-number\" x=\"589.5\" y=\"72\">20</text>\n        <text class=\"wl5-roller-number\" x=\"669.5\" y=\"34\">21</text>\n        <text class=\"wl5-roller-number\" x=\"761.5\" y=\"71\">22</text>\n      </g>\n\n      <!-- ==================================================\n           TEXTOS\n           ================================================== -->\n\n      <g>\n        <text class=\"wl5-label\" x=\"500\" y=\"127\">CUBA 2</text>\n        <text class=\"wl5-label\" x=\"500\" y=\"257\">CUBA 1</text>\n\n        <text class=\"wl5-label\" x=\"494\" y=\"499\">\n          CUBA PRE-ESTIRAMIENTO\n        </text>\n\n        <text class=\"wl5-small-label\" x=\"3\" y=\"238\">\n          <tspan x=\"3\" dy=\"0\">Alimentación</tspan>\n          <tspan x=\"3\" dy=\"14\">por Tachos</tspan>\n        </text>\n\n        <text class=\"wl5-air-label\" x=\"801\" y=\"439\">\n          <tspan x=\"801\" dy=\"0\">Aire</tspan>\n          <tspan x=\"801\" dy=\"12\">Comprimido</tspan>\n        </text>\n\n        <text class=\"wl5-steam-label\" x=\"6\" y=\"534\">\n          Vapor 15 bar\n        </text>\n\n        <text class=\"wl5-condensate-label\" x=\"6\" y=\"575\">\n          Condensado\n        </text>\n\n        <text class=\"wl5-footer\" x=\"840\" y=\"609\">\n          Pre-Estiramiento Lavadora Línea #5\n        </text>\n      </g>\n    </g>\n  </svg>\n</div>",
  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.wl5-widget {\n  --wl5-metal: #D7D8DB;\n  --wl5-outline: #4E4E4E;\n  --wl5-liquid: #A0CFE9;\n  --wl5-fiber: #0A638F;\n  --wl5-air: #756582;\n  --wl5-steam: #930606;\n  --wl5-condensate: #4E4E4E;\n  --wl5-control: #01524F;\n  --wl5-valve: #0E0E55;\n  --wl5-text: #000000;\n\n  display: grid;\n  place-items: center;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  background: transparent;\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  pointer-events: none;\n}\n\n.wl5-widget,\n.wl5-widget * {\n  box-sizing: border-box;\n  animation: none !important;\n  transition: none !important;\n}\n\n.wl5-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.wl5-metal-stop {\n  stop-color: var(--wl5-metal);\n}\n\n.wl5-liquid-stop {\n  stop-color: var(--wl5-liquid);\n}\n\n/* Cubas. */\n\n.wl5-tank {\n  filter: url(\"#wl5-tank-shadow\");\n}\n\n.wl5-tank-body {\n  fill: url(\"#wl5-tank-metal\");\n  stroke: var(--wl5-outline);\n  stroke-width: 1.8;\n  stroke-linejoin: round;\n}\n\n.wl5-tank-liquid {\n  fill: url(\"#wl5-liquid-gradient\");\n  stroke: none;\n}\n\n.wl5-tank-highlight {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 0.7;\n  stroke-linecap: round;\n  opacity: 0.48;\n}\n\n.wl5-tank-shade {\n  fill: none;\n  stroke: #555D69;\n  stroke-width: 0.65;\n  stroke-linecap: round;\n  opacity: 0.16;\n}\n\n/* Tuberías. */\n\n.wl5-steam,\n.wl5-condensate,\n.wl5-control,\n.wl5-transfer,\n.wl5-air {\n  fill: none;\n  stroke-width: 1.6;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.wl5-steam {\n  stroke: var(--wl5-steam);\n}\n\n.wl5-condensate {\n  stroke: var(--wl5-condensate);\n}\n\n.wl5-control {\n  stroke: var(--wl5-control);\n}\n\n.wl5-transfer {\n  stroke: var(--wl5-outline);\n  stroke-width: 1.8;\n}\n\n.wl5-air {\n  stroke: var(--wl5-air);\n}\n\n.wl5-main {\n  stroke-width: 2;\n}\n\n.wl5-valve-connection {\n  stroke-linecap: butt;\n}\n\n.wl5-control-node {\n  fill: var(--wl5-control);\n  stroke: none;\n}\n\n/* Válvulas transparentes. */\n\n.wl5-valve-body {\n  fill: none;\n  stroke: var(--wl5-valve);\n  stroke-width: 1.4;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.wl5-valve-stem {\n  fill: none;\n  stroke: var(--wl5-valve);\n  stroke-width: 0.7;\n  stroke-linecap: butt;\n}\n\n.wl5-valve-actuator {\n  fill: var(--wl5-valve);\n  stroke: var(--wl5-valve);\n  stroke-width: 1;\n}\n\n/* Cuerda. */\n\n.wl5-fiber {\n  fill: none;\n  stroke: var(--wl5-fiber);\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Poleas. */\n\n.wl5-roller-body {\n  fill: url(\"#wl5-roller-metal\");\n  stroke: var(--wl5-outline);\n  stroke-width: 2.2;\n  filter: url(\"#wl5-roller-shadow\");\n}\n\n.wl5-roller-number {\n  fill: var(--wl5-text);\n  stroke: none;\n\n  font-family: \"IBM Plex Mono\", Consolas, monospace;\n  font-size: 13px;\n  font-weight: 700;\n\n  text-anchor: middle;\n  dominant-baseline: middle;\n}\n\n/* Aire comprimido. */\n\n.wl5-air-box {\n  fill: url(\"#wl5-tank-metal\");\n  stroke: var(--wl5-air);\n  stroke-width: 1.6;\n  stroke-linejoin: round;\n}\n\n.wl5-air-arrow {\n  fill: var(--wl5-air);\n  stroke: none;\n}\n\n/* Textos. */\n\n.wl5-label {\n  fill: var(--wl5-text);\n  stroke: none;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.wl5-small-label {\n  fill: var(--wl5-text);\n  stroke: none;\n  font-size: 10px;\n  font-weight: 400;\n}\n\n.wl5-steam-label,\n.wl5-condensate-label {\n  stroke: none;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.wl5-steam-label {\n  fill: var(--wl5-steam);\n}\n\n.wl5-condensate-label {\n  fill: var(--wl5-condensate);\n}\n\n.wl5-air-label {\n  fill: var(--wl5-air);\n  stroke: none;\n  font-size: 10px;\n  text-anchor: middle;\n}\n\n.wl5-footer {\n  fill: var(--wl5-text);\n  stroke: none;\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
