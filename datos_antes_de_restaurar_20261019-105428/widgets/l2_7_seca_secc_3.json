{
  "kind": "l2_7_seca_secc_3",
  "nombre": "L2 7 SECA SECC 3",
  "html": "<div class=\"secador-widget\">\n  <svg\n    class=\"secador-svg\"\n    viewBox=\"0 0 883 568\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Zona 4 y Zona 5 - Secador Línea #2\"\n  >\n    <defs>\n      <!--\n        METAL SATINADO\n\n        Mismos tonos y dirección del reflejo utilizados\n        en las otras secciones modernizadas.\n      -->\n      <linearGradient\n        id=\"sec3-roller-metal\"\n        x1=\"15%\"\n        y1=\"0%\"\n        x2=\"85%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"roller-metal-base\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"roller-metal-base\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Sombra ambiental y sombra corta de contacto -->\n      <filter\n        id=\"sec3-roller-shadow\"\n        x=\"-30%\"\n        y=\"-30%\"\n        width=\"160%\"\n        height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\"\n          dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\"\n          dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n    </defs>\n\n    <!--\n      VAPOR\n\n      Recorridos reconstruidos sobre la imagen de 883 × 568.\n      Las tuberías se interrumpen físicamente en las válvulas.\n    -->\n    <g class=\"steam-system\">\n      <!-- Colector principal -->\n      <path\n        class=\"steam-line steam-main\"\n        d=\"M 0 483.5 L 883 483.5\"\n      />\n\n      <!-- ==================================================\n           ZONA 4\n           ================================================== -->\n\n      <!-- Alimentación inferior de la válvula -->\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 269.5 483.5 L 269.5 374\"\n      />\n\n      <!-- Salida superior y subida a la cabecera -->\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"\n          M 269.5 354\n          L 269.5 294\n          L 147 240\n          L 147 44\n          L 410.5 44\n        \"\n      />\n\n      <!-- Calefactor superior izquierdo -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 258.5 44\n          L 258.5 23\n          L 269 33\n          L 279.5 23\n          L 279.5 64\n        \"\n      />\n\n      <!-- Calefactor superior derecho -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 410.5 44\n          L 410.5 22\n          L 421 32\n          L 431.5 22\n          L 431.5 64\n        \"\n      />\n\n      <!-- Distribuidor inferior -->\n      <path\n        class=\"steam-line\"\n        d=\"M 269.5 313 L 466.5 313\"\n      />\n\n      <!-- Calefactor inferior izquierdo -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 313.5 313\n          L 313.5 291\n          L 324 301\n          L 334.5 291\n          L 334.5 330.5\n        \"\n      />\n\n      <!-- Calefactor inferior derecho -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 466.5 313\n          L 466.5 289\n          L 477 299\n          L 487.5 289\n          L 487.5 330.5\n        \"\n      />\n\n      <!-- ==================================================\n           ZONA 5\n           ================================================== -->\n\n      <!-- Alimentación inferior de la válvula -->\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 571.5 483.5 L 571.5 370\"\n      />\n\n      <!-- Salida superior y subida a la cabecera -->\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"\n          M 571.5 350\n          L 571.5 241\n          L 479.5 146\n          L 479.5 45\n          L 607.5 45\n        \"\n      />\n\n      <!-- Calefactor superior -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 607.5 45\n          L 607.5 23\n          L 618 33\n          L 628.5 23\n          L 628.5 64\n        \"\n      />\n\n      <!-- Distribuidor inferior -->\n      <path\n        class=\"steam-line\"\n        d=\"M 571.5 309 L 616.5 309\"\n      />\n\n      <!-- Calefactor inferior -->\n      <path\n        class=\"steam-line\"\n        d=\"\n          M 616.5 309\n          L 616.5 287\n          L 627 297\n          L 637.5 287\n          L 637.5 328.5\n        \"\n      />\n    </g>\n\n    <!-- CONDENSADO -->\n    <g class=\"condensate-system\">\n      <!-- Retorno superior de zona 4 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 279.5 64\n          L 461.5 64\n          L 461.5 145\n          L 550.5 236\n          L 550.5 524.5\n        \"\n      />\n\n      <!-- Retorno inferior de zona 4 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 334.5 330.5\n          L 487.5 330.5\n          L 487.5 524.5\n        \"\n      />\n\n      <!-- Retorno superior de zona 5 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 628.5 64\n          L 628.5 138.5\n          L 721.5 235\n          L 721.5 524.5\n        \"\n      />\n\n      <!-- Retorno inferior de zona 5 -->\n      <path\n        class=\"condensate-line\"\n        d=\"\n          M 637.5 328.5\n          L 712.5 328.5\n          L 712.5 524.5\n        \"\n      />\n\n      <!-- Colector principal -->\n      <path\n        class=\"condensate-line condensate-main\"\n        d=\"M 883 524.5 L 0 524.5\"\n      />\n    </g>\n\n    <!--\n      CONTROL\n\n      Se dibuja antes de las válvulas para que sus actuadores\n      queden por encima de la conexión.\n    -->\n    <g class=\"control-system\">\n      <!-- Zona 4 -->\n      <path\n        class=\"control-line\"\n        d=\"\n          M 412 245\n          L 412 364\n          L 289 364\n        \"\n      />\n\n      <circle\n        class=\"control-node\"\n        cx=\"412\"\n        cy=\"245\"\n        r=\"3.5\"\n      />\n\n      <!-- Zona 5 -->\n      <path\n        class=\"control-line\"\n        d=\"\n          M 664 294.5\n          L 664 360\n          L 592 360\n        \"\n      />\n\n      <circle\n        class=\"control-node\"\n        cx=\"664\"\n        cy=\"294.5\"\n        r=\"3.5\"\n      />\n    </g>\n\n    <!--\n      VÁLVULAS PROPORCIONALES\n\n      Cuerpos transparentes.\n      Unión horizontal de 1 px entre el centro de cada\n      válvula y el centro de su actuador.\n    -->\n    <g class=\"valve-system\">\n      <!-- Zona 4 -->\n      <g\n        class=\"valve valve-vertical\"\n        transform=\"translate(269.5 364)\"\n      >\n        <line\n          class=\"valve-link\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"16.5\"\n          y2=\"0\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -10 -10 L 10 -10 L 0 0 Z\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -10 10 L 10 10 L 0 0 Z\"\n        />\n\n        <ellipse\n          class=\"valve-dot\"\n          cx=\"16.5\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n\n      <!-- Zona 5 -->\n      <g\n        class=\"valve valve-vertical\"\n        transform=\"translate(571.5 360)\"\n      >\n        <line\n          class=\"valve-link\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"17.5\"\n          y2=\"0\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -10 -10 L 10 -10 L 0 0 Z\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -10 10 L 10 10 L 0 0 Z\"\n        />\n\n        <ellipse\n          class=\"valve-dot\"\n          cx=\"17.5\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n    </g>\n\n\n    <!--\n      CUERDA\n\n      El recorrido coincide con el contorno de los cuerpos.\n      Las poleas se dibujan después para ocultar los arcos\n      de contacto y dar la apariencia de cuerda encajada.\n\n      Todos los enlaces rectos conservan la tangencia.\n    -->\n    <g class=\"fiber-system\">\n      <path\n        class=\"fiber\"\n        d=\"\n          M 190.5 231\n          L 190.5 174.5\n\n          A 41.5 43 0 1 1\n            273.498322 174.886650\n\n          L 273.001678 232.113350\n\n          A 41.5 43 0 0 0\n            355.727155 237.422693\n\n          L 363.272845 169.577307\n\n          A 41.5 43 0 0 1\n            445.973027 176.050068\n\n          L 444.026973 231.949932\n\n          A 41.5 43 0 0 0\n            526.661517 238.980760\n\n          L 535.338483 169.019240\n\n          A 41.5 43 0 0 1\n            617.935290 176.900352\n\n          L 615.064710 230.099648\n\n          A 41.5 43 0 0 0\n            697.910268 235.326170\n\n          L 702.032258 170.484016\n\n          A 15 15.5 0 0 1\n            717.000000 156.000000\n\n          L 797 156\n        \"\n      />\n    </g>\n\n    <!--\n      CILINDROS\n\n      Las elipses reproducen la ligera diferencia entre\n      ancho y alto que presenta la imagen de referencia.\n      Sin anillos interiores.\n    -->\n    <g class=\"rollers\">\n      <!-- Cilindro 17 -->\n      <g class=\"roller-unit roller-large\">\n        <ellipse\n          class=\"roller-body\"\n          cx=\"232\"\n          cy=\"174.5\"\n          rx=\"41.5\"\n          ry=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 18 -->\n      <g class=\"roller-unit roller-large\">\n        <ellipse\n          class=\"roller-body\"\n          cx=\"314.5\"\n          cy=\"232.5\"\n          rx=\"41.5\"\n          ry=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 19 -->\n      <g class=\"roller-unit roller-large\">\n        <ellipse\n          class=\"roller-body\"\n          cx=\"404.5\"\n          cy=\"174.5\"\n          rx=\"41.5\"\n          ry=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 20 -->\n      <g class=\"roller-unit roller-large\">\n        <ellipse\n          class=\"roller-body\"\n          cx=\"485.5\"\n          cy=\"233.5\"\n          rx=\"41.5\"\n          ry=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 21 -->\n      <g class=\"roller-unit roller-large\">\n        <ellipse\n          class=\"roller-body\"\n          cx=\"576.5\"\n          cy=\"174.5\"\n          rx=\"41.5\"\n          ry=\"43\"\n        />\n      </g>\n\n      <!-- Cilindro 22 -->\n      <g class=\"roller-unit roller-large\">\n        <ellipse\n          class=\"roller-body\"\n          cx=\"656.5\"\n          cy=\"232.5\"\n          rx=\"41.5\"\n          ry=\"43\"\n        />\n      </g>\n\n      <!-- Polea guía de salida -->\n      <g class=\"roller-unit roller-guide\">\n        <ellipse\n          class=\"roller-body\"\n          cx=\"717\"\n          cy=\"171.5\"\n          rx=\"15\"\n          ry=\"15.5\"\n        />\n      </g>\n    </g>\n\n    <!-- NUMERACIÓN: posiciones ajustadas a la referencia -->\n    <g class=\"roller-labels\">\n      <text class=\"roller-label\" x=\"232\" y=\"116\">17</text>\n      <text class=\"roller-label\" x=\"314.5\" y=\"178\">18</text>\n\n      <text class=\"roller-label\" x=\"404.5\" y=\"116\">19</text>\n      <text class=\"roller-label\" x=\"485.5\" y=\"183\">20</text>\n\n      <text class=\"roller-label\" x=\"576.5\" y=\"119\">21</text>\n      <text class=\"roller-label\" x=\"656.5\" y=\"179\">22</text>\n    </g>\n\n    <!-- TEXTOS -->\n    <g class=\"labels\">\n      <text\n        class=\"text-steam\"\n        x=\"14\"\n        y=\"476\"\n      >Vapor 15 bar</text>\n\n      <text\n        class=\"text-condensate\"\n        x=\"14\"\n        y=\"517\"\n      >Condensado</text>\n\n      <text\n        class=\"text-zone\"\n        x=\"368\"\n        y=\"510\"\n      >ZONA 4</text>\n\n      <text\n        class=\"text-zone\"\n        x=\"630\"\n        y=\"512\"\n      >ZONA 5</text>\n\n      <text\n        class=\"text-footer\"\n        x=\"594\"\n        y=\"557\"\n      >Zona 4 y Zona 5 - Secador Línea #2</text>\n    </g>\n  </svg>\n</div>",
  "css": ":root {\n  /* Tipografía */\n  --sec-font-family: \"Segoe UI\", Arial, sans-serif;\n  --sec-number-font: \"IBM Plex Mono\", Consolas, monospace;\n\n  /* Textos */\n  --sec-text-primary: #000000;\n  --sec-text-secondary: #000000;\n\n  /* Cuerda */\n  --sec-fiber-color: #0A638F;\n\n  /* Cilindros y polea guía */\n  --sec-roller-fill: #D7D8DB;\n  --sec-roller-border: #4E4E4E;\n  --sec-roller-number: #000000;\n\n  /* Tuberías */\n  --sec-steam-color: #930606;\n  --sec-condensate-color: #4E4E4E;\n\n  /* Control */\n  --sec-control-color: #01524F;\n\n  /* Válvulas */\n  --sec-valve-color: #0E0E55;\n\n  /* Grosores */\n  --sec-fiber-width: 2.8px;\n  --sec-roller-border-width: 2.2px;\n  --sec-process-width: 1.6px;\n  --sec-process-main-width: 2px;\n  --sec-control-width: 1.6px;\n  --sec-valve-width: 1.4px;\n\n  /* Numeración */\n  --sec-roller-number-size: 13px;\n}\n\n/* ==========================================================\n   ENTORNO TRANSPARENTE\n   ========================================================== */\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.secador-widget {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  font-family: var(--sec-font-family);\n  pointer-events: none;\n}\n\n.secador-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n/* Representación completamente estática */\n.secador-widget,\n.secador-widget * {\n  animation: none !important;\n  transition: none !important;\n}\n\n/* ==========================================================\n   METAL SATINADO\n   ========================================================== */\n\n.roller-metal-base {\n  stop-color: var(--sec-roller-fill);\n}\n\n.roller-body {\n  fill: url(\"#sec3-roller-metal\");\n  stroke: var(--sec-roller-border);\n  stroke-width: var(--sec-roller-border-width);\n  filter: url(\"#sec3-roller-shadow\");\n}\n\n/* ==========================================================\n   CUERDA\n   ========================================================== */\n\n.fiber {\n  fill: none;\n  stroke: var(--sec-fiber-color);\n  stroke-width: var(--sec-fiber-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* ==========================================================\n   NUMERACIÓN\n   ========================================================== */\n\n.roller-label {\n  fill: var(--sec-roller-number);\n  font-family: var(--sec-number-font);\n  font-size: var(--sec-roller-number-size);\n  font-weight: 700;\n  text-anchor: middle;\n  dominant-baseline: middle;\n}\n\n/* ==========================================================\n   TUBERÍAS CONTINUAS\n   ========================================================== */\n\n.steam-line,\n.condensate-line,\n.control-line {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.steam-line {\n  stroke: var(--sec-steam-color);\n  stroke-width: var(--sec-process-width);\n}\n\n.condensate-line {\n  stroke: var(--sec-condensate-color);\n  stroke-width: var(--sec-process-width);\n}\n\n.steam-main,\n.condensate-main {\n  stroke-width: var(--sec-process-main-width);\n}\n\n/*\n * Los extremos terminan en los bordes de las válvulas,\n * sin prolongar el trazo hacia su interior.\n */\n.valve-connection {\n  stroke-linecap: butt;\n}\n\n/* ==========================================================\n   CONTROL\n   ========================================================== */\n\n.control-line {\n  stroke: var(--sec-control-color);\n  stroke-width: var(--sec-control-width);\n}\n\n.control-node {\n  fill: var(--sec-control-color);\n  stroke: var(--sec-control-color);\n  stroke-width: 1px;\n}\n\n/* ==========================================================\n   VÁLVULAS TRANSPARENTES\n   ========================================================== */\n\n.valve-body {\n  fill: none;\n  stroke: var(--sec-valve-color);\n  stroke-width: var(--sec-valve-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.valve-dot {\n  fill: var(--sec-valve-color);\n  stroke: var(--sec-valve-color);\n  stroke-width: 1px;\n}\n\n/* Unión horizontal entre la válvula y su actuador */\n.valve-link {\n  fill: none;\n  stroke: var(--sec-valve-color);\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n}\n\n/* ==========================================================\n   TEXTOS\n   ========================================================== */\n\n.labels text {\n  font-family: var(--sec-font-family);\n}\n\n.text-steam {\n  fill: var(--sec-steam-color);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.text-condensate {\n  fill: var(--sec-condensate-color);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.text-zone {\n  fill: var(--sec-text-primary);\n  font-size: 18px;\n  font-weight: 600;\n  text-anchor: middle;\n}\n\n.text-footer {\n  fill: var(--sec-text-secondary);\n  font-size: 16px;\n  font-weight: 500;\n  font-style: italic;\n}",
  "js": "\"use strict\";\n\n/*\n * Secador Línea 2 — Zonas 4 y 5.\n *\n * Widget gráfico completamente estático.\n *\n * Geometría reconstruida a partir de la imagen de referencia\n * de 883 × 568 píxeles.\n *\n * El acabado metálico, los reflejos y las sombras se definen\n * mediante SVG y CSS.\n *\n * No utiliza tags, variables del PLC, WIDGET, onWidgetUpdate,\n * temporizadores, animaciones ni recursos externos.\n */",
