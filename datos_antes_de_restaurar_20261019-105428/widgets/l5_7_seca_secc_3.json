{
  "kind": "l5_7_seca_secc_3",
  "nombre": "L5 7 SECA SECC 3",
  "html": "<div class=\"ls57-widget\">\n  <svg\n    class=\"ls57-svg\"\n    viewBox=\"0 0 895 622\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Zona 4 y 5 Secador Línea 5\"\n  >\n    <defs>\n      <!-- Acabado metálico suave -->\n      <linearGradient\n        id=\"ls57-roller-metal\"\n        x1=\"15%\"\n        y1=\"0%\"\n        x2=\"85%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"ls57-metal-stop\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"ls57-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Sombra ambiental y de contacto -->\n      <filter\n        id=\"ls57-roller-shadow\"\n        x=\"-30%\"\n        y=\"-30%\"\n        width=\"160%\"\n        height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\"\n          dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\"\n          dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!--\n        Válvula transparente.\n        Actuador ovalado: rx=1.5, ry=6.5.\n        Unión horizontal: 0.7 px.\n      -->\n      <g id=\"ls57-valve\">\n        <path\n          class=\"ls57-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n\n        <path\n          class=\"ls57-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n\n        <line\n          class=\"ls57-valve-stem\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"13\"\n          y2=\"0\"\n        />\n\n        <ellipse\n          class=\"ls57-valve-actuator\"\n          cx=\"13\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n    </defs>\n\n    <!-- =====================================================\n         ZONA 4: VAPOR SUPERIOR Y MONTANTE\n         ===================================================== -->\n    <g>\n      <!-- Recorrido superior hasta la válvula -->\n      <path\n        class=\"ls57-steam ls57-valve-connection\"\n        d=\"\n          M 136 348\n          V 289\n          L 82 208\n          V 40\n          H 282\n          V 17\n          L 293 27\n          L 303 17\n          V 45\n        \"\n      />\n\n      <!-- Primer calentador superior -->\n      <path\n        class=\"ls57-steam\"\n        d=\"\n          M 130 40\n          V 18\n          L 140 28\n          L 151 18\n          V 46\n        \"\n      />\n\n      <!-- Montante inferior: termina en vapor -->\n      <path\n        class=\"ls57-steam ls57-valve-connection\"\n        d=\"\n          M 136 366\n          V 539\n        \"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 4: CONDENSADO SUPERIOR\n         ===================================================== -->\n    <path\n      class=\"ls57-condensate\"\n      d=\"\n        M 151 46\n        V 57\n        H 385\n        V 132\n        L 456 232\n        V 581\n\n        M 303 45\n        V 57\n      \"\n    />\n\n    <!-- =====================================================\n         ZONA 4: CALENTADORES INFERIORES\n         ===================================================== -->\n    <g>\n      <path\n        class=\"ls57-steam\"\n        d=\"\n          M 136 306\n          H 334\n          V 282\n          L 345 292\n          L 355 282\n          V 310\n        \"\n      />\n\n      <path\n        class=\"ls57-steam\"\n        d=\"\n          M 181 306\n          V 284\n          L 192 294\n          L 202 284\n          V 312\n        \"\n      />\n\n      <path\n        class=\"ls57-condensate\"\n        d=\"\n          M 202 312\n          V 323\n          H 400\n          V 581\n\n          M 355 310\n          V 323\n        \"\n      />\n\n      <!-- Control -->\n      <path\n        class=\"ls57-control\"\n        d=\"\n          M 294 245\n          V 357\n          H 151\n        \"\n      />\n\n      <circle\n        class=\"ls57-control-node\"\n        cx=\"294\"\n        cy=\"245\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#ls57-valve\"\n        transform=\"translate(136 357)\"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 5: CIRCUITO CENTRAL SUPERIOR\n         ===================================================== -->\n    <g>\n      <path\n        class=\"ls57-steam ls57-valve-connection\"\n        d=\"\n          M 468 353\n          V 230\n          L 421 165\n          V 41\n          H 458\n          V 17\n          L 469 27\n          L 479 17\n          V 45\n        \"\n      />\n\n      <!-- Montante inferior: termina en vapor -->\n      <path\n        class=\"ls57-steam ls57-valve-connection\"\n        d=\"\n          M 468 371\n          V 539\n        \"\n      />\n\n      <path\n        class=\"ls57-condensate\"\n        d=\"\n          M 479 45\n          V 56\n          H 557\n          V 134\n          L 626 230\n          V 581\n        \"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 5: CIRCUITO DERECHO SUPERIOR\n         ===================================================== -->\n    <g>\n      <path\n        class=\"ls57-steam\"\n        d=\"\n          M 638 539\n          V 228\n          L 590 163\n          V 39\n          H 627\n          V 16\n          L 637 26\n          L 648 16\n          V 44\n        \"\n      />\n\n      <path\n        class=\"ls57-condensate\"\n        d=\"\n          M 648 44\n          V 56\n          H 765\n          V 162\n          L 862 304\n          V 581\n        \"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 5: CALENTADOR INFERIOR CENTRAL\n         ===================================================== -->\n    <g>\n      <path\n        class=\"ls57-steam\"\n        d=\"\n          M 468 306\n          H 558\n          V 284\n          L 569 294\n          L 579 284\n          V 312\n        \"\n      />\n\n      <path\n        class=\"ls57-condensate\"\n        d=\"\n          M 579 312\n          V 323\n          H 626\n        \"\n      />\n\n      <!-- Control -->\n      <path\n        class=\"ls57-control\"\n        d=\"\n          M 632 247\n          V 362\n          H 483\n        \"\n      />\n\n      <circle\n        class=\"ls57-control-node\"\n        cx=\"632\"\n        cy=\"247\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#ls57-valve\"\n        transform=\"translate(468 362)\"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 5: CALENTADOR INFERIOR DERECHO\n         ===================================================== -->\n    <g>\n      <path\n        class=\"ls57-steam\"\n        d=\"\n          M 638 305\n          H 729\n          V 282\n          L 739 292\n          L 749 282\n          V 310\n        \"\n      />\n\n      <path\n        class=\"ls57-condensate\"\n        d=\"\n          M 749 310\n          V 323\n          H 777\n          V 581\n        \"\n      />\n    </g>\n\n    <!-- =====================================================\n         COLECTORES PRINCIPALES\n         ===================================================== -->\n    <path\n      class=\"ls57-steam ls57-main\"\n      d=\"M 0 539 H 895\"\n    />\n\n    <path\n      class=\"ls57-condensate ls57-main\"\n      d=\"M 0 581 H 895\"\n    />\n\n    <!-- =====================================================\n         CUERDA\n\n         Recorrido continuo y tangente.\n         Los cuerpos de las poleas se dibujan por delante.\n         ===================================================== -->\n    <path\n      class=\"ls57-fiber\"\n      d=\"\n        M 87 285\n        L 100.284 165.894\n\n        A 42 44 0 0 1 183.993 171.799\n        L 183.007 228.719\n\n        A 42 43.5 0 0 0 266.855 233.112\n        L 272.148 167.305\n\n        A 42 44 0 0 1 355.972 172.619\n        L 354.028 227.917\n\n        A 42 43.5 0 0 0 437.796 233.781\n        L 444.209 166.621\n\n        A 42 44 0 0 1 527.937 173.418\n        L 525.062 228.137\n\n        A 42 43.5 0 0 0 608.737 235.364\n        L 616.269 166.025\n\n        A 42 44 0 0 1 699.880 174.331\n        L 696.118 226.245\n\n        A 42 43.5 0 0 0 779.949 231.645\n        L 783.017 167.286\n\n        A 15 15 0 0 1 798 153\n        H 895\n      \"\n    />\n\n    <!-- =====================================================\n         POLEAS\n         ===================================================== -->\n    <g>\n      <!-- Polea 15 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"142\"\n        cy=\"171\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 16 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"225\"\n        cy=\"229.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Polea 17 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"314\"\n        cy=\"171\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 18 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"396\"\n        cy=\"229.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Polea 19 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"486\"\n        cy=\"171\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 20 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"567\"\n        cy=\"230.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Polea 21 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"658\"\n        cy=\"171\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 22 -->\n      <ellipse\n        class=\"ls57-roller-body\"\n        cx=\"738\"\n        cy=\"229.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Guía pequeña de salida, sin numeración -->\n      <circle\n        class=\"ls57-roller-body\"\n        cx=\"798\"\n        cy=\"168\"\n        r=\"15\"\n      />\n    </g>\n\n    <!-- =====================================================\n         NÚMEROS CENTRADOS SOBRE LAS POLEAS\n         ===================================================== -->\n    <g class=\"ls57-roller-number\">\n      <text x=\"142\" y=\"120\">15</text>\n      <text x=\"225\" y=\"180\">16</text>\n      <text x=\"314\" y=\"120\">17</text>\n      <text x=\"396\" y=\"180\">18</text>\n      <text x=\"486\" y=\"120\">19</text>\n      <text x=\"567\" y=\"181\">20</text>\n      <text x=\"658\" y=\"120\">21</text>\n      <text x=\"738\" y=\"180\">22</text>\n    </g>\n\n    <!-- =====================================================\n         TEXTOS\n         ===================================================== -->\n    <g>\n      <text\n        class=\"ls57-zone-label\"\n        x=\"277\"\n        y=\"533\"\n      >ZONA 4</text>\n\n      <text\n        class=\"ls57-zone-label\"\n        x=\"547\"\n        y=\"533\"\n      >ZONA 5</text>\n\n      <text\n        class=\"ls57-steam-label\"\n        x=\"29\"\n        y=\"533\"\n      >Vapor 15 bar</text>\n\n      <text\n        class=\"ls57-condensate-label\"\n        x=\"29\"\n        y=\"573\"\n      >Condensado</text>\n\n      <text\n        class=\"ls57-footer\"\n        x=\"865\"\n        y=\"608\"\n      >Zona 4 y 5 Secador Línea #5</text>\n    </g>\n  </svg>\n</div>",
  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ls57-widget {\n  --ls57-metal: #D7D8DB;\n  --ls57-outline: #4E4E4E;\n  --ls57-fiber: #0A638F;\n  --ls57-steam: #930606;\n  --ls57-condensate: #4E4E4E;\n  --ls57-control: #01524F;\n  --ls57-valve: #0E0E55;\n  --ls57-text: #000000;\n\n  display: grid;\n  place-items: center;\n\n  width: 100%;\n  height: 100%;\n\n  overflow: hidden;\n  background: transparent;\n\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  pointer-events: none;\n}\n\n.ls57-svg {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  overflow: hidden;\n  background: transparent;\n\n  shape-rendering: geometricPrecision;\n}\n\n/* Poleas */\n\n.ls57-metal-stop {\n  stop-color: var(--ls57-metal);\n}\n\n.ls57-roller-body {\n  fill: url(\"#ls57-roller-metal\");\n\n  stroke: var(--ls57-outline);\n  stroke-width: 2.2px;\n\n  filter: url(\"#ls57-roller-shadow\");\n}\n\n.ls57-roller-number {\n  fill: var(--ls57-text);\n  stroke: none;\n\n  font-family: \"IBM Plex Mono\", Consolas, monospace;\n  font-size: 13px;\n  font-weight: 700;\n\n  text-anchor: middle;\n}\n\n/* Cuerda */\n\n.ls57-fiber {\n  fill: none;\n\n  stroke: var(--ls57-fiber);\n  stroke-width: 1.8px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Tuberías */\n\n.ls57-steam,\n.ls57-condensate,\n.ls57-control {\n  fill: none;\n\n  stroke-width: 1.6px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ls57-steam {\n  stroke: var(--ls57-steam);\n}\n\n.ls57-condensate {\n  stroke: var(--ls57-condensate);\n}\n\n.ls57-control {\n  stroke: var(--ls57-control);\n}\n\n.ls57-main {\n  stroke-width: 2px;\n}\n\n.ls57-valve-connection {\n  stroke-linecap: butt;\n}\n\n.ls57-control-node {\n  fill: var(--ls57-control);\n  stroke: none;\n}\n\n/* Válvulas transparentes */\n\n.ls57-valve-body {\n  fill: none;\n\n  stroke: var(--ls57-valve);\n  stroke-width: 1.4px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ls57-valve-stem {\n  fill: none;\n\n  stroke: var(--ls57-valve);\n  stroke-width: 0.7px;\n  stroke-linecap: butt;\n}\n\n.ls57-valve-actuator {\n  fill: var(--ls57-valve);\n  stroke: var(--ls57-valve);\n  stroke-width: 1px;\n}\n\n/* Textos */\n\n.ls57-zone-label {\n  fill: var(--ls57-text);\n\n  font-size: 16px;\n  font-weight: 700;\n  text-anchor: middle;\n}\n\n.ls57-steam-label {\n  fill: var(--ls57-steam);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls57-condensate-label {\n  fill: var(--ls57-condensate);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls57-footer {\n  fill: var(--ls57-text);\n\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
