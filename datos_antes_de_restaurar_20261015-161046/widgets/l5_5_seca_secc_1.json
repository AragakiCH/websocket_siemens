{
  "kind": "l5_5_seca_secc_1",
  "nombre": "L5 5 SECA SECC 1",
  "html": "<div class=\"ls55-widget\">\n  <svg\n    class=\"ls55-svg\"\n    viewBox=\"0 0 924 632\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Zona 1 y 2 Secador Línea 5\"\n  >\n    <defs>\n      <!-- Acabado metálico suave -->\n      <linearGradient\n        id=\"ls55-roller-metal\"\n        x1=\"15%\"\n        y1=\"0%\"\n        x2=\"85%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"ls55-metal-stop\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"ls55-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Sombra ambiental y sombra de contacto -->\n      <filter\n        id=\"ls55-roller-shadow\"\n        x=\"-30%\"\n        y=\"-30%\"\n        width=\"160%\"\n        height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\"\n          dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\"\n          dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!--\n        Válvula:\n        - Cuerpo transparente.\n        - Actuador rx=1.5, ry=6.5.\n        - Unión horizontal de 0.7 px.\n      -->\n      <g id=\"ls55-valve\">\n        <path\n          class=\"ls55-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n        <path\n          class=\"ls55-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n\n        <line\n          class=\"ls55-valve-stem\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"13\"\n          y2=\"0\"\n        />\n\n        <ellipse\n          class=\"ls55-valve-actuator\"\n          cx=\"13\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n    </defs>\n\n    <!-- =====================================================\n         ZONA 1: CIRCUITO SUPERIOR\n         ===================================================== -->\n    <g>\n      <!-- Alimentación de vapor -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 191 166\n          L 172 137\n          V 48\n          H 374\n          V 25\n          L 384 35\n          L 394 25\n          V 53\n        \"\n      />\n\n      <!-- Primer calentador -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 219 48\n          V 26\n          L 230 36\n          L 240 26\n          V 54\n        \"\n      />\n\n      <!-- Retorno de condensado -->\n      <path\n        class=\"ls55-condensate\"\n        d=\"\n          M 240 54\n          V 65\n          H 437\n          V 109\n          L 534 249\n          V 587\n\n          M 394 53\n          V 65\n        \"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 2: CIRCUITO SUPERIOR\n         ===================================================== -->\n    <g>\n      <!-- Alimentación de vapor -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 514 166\n          L 500 146\n          V 49\n          H 702\n          V 26\n          L 713 36\n          L 724 26\n          V 54\n        \"\n      />\n\n      <!-- Primer calentador -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 548 49\n          V 26\n          L 558 36\n          L 568 26\n          V 54\n        \"\n      />\n\n      <!-- Retorno de condensado -->\n      <path\n        class=\"ls55-condensate\"\n        d=\"\n          M 568 54\n          V 65\n          H 766\n          V 109\n          L 852 233\n          V 587\n\n          M 724 54\n          V 65\n        \"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 1: CIRCUITO INFERIOR\n         ===================================================== -->\n    <g>\n      <!--\n        Montante dividido alrededor de la válvula.\n        No existe tubería dentro del cuerpo transparente.\n      -->\n      <path\n        class=\"ls55-steam ls55-valve-connection\"\n        d=\"\n          M 226 232\n          V 358\n\n          M 226 376\n          V 547\n        \"\n      />\n\n      <!-- Colector y calentador derecho -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 226 318\n          H 424\n          V 294\n          L 435 304\n          L 446 294\n          V 322\n        \"\n      />\n\n      <!-- Calentador izquierdo -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 271 318\n          V 296\n          L 282 306\n          L 292 296\n          V 324\n        \"\n      />\n\n      <!-- Retorno inferior -->\n      <path\n        class=\"ls55-condensate\"\n        d=\"\n          M 292 324\n          V 335\n          H 491\n          V 587\n\n          M 446 322\n          V 335\n        \"\n      />\n\n      <!-- Control -->\n      <path\n        class=\"ls55-control\"\n        d=\"\n          M 371 269\n          V 367\n          H 241\n        \"\n      />\n\n      <circle\n        class=\"ls55-control-node\"\n        cx=\"371\"\n        cy=\"269\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#ls55-valve\"\n        transform=\"translate(226 367)\"\n      />\n    </g>\n\n    <!-- =====================================================\n         ZONA 2: CIRCUITO INFERIOR\n         ===================================================== -->\n    <g>\n      <!-- Montante dividido alrededor de la válvula -->\n      <path\n        class=\"ls55-steam ls55-valve-connection\"\n        d=\"\n          M 555 232\n          V 359\n\n          M 555 377\n          V 547\n        \"\n      />\n\n      <!-- Colector y calentador derecho -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 555 318\n          H 753\n          V 295\n          L 763 305\n          L 774 295\n          V 323\n        \"\n      />\n\n      <!-- Calentador izquierdo -->\n      <path\n        class=\"ls55-steam\"\n        d=\"\n          M 600 318\n          V 296\n          L 611 306\n          L 621 296\n          V 324\n        \"\n      />\n\n      <!-- Retorno inferior -->\n      <path\n        class=\"ls55-condensate\"\n        d=\"\n          M 621 324\n          V 335\n          H 820\n          V 587\n\n          M 774 323\n          V 335\n        \"\n      />\n\n      <!-- Control -->\n      <path\n        class=\"ls55-control\"\n        d=\"\n          M 700 269\n          V 368\n          H 570\n        \"\n      />\n\n      <circle\n        class=\"ls55-control-node\"\n        cx=\"700\"\n        cy=\"269\"\n        r=\"3.5\"\n      />\n\n      <use\n        href=\"#ls55-valve\"\n        transform=\"translate(555 368)\"\n      />\n    </g>\n\n    <!-- =====================================================\n         COLECTORES PRINCIPALES\n         ===================================================== -->\n    <path\n      class=\"ls55-steam ls55-main\"\n      d=\"M 0 547 H 924\"\n    />\n\n    <path\n      class=\"ls55-condensate ls55-main\"\n      d=\"M 0 587 H 924\"\n    />\n\n    <!-- =====================================================\n         CUERDA\n\n         Recorrido tangente y continuo.\n         Las poleas se dibujan después para ocultar los tramos\n         que coinciden con sus cuerpos.\n         ===================================================== -->\n    <path\n      class=\"ls55-fiber\"\n      d=\"\n        M 0 241.500\n        H 169.000\n\n        A 11.5 11.5 0 0 0 180.318 232.040\n        L 189.730 179.834\n\n        A 42 44 0 0 1 272.806 192.224\n        L 268.190 242.371\n\n        A 42 43.5 0 0 0 351.993 245.719\n        L 351.007 188.799\n\n        A 42 44 0 0 1 434.934 190.463\n        L 432.064 244.093\n\n        A 42 43.5 0 0 0 515.936 244.093\n        L 513.066 190.463\n\n        A 42 44 0 0 1 596.809 192.186\n        L 592.191 242.814\n\n        A 42 44 0 0 0 675.993 246.208\n        L 675.007 188.792\n\n        A 42 44 0 0 1 758.993 188.792\n        L 758.007 246.208\n\n        A 42 44 0 0 0 841.953 244.925\n        L 837 135\n      \"\n    />\n\n    <!-- =====================================================\n         POLEAS\n         ===================================================== -->\n    <g>\n      <!-- Guía pequeña de entrada -->\n      <circle\n        class=\"ls55-roller-body\"\n        cx=\"169\"\n        cy=\"230\"\n        r=\"11.5\"\n      />\n\n      <!-- Polea 1 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"231\"\n        cy=\"188\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 2 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"310\"\n        cy=\"246.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Polea 3 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"393\"\n        cy=\"188\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 4 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"474\"\n        cy=\"246.5\"\n        rx=\"42\"\n        ry=\"43.5\"\n      />\n\n      <!-- Polea 5 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"555\"\n        cy=\"188\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 6 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"634\"\n        cy=\"247\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 7 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"717\"\n        cy=\"188\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n\n      <!-- Polea 8 -->\n      <ellipse\n        class=\"ls55-roller-body\"\n        cx=\"800\"\n        cy=\"247\"\n        rx=\"42\"\n        ry=\"44\"\n      />\n    </g>\n\n    <!-- =====================================================\n         NÚMEROS CENTRADOS SOBRE LAS POLEAS\n         ===================================================== -->\n    <g class=\"ls55-roller-number\">\n      <text x=\"231\" y=\"137\">1</text>\n      <text x=\"310\" y=\"200\">2</text>\n      <text x=\"393\" y=\"137\">3</text>\n      <text x=\"474\" y=\"200\">4</text>\n      <text x=\"555\" y=\"137\">5</text>\n      <text x=\"634\" y=\"200\">6</text>\n      <text x=\"717\" y=\"137\">7</text>\n      <text x=\"800\" y=\"200\">8</text>\n    </g>\n\n    <!-- =====================================================\n         TEXTOS\n         ===================================================== -->\n    <g>\n      <text\n        class=\"ls55-inlet-label\"\n        x=\"39\"\n        y=\"224\"\n      >\n        <tspan x=\"39\" dy=\"0\">Línea de</tspan>\n        <tspan x=\"39\" dy=\"13\">lavado</tspan>\n      </text>\n\n      <text\n        class=\"ls55-zone-label\"\n        x=\"362\"\n        y=\"538\"\n      >ZONA 1</text>\n\n      <text\n        class=\"ls55-zone-label\"\n        x=\"715\"\n        y=\"538\"\n      >ZONA 2</text>\n\n      <text\n        class=\"ls55-steam-label\"\n        x=\"17\"\n        y=\"539\"\n      >Vapor 15 bar</text>\n\n      <text\n        class=\"ls55-condensate-label\"\n        x=\"17\"\n        y=\"580\"\n      >Condensado</text>\n\n      <text\n        class=\"ls55-footer\"\n        x=\"853\"\n        y=\"615\"\n      >Zona 1 y 2 Secador Línea #5</text>\n    </g>\n  </svg>\n</div>",
  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ls55-widget {\n  --ls55-metal: #D7D8DB;\n  --ls55-outline: #4E4E4E;\n  --ls55-fiber: #0A638F;\n  --ls55-steam: #930606;\n  --ls55-condensate: #4E4E4E;\n  --ls55-control: #01524F;\n  --ls55-valve: #0E0E55;\n  --ls55-text: #000000;\n\n  display: grid;\n  place-items: center;\n\n  width: 100%;\n  height: 100%;\n\n  overflow: hidden;\n  background: transparent;\n\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  pointer-events: none;\n}\n\n.ls55-svg {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  overflow: hidden;\n  background: transparent;\n\n  shape-rendering: geometricPrecision;\n}\n\n/* Metal de las poleas */\n\n.ls55-metal-stop {\n  stop-color: var(--ls55-metal);\n}\n\n.ls55-roller-body {\n  fill: url(\"#ls55-roller-metal\");\n\n  stroke: var(--ls55-outline);\n  stroke-width: 2.2px;\n\n  filter: url(\"#ls55-roller-shadow\");\n}\n\n/* Numeración sobre las poleas */\n\n.ls55-roller-number {\n  fill: var(--ls55-text);\n  stroke: none;\n\n  font-family: \"IBM Plex Mono\", Consolas, monospace;\n  font-size: 13px;\n  font-weight: 700;\n\n  text-anchor: middle;\n}\n\n/* Cuerda */\n\n.ls55-fiber {\n  fill: none;\n\n  stroke: var(--ls55-fiber);\n  stroke-width: 1.8px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Tuberías */\n\n.ls55-steam,\n.ls55-condensate,\n.ls55-control {\n  fill: none;\n\n  stroke-width: 1.6px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ls55-steam {\n  stroke: var(--ls55-steam);\n}\n\n.ls55-condensate {\n  stroke: var(--ls55-condensate);\n}\n\n.ls55-control {\n  stroke: var(--ls55-control);\n}\n\n.ls55-main {\n  stroke-width: 2px;\n}\n\n.ls55-valve-connection {\n  stroke-linecap: butt;\n}\n\n.ls55-control-node {\n  fill: var(--ls55-control);\n  stroke: none;\n}\n\n/* Válvulas transparentes */\n\n.ls55-valve-body {\n  fill: none;\n\n  stroke: var(--ls55-valve);\n  stroke-width: 1.4px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ls55-valve-stem {\n  fill: none;\n\n  stroke: var(--ls55-valve);\n  stroke-width: 0.7px;\n  stroke-linecap: butt;\n}\n\n.ls55-valve-actuator {\n  fill: var(--ls55-valve);\n  stroke: var(--ls55-valve);\n  stroke-width: 1px;\n}\n\n/* Textos */\n\n.ls55-inlet-label {\n  fill: var(--ls55-text);\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.ls55-zone-label {\n  fill: var(--ls55-text);\n\n  font-size: 16px;\n  font-weight: 700;\n  text-anchor: middle;\n}\n\n.ls55-steam-label {\n  fill: var(--ls55-steam);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls55-condensate-label {\n  fill: var(--ls55-condensate);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls55-footer {\n  fill: var(--ls55-text);\n\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
  "js": "\"use strict\";\n\n/*\n * Widget gráfico estático.\n * No recibe tags ni variables del PLC.\n */\nwindow.onWidgetUpdate = function () {};",
