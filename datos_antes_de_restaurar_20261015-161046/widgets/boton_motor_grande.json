  "css": ":root {\n  --motor-border: #01524F;\n\n  --motor-fill-light: #EDF7F5;\n  --motor-fill-middle: #D3E8E2;\n  --motor-fill-base: #BDDBD4;\n}\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  border: none;\n\n  background: transparent !important;\n  pointer-events: none;\n}\n\n.motor-widget,\n.motor-widget * {\n  box-sizing: border-box;\n}\n\n.motor-widget {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n\n  background: transparent;\n  pointer-events: none;\n  user-select: none;\n  opacity: var(--w-opacity, 1);\n}\n\n.motor-button {\n  position: absolute;\n  inset: 0;\n\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-width: 0;\n  min-height: 0;\n  margin: 0;\n  padding: 0;\n\n  appearance: none;\n  border: none;\n  border-radius: 0;\n  background: transparent;\n\n  pointer-events: none;\n  cursor: pointer;\n  user-select: none;\n  touch-action: manipulation;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.motor-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  background: transparent;\n  shape-rendering: geometricPrecision;\n  pointer-events: none;\n}\n\n.motor-drawing {\n  transform-box: view-box;\n  transform-origin: 50% 50%;\n  transform: scale(1);\n  pointer-events: none;\n}\n\n.motor-fill-light {\n  stop-color: var(--motor-fill-light);\n}\n\n.motor-fill-middle {\n  stop-color: var(--motor-fill-middle);\n}\n\n.motor-fill-base {\n  stop-color: var(--motor-fill-base);\n}\n\n.motor-fill-light,\n.motor-fill-middle,\n.motor-fill-base {\n  transition: stop-color 120ms ease;\n}\n\n.motor-details {\n  fill: var(--motor-border);\n  stroke: none;\n}\n\n.motor-reflection {\n  opacity: 0.65;\n  transition: opacity 120ms ease;\n}\n\n.motor-bottom-shade {\n  opacity: 1;\n  transition: opacity 120ms ease;\n}\n\n.motor-pressed-shade {\n  opacity: 0;\n  transition: opacity 120ms ease;\n}\n\n/* El área interactiva interna sigue exactamente la silueta. */\n.motor-hit-area {\n  fill: transparent;\n  stroke: none;\n  pointer-events: fill;\n  cursor: pointer;\n}\n\n@media (hover: hover) {\n  .motor-button:hover {\n    --motor-fill-light: #F5FCFA;\n    --motor-fill-middle: #DDEFE9;\n    --motor-fill-base: #C8E3DB;\n  }\n\n  .motor-button:hover .motor-reflection {\n    opacity: 0.85;\n  }\n}\n\n/* Pulsación centrada, sin desplazamiento vertical. */\n.motor-button:active {\n  --motor-fill-light: #D5E8E2;\n  --motor-fill-middle: #C9E1D9;\n  --motor-fill-base: #B9D8CE;\n}\n\n.motor-button:active .motor-drawing {\n  transform: scale(0.98);\n}\n\n.motor-button:active .motor-reflection {\n  opacity: 0.25;\n}\n\n.motor-button:active .motor-pressed-shade {\n  opacity: 1;\n}\n\n.motor-button:active .motor-bottom-shade {\n  opacity: 0.4;\n}\n\n.motor-button:focus-visible {\n  outline: none;\n}\n\n.motor-button:focus-visible .motor-details {\n  fill: #0A638F;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .motor-fill-light,\n  .motor-fill-middle,\n  .motor-fill-base,\n  .motor-reflection,\n  .motor-bottom-shade,\n  .motor-pressed-shade {\n    transition: none;\n  }\n}",
  "js": "\"use strict\";\n\n(function () {\n  /*\n   * Widget visual sin texto ni variables del PLC.\n   *\n   * La geometría del SVG procede de la imagen original.\n   * El dibujo llena el ancho y alto disponibles.\n   *\n   * Hover y pulsación se gestionan mediante CSS.\n   * No se configura ninguna acción de control al hacer clic.\n   */\n  window.onWidgetUpdate = function () {\n    // No requiere procesar datos.\n  };\n})();",
