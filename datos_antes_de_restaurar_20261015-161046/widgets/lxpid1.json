  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  border: none;\n\n  background: transparent !important;\n  pointer-events: none;\n}\n\n.pid-widget,\n.pid-widget * {\n  box-sizing: border-box;\n  pointer-events: none;\n}\n\n.pid-widget {\n  display: block;\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n\n  background: transparent;\n  opacity: var(--w-opacity, 1);\n  user-select: none;\n}\n\n.pid-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.pid-divider {\n  fill: none;\n  stroke: #C6D3DD;\n  stroke-width: 1;\n}\n\n.pid-label {\n  font-family:\n    Bahnschrift,\n    \"DIN Alternate\",\n    \"Segoe UI\",\n    Arial,\n    sans-serif;\n\n  font-size: 14px;\n  font-weight: 600;\n  font-style: normal;\n  letter-spacing: 0.15px;\n\n  fill: #246875;\n  text-anchor: middle;\n  dominant-baseline: central;\n}\n\n.pid-number,\n.pid-scale {\n  font-family:\n    \"IBM Plex Mono\",\n    Consolas,\n    \"Liberation Mono\",\n    monospace;\n\n  font-size: 11px;\n  font-weight: 500;\n  font-variant-numeric: tabular-nums;\n\n  text-anchor: middle;\n  dominant-baseline: central;\n}\n\n.pid-number {\n  fill: #30485C;\n}\n\n.pid-scale {\n  fill: #738A9B;\n}\n\n.pid-field {\n  fill: url(\"#pid-field-fill\");\n  stroke: #65778C;\n  stroke-width: 1;\n\n  filter: drop-shadow(\n    0 0.8px 0.6px rgba(34, 49, 65, 0.10)\n  );\n}\n\n.pid-bar {\n  fill: url(\"#pid-bar-fill\");\n  stroke: #65778C;\n  stroke-width: 1;\n}\n\n.pid-control {\n  fill: url(\"#pid-control-fill\");\n  stroke: #819CAA;\n  stroke-width: 1;\n\n  filter: drop-shadow(\n    0 1px 0.8px rgba(34, 49, 65, 0.12)\n  );\n}\n\n.pid-reflection {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 1;\n  stroke-linecap: round;\n  opacity: 0.5;\n}\n\n.pid-tick {\n  fill: none;\n  stroke: #8B9FAF;\n  stroke-width: 1;\n  stroke-linecap: round;\n}\n\n.pid-label {\n  font-size: 17px;\n}\n\n.pid-number,\n.pid-scale {\n  font-size: 13px;\n}",
