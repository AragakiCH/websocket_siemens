ve\" transform=\"translate(276 282)\"/>\n\n    <!-- ==================================================\n         CUBA 11\n         ================================================== -->\n\n    <path\n      class=\"lv2-condensate\"\n      d=\"M 505 284 H 530 V 240\"\n    />\n\n    <path\n      class=\"lv2-steam lv2-valve-connection\"\n      d=\"\n        M 530 240 L 540 250 L 549 240 V 272\n        M 549 290 V 302 H 512\n      \"\n    />\n\n    <path\n      class=\"lv2-control\"\n      d=\"M 614 239 V 281 H 564\"\n    />\n    <circle class=\"lv2-control-node\" cx=\"614\" cy=\"239\" r=\"3.5\"/>\n\n    <use href=\"#lv2-valve\" transform=\"translate(549 281)\"/>\n\n    <!-- ==================================================\n         CUBA INFERIOR: ESTACIÓN IZQUIERDA\n         ================================================== -->\n\n    <path\n      class=\"lv2-condensate\"\n      d=\"M 46 586 V 371\"\n    />\n\n    <path\n      class=\"lv2-steam lv2-valve-connection\"\n      d=\"\n        M 46 371 L 56 381 L 65 371 V 403\n        M 65 421 V 545\n      \"\n    />\n\n    <path\n      class=\"lv2-control\"\n      d=\"M 112 369 V 412 H 80\"\n    />\n    <circle class=\"lv2-control-node\" cx=\"112\" cy=\"369\" r=\"3.5\"/>\n\n    <use href=\"#lv2-valve\" transform=\"translate(65 412)\"/>\n\n    <!-- ==================================================\n         CUBA INFERIOR: ESTACIÓN CENTRAL\n         ================================================== -->\n\n    <path\n      class=\"lv2-condensate\"\n      d=\"M 231 415 H 273 V 373\"\n    />\n\n    <path\n      class=\"lv2-steam lv2-valve-connection\"\n      d=\"\n        M 273 373 L 283 383 L 292 373 V 404\n        M 292 422 V 430 H 238\n      \"\n    />\n\n    <path\n      class=\"lv2-control\"\n      d=\"M 357 371 V 413 H 307\"\n    />\n    <circle class=\"lv2-control-node\" cx=\"357\" cy=\"371\" r=\"3.5\"/>\n\n    <use href=\"#lv2-valve\" transform=\"translate(292 413)\"/>\n\n    <!-- ====================================