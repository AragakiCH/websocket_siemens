{
  "kind": "l3_2_lava_secc_2",
  "nombre": "L3 2 LAVA SECC 2",
  "html": "<div class=\"lv2-widget\">\n  <svg\n    class=\"lv2-svg\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    viewBox=\"0 0 873 634\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    role=\"img\"\n    aria-label=\"Estiramiento Principal - Lavadora Línea 4\"\n  >\n    <defs>\n      <!-- Acabado satinado de las poleas. -->\n      <linearGradient\n        id=\"lv2-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\"/>\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"43%\" class=\"lv2-metal-stop\"/>\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\"/>\n        <stop offset=\"74%\" class=\"lv2-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\"/>\n      </linearGradient>\n\n      <!-- Acabado satinado de las cubas. -->\n      <linearGradient\n        id=\"lv2-tank-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#ECEEF0\"/>\n        <stop offset=\"16%\" stop-color=\"#E2E4E7\"/>\n        <stop offset=\"46%\" class=\"lv2-metal-stop\"/>\n        <stop offset=\"62%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"84%\" class=\"lv2-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C6C8CD\"/>\n      </linearGradient>\n\n      <linearGradient\n        id=\"lv2-liquid-gradient\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#B4DCEF\"/>\n        <stop offset=\"35%\" class=\"lv2-liquid-stop\"/>\n        <stop offset=\"75%\" class=\"lv2-liquid-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#92C3DE\"/>\n      </linearGradient>\n\n      <!-- Sombra ambiental y sombra de contacto de las poleas. -->\n      <filter\n        id=\"lv2-roller-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\"/>\n          <feMergeNode in=\"rollerContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!-- Sombra suave de las cubas. -->\n      <filter\n        id=\"lv2-tank-shadow\"\n        x=\"-5%\" y=\"-30%\"\n        width=\"110%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"2\"\n          result=\"tankAmbientBlur\"\n        />\n        <feOffset\n          in=\"tankAmbientBlur\"\n          dx=\"0\" dy=\"2.5\"\n          result=\"tankAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.10\"\n          result=\"tankAmbientColor\"\n        />\n        <feComposite\n          in=\"tankAmbientColor\"\n          in2=\"tankAmbientOffset\"\n          operator=\"in\"\n          result=\"tankAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.5\"\n          result=\"tankContactBlur\"\n        />\n        <feOffset\n          in=\"tankContactBlur\"\n          dx=\"0\" dy=\"0.8\"\n          result=\"tankContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.15\"\n          result=\"tankContactColor\"\n        />\n        <feComposite\n          in=\"tankContactColor\"\n          in2=\"tankContactOffset\"\n          operator=\"in\"\n          result=\"tankContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"tankAmbientShadow\"/>\n          <feMergeNode in=\"tankContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!--\n        Válvula vertical:\n        cuerpo transparente;\n        unión horizontal de 0.7 px;\n        actuador elíptico rx=1.5, ry=6.5.\n      -->\n      <g id=\"lv2-valve\">\n        <path\n          class=\"lv2-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n        <path\n          class=\"lv2-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n        <line\n          class=\"lv2-valve-stem\"\n          x1=\"0\" y1=\"0\"\n          x2=\"13\" y2=\"0\"\n        />\n        <ellipse\n          class=\"lv2-valve-actuator\"\n          cx=\"13\" cy=\"0\"\n          rx=\"1.5\" ry=\"6.5\"\n        />\n      </g>\n    </defs>\n\n    <!-- ==================================================\n         CUBAS\n         Franja inferior con 4 unidades de margen lateral\n         e inferior.\n         ================================================== -->\n\n    <g class=\"lv2-tank\">\n      <rect\n        class=\"lv2-tank-body\"\n        x=\"54\" y=\"85\"\n        width=\"807\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n      <rect\n        class=\"lv2-tank-liquid\"\n        x=\"58\" y=\"103\"\n        width=\"799\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n      <path class=\"lv2-tank-highlight\" d=\"M 61 87 H 854\"/>\n      <path class=\"lv2-tank-shade\" d=\"M 61 119 H 854\"/>\n    </g>\n\n    <g class=\"lv2-tank\">\n      <rect\n        class=\"lv2-tank-body\"\n        x=\"10\" y=\"217\"\n        width=\"851\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n      <rect\n        class=\"lv2-tank-liquid\"\n        x=\"14\" y=\"235\"\n        width=\"843\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n      <path class=\"lv2-tank-highlight\" d=\"M 17 219 H 854\"/>\n      <path class=\"lv2-tank-shade\" d=\"M 17 251 H 854\"/>\n    </g>\n\n    <g class=\"lv2-tank\">\n      <rect\n        class=\"lv2-tank-body\"\n        x=\"10\" y=\"350\"\n        width=\"851\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n      <rect\n        class=\"lv2-tank-liquid\"\n        x=\"14\" y=\"368\"\n        width=\"843\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n      <path class=\"lv2-tank-highlight\" d=\"M 17 352 H 854\"/>\n      <path class=\"lv2-tank-shade\" d=\"M 17 384 H 854\"/>\n    </g>\n\n    <!-- ==================================================\n         COLECTORES\n         ================================================== -->\n\n    <path class=\"lv2-steam lv2-main\" d=\"M 1 545 H 842\"/>\n    <path class=\"lv2-condensate lv2-main\" d=\"M 1 586 H 843\"/>\n\n    <!-- ==================================================\n         MONTANTES PRINCIPALES\n         Los tramos detrás de las cubas quedan ocultos.\n         ================================================== -->\n\n    <path\n      class=\"lv2-steam lv2-valve-connection\"\n      d=\"\n        M 238 545 V 386\n        M 238 350 V 253\n        M 238 217 V 169 H 274 V 158\n      \"\n    />\n\n    <path\n      class=\"lv2-steam lv2-valve-connection\"\n     