  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.lv2-widget {\n  --lv2-metal: #D7D8DB;\n  --lv2-outline: #4E4E4E;\n  --lv2-liquid: #A0CFE9;\n  --lv2-fiber: #0A638F;\n  --lv2-steam: #930606;\n  --lv2-condensate: #4E4E4E;\n  --lv2-control: #01524F;\n  --lv2-valve: #0E0E55;\n  --lv2-text: #000000;\n\n  display: grid;\n  place-items: center;\n\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  background: transparent;\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  pointer-events: none;\n}\n\n.lv2-widget,\n.lv2-widget * {\n  box-sizing: border-box;\n  animation: none !important;\n  transition: none !important;\n}\n\n.lv2-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n/* Colores base de los acabados. */\n\n.lv2-metal-stop {\n  stop-color: var(--lv2-metal);\n}\n\n.lv2-liquid-stop {\n  stop-color: var(--lv2-liquid);\n}\n\n/* Cubas. */\n\n.lv2-tank {\n  filter: url(\"#lv2-tank-shadow\");\n}\n\n.lv2-tank-body {\n  fill: url(\"#lv2-tank-metal\");\n  stroke: var(--lv2-outline);\n  stroke-width: 1.8;\n  stroke-linejoin: round;\n}\n\n.lv2-tank-liquid {\n  fill: url(\"#lv2-liquid-gradient\");\n  stroke: none;\n}\n\n.lv2-tank-highlight {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 0.7;\n  stroke-linecap: round;\n  opacity: 0.48;\n}\n\n.lv2-tank-shade {\n  fill: none;\n  stroke: #555D69;\n  stroke-width: 0.65;\n  stroke-linecap: round;\n  opacity: 0.16;\n}\n\n/* Líneas de proceso y control. */\n\n.lv2-steam,\n.lv2-condensate,\n.lv2-control {\n  fill: none;\n  stroke-width: 1.6;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.lv2-steam {\n  stroke: var(--lv2-steam);\n}\n\n.lv2-condensate {\n  stroke: var(--lv2-condensate);\n}\n\n.lv2-control {\n  stroke: var(--lv2-control);\n}\n\n.lv2-main {\n  stroke-width: 2;\n}\n\n/* Terminaciones exactas junto a las válvulas. */\n\n.lv2-valve-connection {\n  stroke-linecap: butt;\n}\n\n.lv2-control-node {\n  fill: var(--lv2-control);\n  stroke: none;\n}\n\n/* Válvulas transparentes. */\n\n.lv2-valve-body {\n  fill: none;\n  stroke: var(--lv2-valve);\n  stroke-width: 1.4;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.lv2-valve-stem {\n  fill: none;\n  stroke: var(--lv2-valve);\n  stroke-width: 0.7;\n  stroke-linecap: butt;\n}\n\n.lv2-valve-actuator {\n  fill: var(--lv2-valve);\n  stroke: var(--lv2-valve);\n  stroke-width: 1;\n}\n\n/* Cuerda: se dibuja detrás de los cuerpos de las poleas. */\n\n.lv2-fiber {\n  fill: none;\n  stroke: var(--lv2-fiber);\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Poleas: sin líneas, anillos ni símbolos interiores. */\n\n.lv2-roller-body {\n  fill: url(\"#lv2-roller-metal\");\n  stroke: var(--lv2-outline);\n  stroke-width: 2.2;\n  filter: url(\"#lv2-roller-shadow\");\n}\n\n.lv2-roller-number {\n  fill: var(--lv2-text);\n  stroke: none;\n\n  font-family: \"IBM Plex Mono\", Consolas, monospace;\n  font-size: 13px;\n  font-weight: 700;\n\n  text-anchor: middle;\n  dominant-baseline: middle;\n}\n\n/* Textos. */\n\n.lv2-label {\n  fill: var(--lv2-text);\n  stroke: none;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.lv2-steam-label,\n.lv2-condensate-label {\n  stroke: none;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.lv2-steam-label {\n  fill: var(--lv2-steam);\n}\n\n.lv2-condensate-label {\n  fill: var(--lv2-condensate);\n}\n\n.lv2-footer {\n  fill: var(--lv2-text);\n  stroke: none;\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
