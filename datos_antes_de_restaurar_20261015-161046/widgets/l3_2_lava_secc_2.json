7.710014\n        A 19.5 20.5 0 0 0 727.531362 159.361503\n        L 678.468638 221.138497\n        A 19.5 20.5 0 0 1 663.445764 228.499921\n        L 492.445764 227.999921\n        A 19.5 20.5 0 0 1 474.537770 215.479243\n        L 455.462230 168.020757\n        A 19.5 20.5 0 0 0 419.256958 168.759007\n        L 402.743042 214.740993\n        A 19.5 20.5 0 0 1 384.448760 227.999929\n        L 203.448760 227.499929\n        A 19.5 20.5 0 0 1 189.531820 221.304389\n        L 138.468180 166.195611\n        A 19.5 20.5 0 0 0 119.073278 160.809830\n        L 32.073278 187.309830\n        A 19.5 20.5 0 0 0 21.214940 218.276039\n        L 63.785060 286.223961\n        A 19.5 20.5 0 0 1 66.993890 298.013126\n        L 66.006110 339.486874\n        A 19.5 20.5 0 1 0 104.994175 340.501030\n        L 106.005825 296.998970\n        A 19.5 20.5 0 1 1 144.993890 298.013126\n        L 144.006110 339.486874\n        A 19.5 20.5 0 0 0 182.909429 341.973516\n        L 187.090571 296.526484\n        A 19.5 20.5 0 0 1 221.732231 285.700706\n        L 274.267769 354.799294\n        A 19.5 20.5 0 0 0 289.592435 362.499770\n        L 590.592435 360.999770\n        A 19.5 20.5 0 0 0 606.540634 352.156820\n        L 651.459366 283.843180\n        A 19.5 20.5 0 0 1 686.950028 294.033312\n        L 690.049972 339.466688\n        A 19.5 20.5 0 0 0 728.993890 337.486874\n        L 728.006110 296.013126\n        A 19.5 20.5 0 1 1 766.994175 294.998970\n        L 768.005825 338.501030\n        A 19.5 20.5 0 1 0 806.973690 336.935460\n        L 805.026310 297.564540\n        A 19.5 20.5 0 0 1 839.805179 283.797245\n        L 873 328\n      \"\n    />\n\n    <!-- ==================================================\n         POLEAS\n         Cuerpos opacos que ocultan la cuerda en su interior.\n         ================================================== -->\n\n    <g class=\"lv2-rollers\">\n      <!-- Fila superior. -->\n      <ellipse class=\"lv2-roller-body\" cx=\"68.5\" cy=\"38\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"165.5\" cy=\"74.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"384.5\" cy=\"75.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"437.5\" cy=\"44\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"492.5\" cy=\"75.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"662.5\" cy=\"73.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"742.5\" cy=\"36\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"834.5\" cy=\"72.5\" rx=\"19.5\" ry=\"20.5\"/>\n\n      <!-- Fila intermedia. -->\n      <ellipse class=\"lv2-roller-body\" cx=\"834.5\" cy=\"208.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"742.5\" cy=\"172.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"663.5\" cy=\"208\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"492.5\" cy=\"207.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"437.5\" cy=\"176\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"384.5\" cy=\"207.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"203.5\" cy=\"207\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"124.5\" cy=\"180.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"37.5\" cy=\"207\" rx=\"19.5\" ry=\"20.5\"/>\n\n      <!-- Fila inferior. -->\n      <ellipse class=\"lv2-roller-body\" cx=\"47.5\" cy=\"297.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"85.5\" cy=\"340\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"125.5\" cy=\"297.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"163.5\" cy=\"340\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"lv2-roller-body\" cx=\"206.5\" cy=\"298.5\" 