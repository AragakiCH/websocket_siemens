{
  "kind": "l3_3_lava_secc_3",
  "nombre": "L3 3 LAVA SECC 3",
  "html": "<div class=\"ls3-widget\">\n  <svg\n    class=\"ls3-svg\"\n    viewBox=\"0 0 876 633\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Lavado sección 3. Lavadora Línea número 3\"\n  >\n    <defs>\n\n      <!-- Metal satinado de poleas -->\n\n      <linearGradient\n        id=\"ls3-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"ls3-metal-stop\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"ls3-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Metal satinado de cubas -->\n\n      <linearGradient\n        id=\"ls3-tank-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#ECEEF0\" />\n        <stop offset=\"16%\" stop-color=\"#E2E4E7\" />\n        <stop offset=\"46%\" class=\"ls3-metal-stop\" />\n        <stop offset=\"62%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"84%\" class=\"ls3-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C6C8CD\" />\n      </linearGradient>\n\n      <!-- Franja inferior azul -->\n\n      <linearGradient\n        id=\"ls3-liquid-gradient\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#B4DCEF\" />\n        <stop offset=\"35%\" class=\"ls3-liquid-stop\" />\n        <stop offset=\"75%\" class=\"ls3-liquid-stop\" />\n        <stop offset=\"100%\" stop-color=\"#92C3DE\" />\n      </linearGradient>\n\n      <!-- Sombra de poleas -->\n\n      <filter\n        id=\"ls3-roller-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!-- Sombra de cubas -->\n\n      <filter\n        id=\"ls3-tank-shadow\"\n        x=\"-5%\" y=\"-30%\"\n        width=\"110%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"2\"\n          result=\"tankAmbientBlur\"\n        />\n        <feOffset\n          in=\"tankAmbientBlur\"\n          dx=\"0\" dy=\"2.5\"\n          result=\"tankAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.10\"\n          result=\"tankAmbientColor\"\n        />\n        <feComposite\n          in=\"tankAmbientColor\"\n          in2=\"tankAmbientOffset\"\n          operator=\"in\"\n          result=\"tankAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.5\"\n          result=\"tankContactBlur\"\n        />\n        <feOffset\n          in=\"tankContactBlur\"\n          dx=\"0\" dy=\"0.8\"\n          result=\"tankContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.15\"\n          result=\"tankContactColor\"\n        />\n        <feComposite\n          in=\"tankContactColor\"\n          in2=\"tankContactOffset\"\n          operator=\"in\"\n          result=\"tankContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"tankAmbientShadow\" />\n          <feMergeNode in=\"tankContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!-- Polea principal -->\n\n      <ellipse\n        id=\"ls3-roller\"\n        class=\"ls3-roller\"\n        cx=\"0\" cy=\"0\"\n        rx=\"19.5\" ry=\"20.5\"\n      />\n\n      <!--\n        Válvula vertical.\n        Interior transparente.\n        Actuador de 3 × 13 unidades SVG.\n        Unión horizontal de 0.7 px.\n      -->\n\n      <g id=\"ls3-valve\">\n        <path\n          class=\"ls3-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n        <path\n          class=\"ls3-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n\n        <line\n          class=\"ls3-valve-link\"\n          x1=\"0\" y1=\"0\"\n          x2=\"13\" y2=\"0\"\n        />\n\n        <ellipse\n          class=\"ls3-valve-actuator\"\n          cx=\"13\" cy=\"0\"\n          rx=\"1.5\" ry=\"6.5\"\n        />\n      </g>\n\n    </defs>\n\n    <!-- ==================================================\n         CUBAS\n         Franja inferior con margen de 4 unidades SVG.\n         ================================================== -->\n\n    <g class=\"ls3-tank-group\">\n      <rect\n        class=\"ls3-tank-shell\"\n        x=\"13\" y=\"83\"\n        width=\"850\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n\n      <rect\n        class=\"ls3-tank-liquid\"\n        x=\"17\" y=\"101\"\n        width=\"842\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path class=\"ls3-highlight\" d=\"M 20 85 H 856\" />\n      <path class=\"ls3-edge-shade\" d=\"M 20 117 H 856\" />\n    </g>\n\n    <g class=\"ls3-tank-group\">\n      <rect\n        class=\"ls3-tank-shell\"\n        x=\"13\" y=\"215\"\n        width=\"850\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n\n      <rect\n        class=\"ls3-tank-liquid\"\n        x=\"17\" y=\"233\"\n        width=\"842\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path class=\"ls3-highlight\" d=\"M 20 217 H 856\" />\n      <path class=\"ls3-edge-shade\" d=\"M 20 249 H 856\" />\n    </g>\n\n    <g class=\"ls3-tank-group\">\n      <rect\n        class=\"ls3-tank-shell\"\n        x=\"13\" y=\"348\"\n        width=\"850\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n\n      <rect\n        class=\"ls3-tank-liquid\"\n        x=\"17\" y=\"366\"\n        width=\"842\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path class=\"ls3-highlight\" d=\"M 20 350 H 856\" />\n      <path class=\"ls3-edge-shade\" d=\"M 20 382 H 856\" />\n    </g>\n\n    <!-- ==================================================\n         COLECTORES PRINCIPALES\n         ================================================== -->\n\n    <path\n      class=\"ls3-steam ls3-main\"\n      d=\"M 14 543 H 843\"\n    />\n\n    <path\n      class=\"ls3-condensate ls3-main\"\n      d=\"M 13 584 H 844\"\n    />\n\n    <!-- ==================================================\n         COLUMNAS DE VAPOR\n         Interrumpidas donde quedan detrás de las cubas.\n         ================================================== -->\n\n    <g class=\"ls3-steam\">\n      <path\n        d=\"\n          M 101 543\n          V 384\n          M 101 348\n          V 251\n          M 101 215\n          V 164\n          H 137\n          V 153\n        \"\n      />\n\n      <path\n        d=\"\n          M 523 543\n          V 384\n          M 523 348\n          V 251\n          M 523 215\n          V 166\n          H 559\n          V 155\n        \"\n      />\n    </g>\n\n    <!-- ==================================================\n         COLUMNAS DE CONDENSADO\n         ================================================== -->\n\n    <g class=\"ls3-condensate\">\n      <path\n        d=\"\n          M 94 584\n          V 384\n          M 94 348\n          V 251\n          M 94 215\n          V 146\n          H 118\n          V 103\n        \"\n      />\n\n      <path\n        d=\"\n          M 516 584\n          V 384\n          M 516 348\n          V 251\n          M 516 215\n          V 148\n          H 541\n          V 105\n        \"\n      />\n    </g>\n\n    <!-- ==================================================\n         CUBA 3\n         ================================================== -->\n\n    <path\n      class=\"ls3-steam ls3-heater\"\n      d=\"\n        M 118 103\n        L 128 113\n        L 137 103\n        V 135\n      \"\n    />\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 203 111 V 144 H 152\"\n    />\n\n    <circle\n      class=\"ls3-control-node\"\n      cx=\"203\" cy=\"111\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls3-valve\"\n      transform=\"translate(137 144)\"\n    />\n\n    <!-- ==================================================\n         CUBA 4\n         ================================================== -->\n\n    <path\n      class=\"ls3-steam ls3-heater\"\n      d=\"\n        M 541 105\n        L 550 115\n        L 559 105\n        V 137\n      \"\n    />\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 625 111 V 146 H 574\"\n    />\n\n    <circle\n      class=\"ls3-control-node\"\n      cx=\"625\" cy=\"111\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls3-valve\"\n      transform=\"translate(559 146)\"\n    />\n\n    <!-- ==================================================\n         CUBA 10\n         ================================================== -->\n\n    <path\n      class=\"ls3-condensate\"\n      d=\"M 94 280 H 119 V 236\"\n    />\n\n    <path\n      class=\"ls3-steam ls3-heater\"\n      d=\"\n        M 119 236\n        L 129 246\n        L 138 236\n        V 268\n      \"\n    />\n\n    <path\n      class=\"ls3-steam\"\n      d=\"M 138 286 V 298 H 101\"\n    />\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 203 243 V 277 H 153\"\n    />\n\n    <circle\n      class=\"ls3-control-node\"\n      cx=\"203\" cy=\"243\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls3-valve\"\n      transform=\"translate(138 277)\"\n    />\n\n    <!-- ==================================================\n         CUBA 9\n         ================================================== -->\n\n    <path\n      class=\"ls3-condensate\"\n      d=\"M 516 282 H 542 V 238\"\n    />\n\n    <path\n      class=\"ls3-steam ls3-heater\"\n      d=\"\n        M 542 238\n        L 551 248\n        L 560 238\n        V 270\n      \"\n    />\n\n    <path\n      class=\"ls3-steam\"\n      d=\"M 560 288 V 300 H 523\"\n    />\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 625 243 V 279 H 575\"\n    />\n\n    <circle\n      class=\"ls3-control-node\"\n      cx=\"625\" cy=\"243\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls3-valve\"\n      transform=\"translate(560 279)\"\n    />\n\n    <!-- ==================================================\n         CUBA 13\n         ================================================== -->\n\n    <path\n      class=\"ls3-condensate\"\n      d=\"M 94 412 H 120 V 367\"\n    />\n\n    <path\n      class=\"ls3-steam ls3-heater\"\n      d=\"\n        M 120 367\n        L 130 377\n        L 139 367\n        V 397\n      \"\n    />\n\n    <path\n      class=\"ls3-steam\"\n      d=\"M 139 415 V 429 H 101\"\n    />\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 203 374 V 406 H 154\"\n    />\n\n    <circle\n      class=\"ls3-control-node\"\n      cx=\"203\" cy=\"374\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls3-valve\"\n      transform=\"translate(139 406)\"\n    />\n\n    <!-- ==================================================\n         CUBA 14\n         ================================================== -->\n\n    <path\n      class=\"ls3-condensate\"\n      d=\"M 516 414 H 543 V 369\"\n    />\n\n    <path\n      class=\"ls3-steam ls3-heater\"\n      d=\"\n        M 543 369\n        L 552 379\n        L 561 369\n        V 401\n      \"\n    />\n\n    <path\n      class=\"ls3-steam\"\n      d=\"M 561 419 V 431 H 523\"\n    />\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 625 374 V 410 H 576\"\n    />\n\n    <circle\n      class=\"ls3-control-node\"\n      cx=\"625\" cy=\"374\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls3-valve\"\n      transform=\"translate(561 410)\"\n    />\n\n    <!-- ==================================================\n         AGUA DESMINERALIZADA\n         ================================================== -->\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 476 374 V 474\"\n    />\n\n    <path\n      class=\"ls3-control\"\n      d=\"M 476 492 V 502 H 514\"\n    />\n\n    <circle\n      class=\"ls3-control-node\"\n      cx=\"476\" cy=\"374\"\n      r=\"4\"\n    />\n\n    <use\n      href=\"#ls3-valve\"\n      transform=\"translate(476 483) scale(-1 1)\"\n    />\n\n    <g>\n      <rect\n        class=\"ls3-water-plate\"\n        x=\"514\" y=\"468\"\n        width=\"175\" height=\"51\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path\n        class=\"ls3-highlight\"\n        d=\"M 518 470 H 685\"\n      />\n\n      <text\n        class=\"ls3-water-label\"\n        x=\"520\" y=\"485\"\n      >\n        Agua Desmineralizada\n      </text>\n    </g>\n\n    <!-- ==================================================\n         CUERDA SUPERIOR\n         Numeración 25–27 repetida según la referencia.\n         ================================================== -->\n\n    <path\n      class=\"ls3-fiber\"\n      d=\"\n        M 2 97\n        L 330.556 96.000\n        A 19.5 20.5 0 0 0 346.969 86.477\n        L 384.031 25.023\n        A 19.5 20.5 0 0 1 417.603 26.153\n        L 447.397 83.347\n        A 19.5 20.5 0 0 0 464.578 94.000\n        L 702.578 93.000\n        A 19.5 20.5 0 0 0 718.969 83.477\n        L 756.031 22.023\n        A 19.5 20.5 0 0 1 789.603 23.153\n        L 819.397 80.347\n        A 19.5 20.5 0 0 0 835.573 90.977\n        L 876 93\n      \"\n    />\n\n    <!-- ==================================================\n         CUERDA CENTRAL\n         ================================================== -->\n\n    <path\n      class=\"ls3-fiber\"\n      d=\"\n        M 7 229\n        L 332.642 226.499\n        A 19.5 20.5 0 0 0 349.096 216.763\n        L 384.904 155.737\n        A 19.5 20.5 0 0 1 418.603 156.653\n        L 448.397 213.847\n        A 19.5 20.5 0 0 0 465.265 224.499\n        L 702.265 227.499\n        A 19.5 20.5 0 0 0 719.096 217.763\n        L 754.904 156.737\n        A 19.5 20.5 0 0 1 788.603 157.653\n        L 818.397 214.847\n        A 19.5 20.5 0 0 0 834.819 225.488\n        L 876 227\n      \"\n    />\n\n    <!-- ==================================================\n         CUERDA INFERIOR\n         Incluye la polea pequeña 73.\n         ================================================== -->\n\n    <path\n      class=\"ls3-fiber\"\n      d=\"\n        M 7 313\n        L 43.553 352.327\n        A 19.5 20.5 0 0 0 57.466 358.500\n        L 332.466 359.000\n        A 19.5 20.5 0 0 0 348.969 349.477\n        L 386.031 288.023\n        A 19.5 20.5 0 0 1 419.603 289.153\n        L 449.397 346.347\n        A 19.5 20.5 0 0 0 466.500 357.000\n        L 704.500 357.000\n        A 19.5 20.5 0 0 0 721.457 346.622\n        L 754.258 285.891\n        A 14.5 14.5 0 1 0 750.518 290.354\n        L 762.745 280.643\n        A 19.5 20.5 0 0 1 791.603 287.153\n        L 821.397 344.347\n        A 19.5 20.5 0 0 0 837.048 354.943\n        L 876 358\n      \"\n    />\n\n    <!-- ==================================================\n         POLEAS\n         Se dibujan después de las cuerdas.\n         ================================================== -->\n\n    <g aria-label=\"Poleas superiores\">\n      <use href=\"#ls3-roller\" transform=\"translate(330.5 75.5)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(400.5 36)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(464.5 73.5)\" />\n\n      <use href=\"#ls3-roller\" transform=\"translate(702.5 72.5)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(772.5 33)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(836.5 70.5)\" />\n    </g>\n\n    <g aria-label=\"Poleas centrales\">\n      <use href=\"#ls3-roller\" transform=\"translate(332.5 206)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(401.5 166.5)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(465.5 204)\" />\n\n      <use href=\"#ls3-roller\" transform=\"translate(702.5 207)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(771.5 167.5)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(835.5 205)\" />\n    </g>\n\n    <g aria-label=\"Poleas inferiores\">\n      <use href=\"#ls3-roller\" transform=\"translate(57.5 338)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(332.5 338.5)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(402.5 299)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(466.5 336.5)\" />\n\n      <use href=\"#ls3-roller\" transform=\"translate(704.5 336.5)\" />\n      <use href=\"#ls3-roller\" transform=\"translate(774.5 297)\" />\n\n      <circle\n        class=\"ls3-roller\"\n        cx=\"741.5\" cy=\"279\"\n        r=\"14.5\"\n      />\n\n      <use href=\"#ls3-roller\" transform=\"translate(838.5 334.5)\" />\n    </g>\n\n    <!-- ==================================================\n         NÚMEROS CENTRADOS A 13 PX\n         ================================================== -->\n\n    <g class=\"ls3-number\">\n\n      <!-- Fila superior -->\n\n      <text x=\"330.5\" y=\"75.5\">25</text>\n      <text x=\"400.5\" y=\"36\">26</text>\n      <text x=\"464.5\" y=\"73.5\">27</text>\n\n      <text x=\"702.5\" y=\"72.5\">28</text>\n      <text x=\"772.5\" y=\"33\">29</text>\n      <text x=\"836.5\" y=\"70.5\">30</text>\n\n      <!-- Fila central -->\n\n      <text x=\"332.5\" y=\"206\">45</text>\n      <text x=\"401.5\" y=\"166.5\">44</text>\n      <text x=\"465.5\" y=\"204\">43</text>\n\n      <text x=\"702.5\" y=\"207\">42</text>\n      <text x=\"771.5\" y=\"167.5\">41</text>\n      <text x=\"835.5\" y=\"205\">40</text>\n\n      <!-- Fila inferior -->\n\n      <text x=\"57.5\" y=\"338\">67</text>\n      <text x=\"332.5\" y=\"338.5\">68</text>\n      <text x=\"402.5\" y=\"299\">69</text>\n      <text x=\"466.5\" y=\"336.5\">70</text>\n\n      <text x=\"704.5\" y=\"336.5\">71</text>\n      <text x=\"774.5\" y=\"297\">72</text>\n      <text x=\"741.5\" y=\"279\">73</text>\n      <text x=\"838.5\" y=\"334.5\">74</text>\n\n    </g>\n\n    <!-- ==================================================\n         TEXTOS\n         ================================================== -->\n\n    <g class=\"ls3-tank-label\">\n      <text x=\"228\" y=\"133\">CUBA 3</text>\n      <text x=\"654\" y=\"137\">CUBA 4</text>\n\n      <text x=\"228\" y=\"265\">CUBA 10</text>\n      <text x=\"654\" y=\"267\">CUBA 9</text>\n\n      <text x=\"228\" y=\"400\">CUBA 13</text>\n      <text x=\"654\" y=\"402\">CUBA 14</text>\n    </g>\n\n    <text class=\"ls3-steam-label\" x=\"10\" y=\"536\">\n      Vapor 15 bar\n    </text>\n\n    <text class=\"ls3-condensate-label\" x=\"11\" y=\"577\">\n      Condensado\n    </text>\n\n    <text class=\"ls3-footer\" x=\"845\" y=\"618\">\n      Lavado - Lavadora Línea #3\n    </text>\n\n  </svg>\n</div>",
  "css": ":root {\n  --ls3-font: \"Segoe UI\", Arial, sans-serif;\n  --ls3-number-font: \"IBM Plex Mono\", Consolas, monospace;\n\n  --ls3-metal: #D7D8DB;\n  --ls3-outline: #4E4E4E;\n  --ls3-liquid: #A0CFE9;\n\n  --ls3-fiber: #0A638F;\n  --ls3-steam: #930606;\n  --ls3-condensate: #4E4E4E;\n  --ls3-control: #01524F;\n  --ls3-valve: #0E0E55;\n\n  --ls3-text: #000000;\n\n  --ls3-roller-width: 2.2px;\n  --ls3-fiber-width: 1.8px;\n  --ls3-process-width: 1.6px;\n  --ls3-main-width: 2px;\n  --ls3-valve-width: 1.4px;\n}\n\n/* Entorno */\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ls3-widget {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  font-family: var(--ls3-font);\n  pointer-events: none;\n}\n\n.ls3-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.ls3-widget,\n.ls3-widget * {\n  animation: none !important;\n  transition: none !important;\n}\n\n/* Acabados */\n\n.ls3-metal-stop {\n  stop-color: var(--ls3-metal);\n}\n\n.ls3-liquid-stop {\n  stop-color: var(--ls3-liquid);\n}\n\n/* Cubas */\n\n.ls3-tank-group {\n  filter: url(\"#ls3-tank-shadow\");\n}\n\n.ls3-tank-shell {\n  fill: url(\"#ls3-tank-metal\");\n  stroke: var(--ls3-outline);\n  stroke-width: 1.8px;\n  stroke-linejoin: round;\n}\n\n.ls3-tank-liquid {\n  fill: url(\"#ls3-liquid-gradient\");\n  stroke: none;\n}\n\n.ls3-highlight {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  opacity: 0.48;\n}\n\n.ls3-edge-shade {\n  fill: none;\n  stroke: #555D69;\n  stroke-width: 0.65px;\n  stroke-linecap: round;\n  opacity: 0.16;\n}\n\n/* Poleas: metal satinado sin anillo interior */\n\n.ls3-roller {\n  fill: url(\"#ls3-roller-metal\");\n  stroke: var(--ls3-outline);\n  stroke-width: var(--ls3-roller-width);\n  filter: url(\"#ls3-roller-shadow\");\n}\n\n/* Cuerda */\n\n.ls3-fiber {\n  fill: none;\n  stroke: var(--ls3-fiber);\n  stroke-width: var(--ls3-fiber-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Tuberías */\n\n.ls3-steam,\n.ls3-condensate,\n.ls3-control {\n  fill: none;\n  stroke-width: var(--ls3-process-width);\n  stroke-linecap: butt;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ls3-steam {\n  stroke: var(--ls3-steam);\n}\n\n.ls3-condensate {\n  stroke: var(--ls3-condensate);\n}\n\n.ls3-control {\n  stroke: var(--ls3-control);\n}\n\n.ls3-main {\n  stroke-width: var(--ls3-main-width);\n  stroke-linecap: round;\n}\n\n.ls3-heater {\n  stroke-linecap: round;\n}\n\n.ls3-control-node {\n  fill: var(--ls3-control);\n  stroke: var(--ls3-control);\n  stroke-width: 1px;\n}\n\n/* Válvulas */\n\n.ls3-valve-body {\n  fill: none;\n  stroke: var(--ls3-valve);\n  stroke-width: var(--ls3-valve-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ls3-valve-link {\n  fill: none;\n  stroke: var(--ls3-valve);\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n}\n\n.ls3-valve-actuator {\n  fill: var(--ls3-valve);\n  stroke: var(--ls3-valve);\n  stroke-width: 1px;\n}\n\n/* Numeración uniforme y centrada */\n\n.ls3-number {\n  fill: var(--ls3-text);\n  font-family: var(--ls3-number-font);\n  font-size: 13px;\n  font-weight: 700;\n  text-anchor: middle;\n  dominant-baseline: middle;\n  pointer-events: none;\n}\n\n/* Placa de agua desmineralizada */\n\n.ls3-water-plate {\n  fill: url(\"#ls3-tank-metal\");\n  stroke: var(--ls3-outline);\n  stroke-width: 1.6px;\n}\n\n.ls3-water-label {\n  fill: var(--ls3-steam);\n  font-family: var(--ls3-font);\n  font-size: 14px;\n  font-weight: 600;\n  font-style: italic;\n}\n\n/* Textos */\n\n.ls3-tank-label {\n  fill: var(--ls3-text);\n  font-family: var(--ls3-font);\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.ls3-steam-label {\n  fill: var(--ls3-steam);\n  font-family: var(--ls3-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls3-condensate-label {\n  fill: var(--ls3-condensate);\n  font-family: var(--ls3-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls3-footer {\n  fill: var(--ls3-text);\n  font-family: var(--ls3-font);\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
  "js": "\"use strict\";\n\n/*\n * LAVADO SECC. 3 — LAVADORA LÍNEA #3\n *\n * Widget gráfico estático.\n *\n * Cuerdas construidas mediante rectas tangentes y arcos\n * coincidentes con las superficies de las poleas.\n *\n * Las poleas se dibujan sobre las cuerdas para ocultar\n * los tramos de contacto.\n *\n * Numeración centrada, negra y uniforme a 13 px.\n *\n * Válvulas transparentes con actuadores ovalados\n * y uniones horizontales de 0.7 px.\n *\n * No utiliza tags, variables del PLC, temporizadores,\n * animaciones ni recursos externos.\n */",
