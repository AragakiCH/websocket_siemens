{
  "kind": "l4_9_vaporizador",
  "nombre": "L4 9 VAPORIZADOR",
  "html": "<div class=\"vap-widget\">\n  <svg\n    class=\"vap-svg\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    viewBox=\"0 0 859 605\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    role=\"img\"\n    aria-label=\"Vaporizador - Línea 4\"\n  >\n    <defs>\n      <!-- Acabado metálico de la carcasa. -->\n      <linearGradient\n        id=\"vap-shell-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#ECEEF0\"/>\n        <stop offset=\"16%\" stop-color=\"#E2E4E7\"/>\n        <stop offset=\"46%\" class=\"vap-metal-stop\"/>\n        <stop offset=\"62%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"84%\" class=\"vap-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C6C8CD\"/>\n      </linearGradient>\n\n      <!-- Acabado de conductos y piezas. -->\n      <linearGradient\n        id=\"vap-part-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"100%\" y2=\"0%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#C6C8CD\"/>\n        <stop offset=\"22%\" class=\"vap-metal-stop\"/>\n        <stop offset=\"45%\" stop-color=\"#ECEEF0\"/>\n        <stop offset=\"63%\" stop-color=\"#E1E3E6\"/>\n        <stop offset=\"82%\" class=\"vap-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\"/>\n      </linearGradient>\n\n      <linearGradient\n        id=\"vap-side-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"100%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#E0E2E5\"/>\n        <stop offset=\"48%\" class=\"vap-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#BFC2C8\"/>\n      </linearGradient>\n\n      <!-- Acabado satinado de los elementos circulares. -->\n      <linearGradient\n        id=\"vap-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\"/>\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"43%\" class=\"vap-metal-stop\"/>\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\"/>\n        <stop offset=\"74%\" class=\"vap-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\"/>\n      </linearGradient>\n\n      <!-- Mirillas claras. -->\n      <linearGradient\n        id=\"vap-window-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"80%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#FFFFFF\"/>\n        <stop offset=\"38%\" stop-color=\"#F5F6F7\"/>\n        <stop offset=\"66%\" stop-color=\"#ECEEF0\"/>\n        <stop offset=\"100%\" stop-color=\"#E0E3E7\"/>\n      </linearGradient>\n\n      <!-- Trama ligera del conducto de entrada. -->\n      <pattern\n        id=\"vap-hatching\"\n        width=\"7\"\n        height=\"7\"\n        patternUnits=\"userSpaceOnUse\"\n      >\n        <path\n          class=\"vap-hatch-line\"\n          d=\"M -1 1 L 1 -1 M 0 7 L 7 0 M 6 8 L 8 6\"\n        />\n      </pattern>\n\n      <!-- Sombra ambiental y de contacto de los equipos. -->\n      <filter\n        id=\"vap-equipment-shadow\"\n        x=\"-10%\" y=\"-10%\"\n        width=\"120%\" height=\"125%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"2\"\n          result=\"equipmentAmbientBlur\"\n        />\n        <feOffset\n          in=\"equipmentAmbientBlur\"\n          dx=\"0.4\" dy=\"2.5\"\n          result=\"equipmentAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.10\"\n          result=\"equipmentAmbientColor\"\n        />\n        <feComposite\n          in=\"equipmentAmbientColor\"\n          in2=\"equipmentAmbientOffset\"\n          operator=\"in\"\n          result=\"equipmentAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.5\"\n          result=\"equipmentContactBlur\"\n        />\n        <feOffset\n          in=\"equipmentContactBlur\"\n          dx=\"0\" dy=\"0.8\"\n          result=\"equipmentContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.15\"\n          result=\"equipmentContactColor\"\n        />\n        <feComposite\n          in=\"equipmentContactColor\"\n          in2=\"equipmentContactOffset\"\n          operator=\"in\"\n          result=\"equipmentContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"equipmentAmbientShadow\"/>\n          <feMergeNode in=\"equipmentContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!-- Sombra suave de los elementos circulares. -->\n      <filter\n        id=\"vap-contact-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"circleAmbientBlur\"\n        />\n        <feOffset\n          in=\"circleAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"circleAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"circleAmbientColor\"\n        />\n        <feComposite\n          in=\"circleAmbientColor\"\n          in2=\"circleAmbientOffset\"\n          operator=\"in\"\n          result=\"circleAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"circleContactBlur\"\n        />\n        <feOffset\n          in=\"circleContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"circleContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"circleContactColor\"\n        />\n        <feComposite\n          in=\"circleContactColor\"\n          in2=\"circleContactOffset\"\n          operator=\"in\"\n          result=\"circleContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"circleAmbientShadow\"/>\n          <feMergeNode in=\"circleContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!--\n        Válvula transparente.\n        Actuador: rx=1.5, ry=6.5.\n        Unión horizontal: 0.7 px.\n      -->\n      <g id=\"vap-valve\">\n        <path\n          class=\"vap-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n        <path\n          class=\"vap-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n        <line\n          class=\"vap-valve-stem\"\n          x1=\"0\" y1=\"0\"\n          x2=\"13\" y2=\"0\"\n        />\n        <ellipse\n          class=\"vap-valve-actuator\"\n          cx=\"13\" cy=\"0\"\n          rx=\"1.5\" ry=\"6.5\"\n        />\n      </g>\n\n      <!-- Geometría del conducto curvo de entrada. -->\n      <path\n        id=\"vap-inlet-shape\"\n        d=\"\n          M 6 215\n          H 103\n          C 142 215 174 246 174 284\n          C 174 317 148 346 109 355\n          V 377\n          H 14\n          V 325\n          H 102\n          C 120 325 131 307 131 285\n          C 131 263 117 245 102 245\n          H 6\n          Z\n        \"\n      />\n    </defs>\n\n    <!-- ==================================================\n         CONDUCTO DE ENTRADA\n         ================================================== -->\n\n    <g class=\"vap-equipment-shadow\">\n      <use\n        href=\"#vap-inlet-shape\"\n        class=\"vap-metal-part\"\n      />\n      <use\n        href=\"#vap-inlet-shape\"\n        class=\"vap-duct-texture\"\n      />\n\n      <rect\n        class=\"vap-metal-side\"\n        x=\"109\" y=\"355\"\n        width=\"84\" height=\"22\"\n        rx=\"1.5\" ry=\"1.5\"\n      />\n      <rect\n        class=\"vap-duct-texture\"\n        x=\"110\" y=\"356\"\n        width=\"82\" height=\"20\"\n      />\n\n      <path\n        class=\"vap-highlight\"\n        d=\"\n          M 9 217 H 102\n          C 138 217 171 247 171 284\n        \"\n      />\n      <path\n        class=\"vap-highlight\"\n        d=\"M 113 357 H 189\"\n      />\n    </g>\n\n    <!-- ==================================================\n         CARCASA PRINCIPAL\n         ================================================== -->\n\n    <g class=\"vap-equipment-shadow\">\n      <path\n        class=\"vap-shell\"\n        d=\"\n          M 195 234\n          H 554\n          Q 556 234 556 236\n          V 373\n          H 797\n          Q 799 373 799 375\n          V 435\n          L 741 469\n          V 516\n          Q 741 518 739 518\n          H 195\n          Q 193 518 193 516\n          V 236\n          Q 193 234 195 234\n          Z\n        \"\n      />\n\n      <path\n        class=\"vap-seam\"\n        d=\"\n          M 322 235 V 517\n          M 442 235 V 517\n          M 556 373 V 517\n        \"\n      />\n\n      <path\n        class=\"vap-highlight\"\n        d=\"\n          M 197 237 H 552\n          M 560 376 H 795\n        \"\n      />\n\n      <path\n        class=\"vap-bottom-shade\"\n        d=\"M 197 515 H 737\"\n      />\n    </g>\n\n    <!-- ==================================================\n         DESMENUZADOR DE FIBRA\n         ================================================== -->\n\n    <g class=\"vap-equipment-shadow\">\n      <rect\n        class=\"vap-metal-part\"\n        x=\"612\" y=\"234\"\n        width=\"46\" height=\"90\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path\n        class=\"vap-metal-side\"\n        d=\"M 607 330 H 663 L 687 373 H 581 Z\"\n      />\n\n      <path\n        class=\"vap-metal-part\"\n        d=\"M 581 373 L 635 336 L 687 373 Z\"\n      />\n\n      <rect\n        class=\"vap-metal-part\"\n        x=\"603\" y=\"324\"\n        width=\"65\" height=\"6\"\n        rx=\"1\" ry=\"1\"\n      />\n\n      <path\n        class=\"vap-highlight\"\n        d=\"\n          M 615 237 V 320\n          M 606 326 H 665\n          M 586 370 L 635 339\n        \"\n      />\n    </g>\n\n    <!-- ==================================================\n         CONDUCTO DE SALIDA\n         ================================================== -->\n\n    <g class=\"vap-equipment-shadow\">\n      <path\n        class=\"vap-metal-part\"\n        d=\"\n          M 838 277\n          H 851\n          V 494\n          C 851 505 843 513 832 513\n          C 821 513 813 506 813 496\n          L 826 494\n          C 826 498 828 501 832 501\n          C 836 501 838 498 838 494\n          Z\n        \"\n      />\n\n      <path\n        class=\"vap-metal-side\"\n        d=\"\n          M 794 442\n          L 783 468\n          L 836 483\n          L 829 502\n          L 751 478\n          L 744 469\n          Z\n        \"\n      />\n\n      <path\n        class=\"vap-seam\"\n        d=\"\n          M 838 476 H 850\n          M 831 480\n          C 839 481 845 487 845 495\n          C 845 503 839 509 831 509\n          C 825 509 820 506 817 501\n        \"\n      />\n\n      <path\n        class=\"vap-highlight\"\n        d=\"\n          M 841 281 V 472\n          M 752 472 L 826 495\n        \"\n      />\n    </g>\n\n    <!-- ==================================================\n         COLECTORES SUPERIORES\n         ================================================== -->\n\n    <path\n      class=\"vap-condensate vap-main\"\n      d=\"M 0 31 H 859\"\n    />\n\n    <path\n      class=\"vap-steam vap-main\"\n      d=\"M 0 60 H 859\"\n    />\n\n    <!-- Retorno común de condensado. -->\n    <path\n      class=\"vap-condensate\"\n      d=\"M 591 31 V 227 H 227\"\n    />\n\n    <!-- Terminaciones rojas de los tres calentadores M. -->\n    <path\n      class=\"vap-steam\"\n      d=\"\n        M 227 267 V 227\n        M 353 267 V 227\n        M 478 267 V 227\n      \"\n    />\n\n    <!-- ==================================================\n         VÁLVULA IZQUIERDA\n         ================================================== -->\n\n    <path\n      class=\"vap-steam vap-valve-connection\"\n      d=\"M 99 60 V 171\"\n    />\n\n    <use\n      href=\"#vap-valve\"\n      transform=\"translate(99 180)\"\n    />\n\n    <!-- ==================================================\n         CÁMARA 1\n         Vapor interrumpido entre y=154 e y=172.\n         ================================================== -->\n\n    <path\n      class=\"vap-steam vap-valve-connection\"\n      d=\"\n        M 207 60 V 154\n        M 207 172 V 267\n        L 217 257\n        L 227 267\n      \"\n    />\n\n    <path\n      class=\"vap-control\"\n      d=\"M 222 163 H 258 V 381\"\n    />\n\n    <circle\n      class=\"vap-control-node\"\n      cx=\"258\" cy=\"381\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#vap-valve\"\n      transform=\"translate(207 163)\"\n    />\n\n    <!-- ==================================================\n         CÁMARA 2\n         ================================================== -->\n\n    <path\n      class=\"vap-steam vap-valve-connection\"\n      d=\"\n        M 333 60 V 154\n        M 333 172 V 267\n        L 343 257\n        L 353 267\n      \"\n    />\n\n    <path\n      class=\"vap-control\"\n      d=\"M 348 163 H 392 V 381\"\n    />\n\n    <circle\n      class=\"vap-control-node\"\n      cx=\"392\" cy=\"381\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#vap-valve\"\n      transform=\"translate(333 163)\"\n    />\n\n    <!-- ==================================================\n         CÁMARA 3\n         ================================================== -->\n\n    <path\n      class=\"vap-steam vap-valve-connection\"\n      d=\"\n        M 458 60 V 154\n        M 458 172 V 267\n        L 468 257\n        L 478 267\n      \"\n    />\n\n    <path\n      class=\"vap-control\"\n      d=\"M 473 163 H 537 V 381\"\n    />\n\n    <circle\n      class=\"vap-control-node\"\n      cx=\"537\" cy=\"381\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#vap-valve\"\n      transform=\"translate(458 163)\"\n    />\n\n    <!-- ==================================================\n         MIRILLAS\n         Delante de las líneas de control.\n         ================================================== -->\n\n    <g>\n      <circle\n        class=\"vap-inspection-window\"\n        cx=\"258\" cy=\"299\"\n        r=\"28.5\"\n      />\n      <circle\n        class=\"vap-inspection-window\"\n        cx=\"382\" cy=\"299\"\n        r=\"28.5\"\n      />\n      <circle\n        class=\"vap-inspection-window\"\n        cx=\"502\" cy=\"299\"\n        r=\"28.5\"\n      />\n    </g>\n\n    <!-- ==================================================\n         BANDA TRANSPORTADORA\n         Contornos continuos.\n         ================================================== -->\n\n    <path\n      class=\"vap-belt-surface\"\n      d=\"\n        M 38 395\n        H 745\n        C 758 395 768 405 768 418\n        C 768 427 764 434 756 438\n        L 685 477\n        H 73\n        L 23 437\n        C 12 428 13 408 25 399\n        Q 31 395 38 395\n        Z\n      \"\n    />\n\n    <path\n      class=\"vap-belt\"\n      d=\"\n        M 38 395 H 745\n        M 756 438 L 685 477 H 73 L 23 437\n      \"\n    />\n\n    <!-- Poleas de entrada y retorno. -->\n    <circle\n      class=\"vap-roller\"\n      cx=\"38\" cy=\"419\"\n      r=\"23\"\n    />\n    <circle\n      class=\"vap-roller\"\n      cx=\"745\" cy=\"418\"\n      r=\"23\"\n    />\n\n    <!-- ==================================================\n         ELEMENTOS V.1 A V.6\n         Sin barras ni anillos interiores.\n         ================================================== -->\n\n    <g>\n      <circle class=\"vap-roller\" cx=\"236\" cy=\"434\" r=\"19\"/>\n      <circle class=\"vap-roller\" cx=\"296\" cy=\"434\" r=\"19\"/>\n      <circle class=\"vap-roller\" cx=\"386\" cy=\"434\" r=\"19\"/>\n      <circle class=\"vap-roller\" cx=\"504\" cy=\"434\" r=\"19\"/>\n      <circle class=\"vap-roller\" cx=\"616\" cy=\"434\" r=\"19\"/>\n      <circle class=\"vap-roller\" cx=\"681\" cy=\"434\" r=\"19\"/>\n    </g>\n\n    <!-- ==================================================\n         ACCIONAMIENTO EXTERIOR DE LA BANDA\n         ================================================== -->\n\n    <g>\n      <path\n        class=\"vap-drive-shaft\"\n        d=\"M 78 419 H 106\"\n      />\n\n      <rect\n        class=\"vap-metal-part\"\n        x=\"39\" y=\"413\"\n        width=\"39\" height=\"12\"\n        rx=\"1.5\" ry=\"1.5\"\n      />\n\n      <rect\n        class=\"vap-metal-part\"\n        x=\"106\" y=\"413\"\n        width=\"39\" height=\"12\"\n        rx=\"1\" ry=\"1\"\n      />\n\n      <path\n        class=\"vap-drive-detail\"\n        d=\"\n          M 109 417 H 142\n          M 109 421 H 142\n        \"\n      />\n    </g>\n\n    <!-- ==================================================\n         TEXTOS\n         ================================================== -->\n\n    <g>\n      <text\n        class=\"vap-condensate-label\"\n        x=\"7\" y=\"20\"\n      >Condensado</text>\n\n      <text\n        class=\"vap-steam-label\"\n        x=\"7\" y=\"50\"\n      >Vapor 15 bar</text>\n\n      <text class=\"vap-label\" x=\"70\" y=\"450\">\n        <tspan x=\"70\" dy=\"0\">Banda</tspan>\n        <tspan x=\"70\" dy=\"16\">Transportadora</tspan>\n      </text>\n\n      <text class=\"vap-label\" x=\"689\" y=\"349\">\n        <tspan x=\"689\" dy=\"0\">Desmenuzador</tspan>\n        <tspan x=\"689\" dy=\"16\">de Fibra</tspan>\n      </text>\n\n      <text class=\"vap-unit-label\" x=\"236\" y=\"469\">V.1</text>\n      <text class=\"vap-unit-label\" x=\"296\" y=\"469\">V.2</text>\n      <text class=\"vap-unit-label\" x=\"386\" y=\"469\">V.3</text>\n      <text class=\"vap-unit-label\" x=\"504\" y=\"469\">V.4</text>\n      <text class=\"vap-unit-label\" x=\"616\" y=\"469\">V.5</text>\n      <text class=\"vap-unit-label\" x=\"681\" y=\"469\">V.6</text>\n\n      <text\n        class=\"vap-footer\"\n        x=\"855\" y=\"599\"\n      >Vaporizador - Línea #4</text>\n    </g>\n  </svg>\n</div>",
  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.vap-widget {\n  --vap-metal: #D7D8DB;\n  --vap-outline: #4E4E4E;\n  --vap-fiber: #0A638F;\n  --vap-steam: #930606;\n  --vap-condensate: #4E4E4E;\n  --vap-control: #01524F;\n  --vap-valve: #0E0E55;\n  --vap-text: #000000;\n\n  display: grid;\n  place-items: center;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  background: transparent;\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  pointer-events: none;\n}\n\n.vap-widget,\n.vap-widget * {\n  box-sizing: border-box;\n  animation: none !important;\n  transition: none !important;\n}\n\n.vap-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.vap-metal-stop {\n  stop-color: var(--vap-metal);\n}\n\n/* Carcasa y componentes metálicos. */\n\n.vap-equipment-shadow {\n  filter: url(\"#vap-equipment-shadow\");\n}\n\n.vap-shell {\n  fill: url(\"#vap-shell-metal\");\n  stroke: var(--vap-outline);\n  stroke-width: 1.8;\n  stroke-linejoin: round;\n}\n\n.vap-metal-part {\n  fill: url(\"#vap-part-metal\");\n  stroke: var(--vap-outline);\n  stroke-width: 1.6;\n  stroke-linejoin: round;\n  stroke-linecap: round;\n}\n\n.vap-metal-side {\n  fill: url(\"#vap-side-metal\");\n  stroke: var(--vap-outline);\n  stroke-width: 1.6;\n  stroke-linejoin: round;\n}\n\n.vap-seam {\n  fill: none;\n  stroke: var(--vap-outline);\n  stroke-width: 1;\n  stroke-linecap: butt;\n}\n\n.vap-highlight {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 0.8;\n  stroke-linecap: round;\n  opacity: 0.48;\n}\n\n.vap-bottom-shade {\n  fill: none;\n  stroke: #555D69;\n  stroke-width: 0.8;\n  stroke-linecap: round;\n  opacity: 0.22;\n}\n\n/* Trama técnica discreta del conducto. */\n\n.vap-duct-texture {\n  fill: url(\"#vap-hatching\");\n  stroke: none;\n}\n\n.vap-hatch-line {\n  fill: none;\n  stroke: var(--vap-outline);\n  stroke-width: 0.6;\n  opacity: 0.16;\n}\n\n/* Líneas de proceso y control. */\n\n.vap-steam,\n.vap-condensate,\n.vap-control {\n  fill: none;\n  stroke-width: 1.6;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.vap-steam {\n  stroke: var(--vap-steam);\n}\n\n.vap-condensate {\n  stroke: var(--vap-condensate);\n}\n\n.vap-control {\n  stroke: var(--vap-control);\n}\n\n.vap-main {\n  stroke-width: 2;\n}\n\n.vap-valve-connection {\n  stroke-linecap: butt;\n}\n\n.vap-control-node {\n  fill: var(--vap-control);\n  stroke: none;\n}\n\n/* Válvulas transparentes. */\n\n.vap-valve-body {\n  fill: none;\n  stroke: var(--vap-valve);\n  stroke-width: 1.4;\n  stroke-linejoin: round;\n  stroke-linecap: round;\n}\n\n.vap-valve-stem {\n  fill: none;\n  stroke: var(--vap-valve);\n  stroke-width: 0.7;\n  stroke-linecap: butt;\n}\n\n.vap-valve-actuator {\n  fill: var(--vap-valve);\n  stroke: var(--vap-valve);\n  stroke-width: 1;\n}\n\n/* Mirillas de las cámaras. */\n\n.vap-inspection-window {\n  fill: url(\"#vap-window-metal\");\n  stroke: var(--vap-outline);\n  stroke-width: 1.2;\n  filter: url(\"#vap-contact-shadow\");\n}\n\n/* Banda transportadora. */\n\n.vap-belt-surface {\n  fill: #FFFFFF;\n  fill-opacity: 0.07;\n  stroke: none;\n}\n\n.vap-belt {\n  fill: none;\n  stroke: var(--vap-fiber);\n  stroke-width: 1.8;\n  stroke-linejoin: round;\n  stroke-linecap: round;\n  stroke-dasharray: none;\n}\n\n/* Elementos circulares sin barras interiores. */\n\n.vap-roller {\n  fill: url(\"#vap-roller-metal\");\n  stroke: var(--vap-outline);\n  stroke-width: 2.2;\n  filter: url(\"#vap-contact-shadow\");\n}\n\n/* Accionamiento exterior de la banda. */\n\n.vap-drive-shaft {\n  fill: none;\n  stroke: var(--vap-outline);\n  stroke-width: 1.6;\n  stroke-linecap: round;\n}\n\n.vap-drive-detail {\n  fill: none;\n  stroke: var(--vap-outline);\n  stroke-width: 0.8;\n  stroke-linecap: round;\n}\n\n/* Textos. */\n\n.vap-label,\n.vap-unit-label {\n  fill: var(--vap-text);\n  stroke: none;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.vap-unit-label {\n  text-anchor: middle;\n}\n\n.vap-steam-label,\n.vap-condensate-label {\n  stroke: none;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.vap-steam-label {\n  fill: var(--vap-steam);\n}\n\n.vap-condensate-label {\n  fill: var(--vap-condensate);\n}\n\n.vap-footer {\n  fill: var(--vap-text);\n  stroke: none;\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
