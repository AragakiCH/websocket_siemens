{
  "kind": "l4_4_lava_secc_4",
  "nombre": "L4 4 LAVA SECC 4",
  "html": "<div class=\"ls4-widget\">\n  <svg\n    class=\"ls4-svg\"\n    viewBox=\"0 0 860 640\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Lavado sección 4. Preparación, Lavadora Línea número 3\"\n  >\n    <defs>\n\n      <!-- Metal satinado de poleas -->\n\n      <linearGradient\n        id=\"ls4-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"ls4-metal-stop\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"ls4-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Metal satinado de cubas -->\n\n      <linearGradient\n        id=\"ls4-tank-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#ECEEF0\" />\n        <stop offset=\"16%\" stop-color=\"#E2E4E7\" />\n        <stop offset=\"46%\" class=\"ls4-metal-stop\" />\n        <stop offset=\"62%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"84%\" class=\"ls4-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C6C8CD\" />\n      </linearGradient>\n\n      <!-- Franja inferior azul -->\n\n      <linearGradient\n        id=\"ls4-liquid-gradient\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#B4DCEF\" />\n        <stop offset=\"35%\" class=\"ls4-liquid-stop\" />\n        <stop offset=\"75%\" class=\"ls4-liquid-stop\" />\n        <stop offset=\"100%\" stop-color=\"#92C3DE\" />\n      </linearGradient>\n\n      <!-- Sombra de poleas -->\n\n      <filter\n        id=\"ls4-roller-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!-- Sombra de cubas -->\n\n      <filter\n        id=\"ls4-tank-shadow\"\n        x=\"-5%\" y=\"-30%\"\n        width=\"110%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"2\"\n          result=\"tankAmbientBlur\"\n        />\n        <feOffset\n          in=\"tankAmbientBlur\"\n          dx=\"0\" dy=\"2.5\"\n          result=\"tankAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.10\"\n          result=\"tankAmbientColor\"\n        />\n        <feComposite\n          in=\"tankAmbientColor\"\n          in2=\"tankAmbientOffset\"\n          operator=\"in\"\n          result=\"tankAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.5\"\n          result=\"tankContactBlur\"\n        />\n        <feOffset\n          in=\"tankContactBlur\"\n          dx=\"0\" dy=\"0.8\"\n          result=\"tankContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.15\"\n          result=\"tankContactColor\"\n        />\n        <feComposite\n          in=\"tankContactColor\"\n          in2=\"tankContactOffset\"\n          operator=\"in\"\n          result=\"tankContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"tankAmbientShadow\" />\n          <feMergeNode in=\"tankContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!-- Polea principal -->\n\n      <ellipse\n        id=\"ls4-roller\"\n        class=\"ls4-roller\"\n        cx=\"0\" cy=\"0\"\n        rx=\"19.5\" ry=\"20.5\"\n      />\n\n      <!--\n        Válvula vertical.\n        Extremos de conexión: y=-9 y y=9.\n        Actuador ovalado: rx=1.5, ry=6.5.\n      -->\n\n      <g id=\"ls4-valve\">\n        <path\n          class=\"ls4-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n        <path\n          class=\"ls4-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n\n        <line\n          class=\"ls4-valve-link\"\n          x1=\"0\" y1=\"0\"\n          x2=\"13\" y2=\"0\"\n        />\n\n        <ellipse\n          class=\"ls4-valve-actuator\"\n          cx=\"13\" cy=\"0\"\n          rx=\"1.5\" ry=\"6.5\"\n        />\n      </g>\n\n    </defs>\n\n    <!-- ==================================================\n         CUBAS\n         Franja inferior con margen de 4 unidades SVG.\n         ================================================== -->\n\n    <g class=\"ls4-tank-group\">\n      <rect\n        class=\"ls4-tank-shell\"\n        x=\"69\" y=\"93\"\n        width=\"623\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n\n      <rect\n        class=\"ls4-tank-liquid\"\n        x=\"73\" y=\"111\"\n        width=\"615\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path class=\"ls4-highlight\" d=\"M 76 95 H 685\" />\n      <path class=\"ls4-edge-shade\" d=\"M 76 127 H 685\" />\n    </g>\n\n    <g class=\"ls4-tank-group\">\n      <rect\n        class=\"ls4-tank-shell\"\n        x=\"30\" y=\"225\"\n        width=\"742\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n\n      <rect\n        class=\"ls4-tank-liquid\"\n        x=\"34\" y=\"243\"\n        width=\"734\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path class=\"ls4-highlight\" d=\"M 37 227 H 765\" />\n      <path class=\"ls4-edge-shade\" d=\"M 37 259 H 765\" />\n    </g>\n\n    <g class=\"ls4-tank-group\">\n      <rect\n        class=\"ls4-tank-shell\"\n        x=\"30\" y=\"358\"\n        width=\"743\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n\n      <rect\n        class=\"ls4-tank-liquid\"\n        x=\"34\" y=\"376\"\n        width=\"735\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n\n      <path class=\"ls4-highlight\" d=\"M 37 360 H 766\" />\n      <path class=\"ls4-edge-shade\" d=\"M 37 392 H 766\" />\n    </g>\n\n    <!-- ==================================================\n         COLECTORES PRINCIPALES\n         ================================================== -->\n\n    <path\n      class=\"ls4-steam ls4-main\"\n      d=\"M 0 553 H 837\"\n    />\n\n    <path\n      class=\"ls4-condensate ls4-main\"\n      d=\"M 0 594 H 838\"\n    />\n\n    <!-- ==================================================\n         COLUMNAS DE VAPOR\n         Se omiten los tramos ocultos detrás de las cubas.\n         ================================================== -->\n\n    <g class=\"ls4-steam\">\n      <path\n        d=\"\n          M 98 553\n          V 394\n          M 98 358\n          V 261\n          M 98 225\n          V 175\n          H 134\n          V 164\n        \"\n      />\n\n      <path\n        d=\"\n          M 459 553\n          V 394\n          M 459 358\n          V 261\n          M 459 225\n          V 176\n          H 495\n          V 165\n        \"\n      />\n    </g>\n\n    <!-- ==================================================\n         COLUMNAS DE CONDENSADO\n         Se conservan las terminaciones de la referencia.\n         ================================================== -->\n\n    <g class=\"ls4-condensate\">\n      <path\n        d=\"\n          M 91 594\n          V 394\n          M 91 358\n          V 261\n          M 91 225\n          V 158\n          H 115\n          V 114\n        \"\n      />\n\n      <path\n        d=\"\n          M 451 553\n          V 394\n          M 451 358\n          V 261\n          M 451 225\n          V 158\n          H 476\n          V 115\n        \"\n      />\n    </g>\n\n    <!-- ==================================================\n         CUBA 5\n         ================================================== -->\n\n    <path\n      class=\"ls4-steam ls4-heater\"\n      d=\"\n        M 115 114\n        L 125 124\n        L 134 114\n        V 146\n      \"\n    />\n\n    <path\n      class=\"ls4-control\"\n      d=\"M 200 121 V 155 H 149\"\n    />\n\n    <circle\n      class=\"ls4-control-node\"\n      cx=\"200\" cy=\"121\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls4-valve\"\n      transform=\"translate(134 155)\"\n    />\n\n    <!-- ==================================================\n         CUBA 6\n         ================================================== -->\n\n    <path\n      class=\"ls4-steam ls4-heater\"\n      d=\"\n        M 476 115\n        L 485 125\n        L 495 115\n        V 147\n      \"\n    />\n\n    <path\n      class=\"ls4-control\"\n      d=\"M 560 121 V 156 H 510\"\n    />\n\n    <circle\n      class=\"ls4-control-node\"\n      cx=\"560\" cy=\"121\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls4-valve\"\n      transform=\"translate(495 156)\"\n    />\n\n    <!-- ==================================================\n         CUBA 8\n         ================================================== -->\n\n    <path\n      class=\"ls4-condensate\"\n      d=\"M 91 292 H 116 V 247\"\n    />\n\n    <path\n      class=\"ls4-steam ls4-heater\"\n      d=\"\n        M 116 247\n        L 126 257\n        L 135 247\n        V 279\n      \"\n    />\n\n    <path\n      class=\"ls4-steam\"\n      d=\"M 135 297 V 309 H 98\"\n    />\n\n    <path\n      class=\"ls4-control\"\n      d=\"M 200 253 V 288 H 150\"\n    />\n\n    <circle\n      class=\"ls4-control-node\"\n      cx=\"200\" cy=\"253\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls4-valve\"\n      transform=\"translate(135 288)\"\n    />\n\n    <!-- ==================================================\n         CUBA 7\n         ================================================== -->\n\n    <path\n      class=\"ls4-condensate\"\n      d=\"M 451 293 H 477 V 248\"\n    />\n\n    <path\n      class=\"ls4-steam ls4-heater\"\n      d=\"\n        M 477 248\n        L 487 258\n        L 496 248\n        V 280\n      \"\n    />\n\n    <path\n      class=\"ls4-steam\"\n      d=\"M 496 298 V 310 H 459\"\n    />\n\n    <path\n      class=\"ls4-control\"\n      d=\"M 560 253 V 289 H 511\"\n    />\n\n    <circle\n      class=\"ls4-control-node\"\n      cx=\"560\" cy=\"253\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls4-valve\"\n      transform=\"translate(496 289)\"\n    />\n\n    <!-- ==================================================\n         CUBA DE PREPARACIÓN\n         ================================================== -->\n\n    <path\n      class=\"ls4-condensate\"\n      d=\"M 451 423 H 476 V 378\"\n    />\n\n    <path\n      class=\"ls4-steam ls4-heater\"\n      d=\"\n        M 476 378\n        L 486 388\n        L 495 378\n        V 410\n      \"\n    />\n\n    <path\n      class=\"ls4-steam\"\n      d=\"M 495 428 V 440 H 459\"\n    />\n\n    <path\n      class=\"ls4-control\"\n      d=\"M 560 386 V 419 H 510\"\n    />\n\n    <circle\n      class=\"ls4-control-node\"\n      cx=\"560\" cy=\"386\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls4-valve\"\n      transform=\"translate(495 419)\"\n    />\n\n    <!-- ==================================================\n         CUERDA SUPERIOR Y CENTRAL\n         Recorrido continuo por la polea elevada y la 34.\n         ================================================== -->\n\n    <path\n      class=\"ls4-fiber\"\n      d=\"\n        M 0 105\n        H 281.5\n        A 19.5 20.5 0 0 0 297.969 95.477\n        L 335.031 34.023\n        A 19.5 20.5 0 0 1 368.603 35.153\n        L 398.397 92.347\n        A 19.5 20.5 0 0 0 415.500 103.000\n        L 646.500 103.000\n        A 19.5 20.5 0 0 0 665.512 87.057\n        L 676.488 36.443\n        A 19.5 20.5 0 0 1 714.151 35.017\n        L 765.205 210.912\n        A 21 20.5 0 0 1 725.300 223.601\n        L 704.620 168.925\n        A 19.5 20.5 0 0 0 667.965 170.131\n        L 652.035 221.369\n        A 19.5 20.5 0 0 1 633.586 235.500\n        L 417.586 236.500\n        A 19.5 20.5 0 0 1 400.326 225.710\n        L 369.674 165.790\n        A 19.5 20.5 0 0 0 335.882 164.774\n        L 299.118 227.726\n        A 19.5 20.5 0 0 1 282.500 237.500\n        H 2\n      \"\n    />\n\n    <!-- ==================================================\n         CUERDA INFERIOR\n         Incluye la polea pequeña 80 y la salida por la 82.\n         ================================================== -->\n\n    <path\n      class=\"ls4-fiber\"\n      d=\"\n        M 0 368\n        H 283.5\n        A 19.5 20.5 0 0 0 299.969 358.477\n        L 337.031 297.023\n        A 19.5 20.5 0 0 1 370.603 298.153\n        L 400.397 355.347\n        A 19.5 20.5 0 0 0 417.414 366.000\n        L 633.414 367.000\n        A 19.5 20.5 0 0 0 650.998886 355.545852\n        L 677.001114 299.954148\n        A 19.5 20.5 0 0 1 712.841110 302.038188\n        L 730.158890 352.461812\n        A 19.5 20.5 0 0 0 767.155 351.468\n        L 810.845 200.532\n        A 19.5 20.5 0 0 1 828.898 186.010\n        L 860 185\n      \"\n    />\n\n    <!-- ==================================================\n         POLEAS SOBRE LA CUERDA\n         El cuerpo opaco oculta los tramos de contacto.\n         ================================================== -->\n\n    <g aria-label=\"Poleas superiores\">\n      <use href=\"#ls4-roller\" transform=\"translate(281.5 84.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(351.5 45)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(415.5 82.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(646.5 82.5)\" />\n\n      <!-- Sin número visible en la imagen -->\n      <use href=\"#ls4-roller\" transform=\"translate(695.5 41)\" />\n    </g>\n\n    <g aria-label=\"Poleas centrales\">\n      <ellipse\n        class=\"ls4-roller\"\n        cx=\"745\" cy=\"216.5\"\n        rx=\"21\" ry=\"20.5\"\n      />\n\n      <use href=\"#ls4-roller\" transform=\"translate(686.5 176.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(633.5 215)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(417.5 216)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(352.5 175.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(282.5 217)\" />\n    </g>\n\n    <g aria-label=\"Poleas inferiores y de salida\">\n      <use href=\"#ls4-roller\" transform=\"translate(283.5 347.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(353.5 308)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(417.5 345.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(633.5 346.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(694.5 309)\" />\n\n      <circle\n        class=\"ls4-roller\"\n        cx=\"663.866844\"\n        cy=\"293.810780\"\n        r=\"14.5\"\n      />\n\n      <use href=\"#ls4-roller\" transform=\"translate(748.5 345.5)\" />\n      <use href=\"#ls4-roller\" transform=\"translate(829.5 206.5)\" />\n    </g>\n\n    <!-- ==================================================\n         NUMERACIÓN CENTRADA A 13 PX\n         ================================================== -->\n\n    <g class=\"ls4-number\">\n\n      <!-- Poleas superiores -->\n\n      <text x=\"281.5\" y=\"84.5\">28</text>\n      <text x=\"351.5\" y=\"45\">29</text>\n      <text x=\"415.5\" y=\"82.5\">30</text>\n      <text x=\"646.5\" y=\"82.5\">31</text>\n\n      <!-- Poleas centrales -->\n\n      <text x=\"745\" y=\"216.5\">34</text>\n      <text x=\"686.5\" y=\"176.5\">35</text>\n      <text x=\"633.5\" y=\"215\">36</text>\n      <text x=\"417.5\" y=\"216\">37</text>\n      <text x=\"352.5\" y=\"175.5\">38</text>\n      <text x=\"282.5\" y=\"217\">39</text>\n\n      <!-- Poleas inferiores -->\n\n      <text x=\"283.5\" y=\"347.5\">75</text>\n      <text x=\"353.5\" y=\"308\">76</text>\n      <text x=\"417.5\" y=\"345.5\">77</text>\n      <text x=\"633.5\" y=\"346.5\">78</text>\n      <text x=\"694.5\" y=\"309\">79</text>\n      <text x=\"663.866844\" y=\"293.810780\">80</text>\n      <text x=\"748.5\" y=\"345.5\">81</text>\n      <text x=\"829.5\" y=\"206.5\">82</text>\n\n    </g>\n\n    <!-- ==================================================\n         TEXTOS\n         ================================================== -->\n\n    <g class=\"ls4-tank-label\">\n      <text x=\"224\" y=\"146\">CUBA 5</text>\n      <text x=\"583\" y=\"146\">CUBA 6</text>\n\n      <text x=\"224\" y=\"280\">CUBA 8</text>\n      <text x=\"583\" y=\"280\">CUBA 7</text>\n\n      <text x=\"583\" y=\"410\">CUBA DE PREPARACION</text>\n    </g>\n\n    <text class=\"ls4-steam-label\" x=\"5\" y=\"546\">\n      Vapor 15 bar\n    </text>\n\n    <text class=\"ls4-condensate-label\" x=\"5\" y=\"587\">\n      Condensado\n    </text>\n\n    <text class=\"ls4-footer\" x=\"839\" y=\"628\">\n      Preparación - Lavadora Línea #4\n    </text>\n\n  </svg>\n</div>",
  "css": ":root {\n  --ls4-font: \"Segoe UI\", Arial, sans-serif;\n  --ls4-number-font: \"IBM Plex Mono\", Consolas, monospace;\n\n  --ls4-metal: #D7D8DB;\n  --ls4-outline: #4E4E4E;\n  --ls4-liquid: #A0CFE9;\n\n  --ls4-fiber: #0A638F;\n  --ls4-steam: #930606;\n  --ls4-condensate: #4E4E4E;\n  --ls4-control: #01524F;\n  --ls4-valve: #0E0E55;\n  --ls4-text: #000000;\n\n  --ls4-roller-width: 2.2px;\n  --ls4-fiber-width: 1.8px;\n  --ls4-process-width: 1.6px;\n  --ls4-main-width: 2px;\n  --ls4-valve-width: 1.4px;\n}\n\n/* Entorno transparente */\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ls4-widget {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  font-family: var(--ls4-font);\n  pointer-events: none;\n}\n\n.ls4-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.ls4-widget,\n.ls4-widget * {\n  animation: none !important;\n  transition: none !important;\n}\n\n/* Acabados */\n\n.ls4-metal-stop {\n  stop-color: var(--ls4-metal);\n}\n\n.ls4-liquid-stop {\n  stop-color: var(--ls4-liquid);\n}\n\n/* Cubas */\n\n.ls4-tank-group {\n  filter: url(\"#ls4-tank-shadow\");\n}\n\n.ls4-tank-shell {\n  fill: url(\"#ls4-tank-metal\");\n  stroke: var(--ls4-outline);\n  stroke-width: 1.8px;\n  stroke-linejoin: round;\n}\n\n.ls4-tank-liquid {\n  fill: url(\"#ls4-liquid-gradient\");\n  stroke: none;\n}\n\n.ls4-highlight {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  opacity: 0.48;\n}\n\n.ls4-edge-shade {\n  fill: none;\n  stroke: #555D69;\n  stroke-width: 0.65px;\n  stroke-linecap: round;\n  opacity: 0.16;\n}\n\n/* Poleas: sin anillo interior */\n\n.ls4-roller {\n  fill: url(\"#ls4-roller-metal\");\n  stroke: var(--ls4-outline);\n  stroke-width: var(--ls4-roller-width);\n  filter: url(\"#ls4-roller-shadow\");\n}\n\n/* Cuerda */\n\n.ls4-fiber {\n  fill: none;\n  stroke: var(--ls4-fiber);\n  stroke-width: var(--ls4-fiber-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Tuberías */\n\n.ls4-steam,\n.ls4-condensate,\n.ls4-control {\n  fill: none;\n  stroke-width: var(--ls4-process-width);\n  stroke-linecap: butt;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ls4-steam {\n  stroke: var(--ls4-steam);\n}\n\n.ls4-condensate {\n  stroke: var(--ls4-condensate);\n}\n\n.ls4-control {\n  stroke: var(--ls4-control);\n}\n\n.ls4-control-node {\n  fill: var(--ls4-control);\n  stroke: var(--ls4-control);\n  stroke-width: 1px;\n}\n\n.ls4-main {\n  stroke-width: var(--ls4-main-width);\n  stroke-linecap: round;\n}\n\n.ls4-heater {\n  stroke-linecap: round;\n}\n\n/* Válvulas transparentes */\n\n.ls4-valve-body {\n  fill: none;\n  stroke: var(--ls4-valve);\n  stroke-width: var(--ls4-valve-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ls4-valve-link {\n  fill: none;\n  stroke: var(--ls4-valve);\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n}\n\n.ls4-valve-actuator {\n  fill: var(--ls4-valve);\n  stroke: var(--ls4-valve);\n  stroke-width: 1px;\n}\n\n/* Numeración uniforme */\n\n.ls4-number {\n  fill: var(--ls4-text);\n  font-family: var(--ls4-number-font);\n  font-size: 13px;\n  font-weight: 700;\n  text-anchor: middle;\n  dominant-baseline: middle;\n  pointer-events: none;\n}\n\n/* Textos */\n\n.ls4-tank-label {\n  fill: var(--ls4-text);\n  font-family: var(--ls4-font);\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.ls4-steam-label {\n  fill: var(--ls4-steam);\n  font-family: var(--ls4-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls4-condensate-label {\n  fill: var(--ls4-condensate);\n  font-family: var(--ls4-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls4-footer {\n  fill: var(--ls4-text);\n  font-family: var(--ls4-font);\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
  "js": "\"use strict\";\n\n/*\n * LAVADO SECC. 4\n * Preparación — Lavadora Línea #3.\n *\n * Widget gráfico estático.\n *\n * La cuerda utiliza segmentos tangentes y arcos\n * coincidentes con las superficies de las poleas.\n *\n * Las poleas se dibujan después de la cuerda para\n * ocultar los tramos de contacto.\n *\n * Numeración centrada, negra y uniforme a 13 px.\n *\n * Válvulas transparentes con actuadores ovalados\n * y uniones horizontales de 0.7 px.\n *\n * No utiliza tags, variables del PLC, temporizadores,\n * animaciones ni recursos externos.\n */",
