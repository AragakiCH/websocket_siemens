{
  "kind": "l5_2_lava_secc_2",
  "nombre": "L5 2 LAVA SECC 2",
  "html": "<div class=\"ls52-widget\">\n  <svg\n    class=\"ls52-svg\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    viewBox=\"0 0 929 627\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    role=\"img\"\n    aria-label=\"Estiramiento Lavadora Línea 5\"\n  >\n    <defs>\n      <!-- Acabado satinado de las poleas. -->\n      <linearGradient\n        id=\"ls52-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\"/>\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"43%\" class=\"ls52-metal-stop\"/>\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\"/>\n        <stop offset=\"74%\" class=\"ls52-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\"/>\n      </linearGradient>\n\n      <!-- Acabado metálico de las cubas. -->\n      <linearGradient\n        id=\"ls52-tank-metal\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#ECEEF0\"/>\n        <stop offset=\"16%\" stop-color=\"#E2E4E7\"/>\n        <stop offset=\"46%\" class=\"ls52-metal-stop\"/>\n        <stop offset=\"62%\" stop-color=\"#E2E3E6\"/>\n        <stop offset=\"84%\" class=\"ls52-metal-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#C6C8CD\"/>\n      </linearGradient>\n\n      <!-- Franja azul inferior. -->\n      <linearGradient\n        id=\"ls52-liquid-gradient\"\n        x1=\"0%\" y1=\"0%\"\n        x2=\"0%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#B4DCEF\"/>\n        <stop offset=\"35%\" class=\"ls52-liquid-stop\"/>\n        <stop offset=\"75%\" class=\"ls52-liquid-stop\"/>\n        <stop offset=\"100%\" stop-color=\"#92C3DE\"/>\n      </linearGradient>\n\n      <!-- Sombra ambiental y de contacto de las poleas. -->\n      <filter\n        id=\"ls52-roller-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\"/>\n          <feMergeNode in=\"rollerContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!-- Sombra suave de las cubas. -->\n      <filter\n        id=\"ls52-tank-shadow\"\n        x=\"-5%\" y=\"-30%\"\n        width=\"110%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"2\"\n          result=\"tankAmbientBlur\"\n        />\n        <feOffset\n          in=\"tankAmbientBlur\"\n          dx=\"0\" dy=\"2.5\"\n          result=\"tankAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.10\"\n          result=\"tankAmbientColor\"\n        />\n        <feComposite\n          in=\"tankAmbientColor\"\n          in2=\"tankAmbientOffset\"\n          operator=\"in\"\n          result=\"tankAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.5\"\n          result=\"tankContactBlur\"\n        />\n        <feOffset\n          in=\"tankContactBlur\"\n          dx=\"0\" dy=\"0.8\"\n          result=\"tankContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.15\"\n          result=\"tankContactColor\"\n        />\n        <feComposite\n          in=\"tankContactColor\"\n          in2=\"tankContactOffset\"\n          operator=\"in\"\n          result=\"tankContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"tankAmbientShadow\"/>\n          <feMergeNode in=\"tankContactShadow\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n\n      <!--\n        Válvula transparente.\n        Actuador: rx=1.5, ry=6.5.\n        Unión horizontal: 0.7 px.\n      -->\n      <g id=\"ls52-valve\">\n        <path\n          class=\"ls52-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n        <path\n          class=\"ls52-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n        <line\n          class=\"ls52-valve-stem\"\n          x1=\"0\" y1=\"0\"\n          x2=\"13\" y2=\"0\"\n        />\n        <ellipse\n          class=\"ls52-valve-actuator\"\n          cx=\"13\" cy=\"0\"\n          rx=\"1.5\" ry=\"6.5\"\n        />\n      </g>\n    </defs>\n\n    <!-- ==================================================\n         CUBA SUPERIOR\n         Franja azul con margen interior de 4 unidades.\n         ================================================== -->\n\n    <g class=\"ls52-tank\">\n      <rect\n        class=\"ls52-tank-body\"\n        x=\"28\" y=\"84\"\n        width=\"871\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n      <rect\n        class=\"ls52-tank-liquid\"\n        x=\"32\" y=\"102\"\n        width=\"863\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n      <path class=\"ls52-tank-highlight\" d=\"M 35 86 H 892\"/>\n      <path class=\"ls52-tank-shade\" d=\"M 35 118 H 892\"/>\n    </g>\n\n    <!-- ==================================================\n         CUBA INTERMEDIA\n         ================================================== -->\n\n    <g class=\"ls52-tank\">\n      <rect\n        class=\"ls52-tank-body\"\n        x=\"29\" y=\"213\"\n        width=\"870\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n      <rect\n        class=\"ls52-tank-liquid\"\n        x=\"33\" y=\"231\"\n        width=\"862\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n      <path class=\"ls52-tank-highlight\" d=\"M 36 215 H 892\"/>\n      <path class=\"ls52-tank-shade\" d=\"M 36 247 H 892\"/>\n    </g>\n\n    <!-- ==================================================\n         CUBA DE ESTIRAMIENTO\n         ================================================== -->\n\n    <g class=\"ls52-tank\">\n      <rect\n        class=\"ls52-tank-body\"\n        x=\"29\" y=\"348\"\n        width=\"870\" height=\"36\"\n        rx=\"6\" ry=\"6\"\n      />\n      <rect\n        class=\"ls52-tank-liquid\"\n        x=\"33\" y=\"366\"\n        width=\"862\" height=\"14\"\n        rx=\"2\" ry=\"2\"\n      />\n      <path class=\"ls52-tank-highlight\" d=\"M 36 350 H 892\"/>\n      <path class=\"ls52-tank-shade\" d=\"M 36 382 H 892\"/>\n    </g>\n\n    <!-- ==================================================\n         COLECTORES PRINCIPALES\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-main\"\n      d=\"M 0 545 H 929\"\n    />\n\n    <path\n      class=\"ls52-condensate ls52-main\"\n      d=\"M 0 586 H 929\"\n    />\n\n    <!-- ==================================================\n         MONTANTES IZQUIERDOS\n         Tramos ocultos detrás de las cubas.\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 58 545 V 384\n        M 58 348 V 249\n        M 58 213 V 155\n      \"\n    />\n\n    <path\n      class=\"ls52-condensate\"\n      d=\"\n        M 39 586 V 384\n        M 39 348 V 249\n        M 39 213 V 138\n      \"\n    />\n\n    <!-- ==================================================\n         MONTANTES CENTRALES\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 338 545 V 384\n        M 338 348 V 249\n        M 338 213 V 183 H 374 V 156\n      \"\n    />\n\n    <path\n      class=\"ls52-condensate\"\n      d=\"\n        M 330 586 V 384\n        M 330 348 V 249\n        M 330 213 V 164 H 355 V 138\n      \"\n    />\n\n    <!-- ==================================================\n         MONTANTES DERECHOS\n         Retorno conectado al colector de condensado.\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 769 545 V 384\n        M 769 348 V 249\n        M 769 213 V 182 H 805 V 154\n      \"\n    />\n\n    <path\n      class=\"ls52-condensate\"\n      d=\"\n        M 762 586 V 384\n        M 762 348 V 249\n        M 762 213 V 161 H 786 V 138\n      \"\n    />\n\n    <!-- ==================================================\n         CUBA 3\n         Salida roja de 28 unidades SVG.\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 39 138 V 110\n        L 49 120\n        L 58 110\n        V 137\n      \"\n    />\n\n    <path\n      class=\"ls52-control\"\n      d=\"M 105 110 V 146 H 73\"\n    />\n\n    <circle\n      class=\"ls52-control-node\"\n      cx=\"105\" cy=\"110\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls52-valve\"\n      transform=\"translate(58 146)\"\n    />\n\n    <!-- ==================================================\n         CUBA 4\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 355 138 V 110\n        L 365 120\n        L 374 110\n        V 138\n      \"\n    />\n\n    <path\n      class=\"ls52-control\"\n      d=\"M 448 113 V 147 H 389\"\n    />\n\n    <circle\n      class=\"ls52-control-node\"\n      cx=\"448\" cy=\"113\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls52-valve\"\n      transform=\"translate(374 147)\"\n    />\n\n    <!-- ==================================================\n         CUBA 5\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 786 138 V 110\n        L 796 120\n        L 805 110\n        V 136\n      \"\n    />\n\n    <path\n      class=\"ls52-control\"\n      d=\"M 879 109 V 145 H 820\"\n    />\n\n    <circle\n      class=\"ls52-control-node\"\n      cx=\"879\" cy=\"109\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls52-valve\"\n      transform=\"translate(805 145)\"\n    />\n\n    <!-- ==================================================\n         CUBA 15\n         ================================================== -->\n\n    <path\n      class=\"ls52-condensate\"\n      d=\"M 330 282 H 355 V 266\"\n    />\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 355 266 V 238\n        L 365 248\n        L 374 238\n        V 270\n\n        M 374 288 V 301 H 338\n      \"\n    />\n\n    <path\n      class=\"ls52-control\"\n      d=\"M 448 241 V 279 H 389\"\n    />\n\n    <circle\n      class=\"ls52-control-node\"\n      cx=\"448\" cy=\"241\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls52-valve\"\n      transform=\"translate(374 279)\"\n    />\n\n    <!-- ==================================================\n         CUBA 14\n         ================================================== -->\n\n    <path\n      class=\"ls52-condensate\"\n      d=\"M 762 281 H 786 V 266\"\n    />\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 786 266 V 238\n        L 796 248\n        L 805 238\n        V 268\n\n        M 805 286 V 298 H 769\n      \"\n    />\n\n    <path\n      class=\"ls52-control\"\n      d=\"M 879 239 V 277 H 820\"\n    />\n\n    <circle\n      class=\"ls52-control-node\"\n      cx=\"879\" cy=\"239\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls52-valve\"\n      transform=\"translate(805 277)\"\n    />\n\n    <!-- ==================================================\n         CUBA DE ESTIRAMIENTO\n         Salidas rojas de 28 unidades SVG.\n         ================================================== -->\n\n    <path\n      class=\"ls52-steam ls52-valve-connection\"\n      d=\"\n        M 338 465 H 356 V 449\n\n        M 356 431 V 374\n        L 366 384\n        L 375 374\n        V 402\n\n        M 356 395 H 787 V 372\n        L 797 382\n        L 806 372\n        V 400\n      \"\n    />\n\n    <path\n      class=\"ls52-condensate\"\n      d=\"\n        M 330 485 H 375 V 402\n        M 375 410 H 806 V 400\n      \"\n    />\n\n    <path\n      class=\"ls52-control\"\n      d=\"M 448 378 V 440 H 371\"\n    />\n\n    <circle\n      class=\"ls52-control-node\"\n      cx=\"448\" cy=\"378\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ls52-valve\"\n      transform=\"translate(356 440)\"\n    />\n\n    <!-- ==================================================\n         CUERDA SUPERIOR\n         Poleas 23 a 28.\n         ================================================== -->\n\n    <path\n      class=\"ls52-fiber\"\n      d=\"\n        M 0 96.500\n        L 145.500 96.500\n        A 19.5 20.5 0 0 0 163.029 84.981\n\n        L 188.971 29.019\n        A 19.5 20.5 0 0 1 223.375 27.727\n\n        L 255.625 86.273\n        A 19.5 20.5 0 0 0 272.500 96.500\n\n        L 563.500 96.500\n        A 19.5 20.5 0 0 0 578.833 88.666\n\n        L 626.167 25.334\n        A 19.5 20.5 0 0 1 656.492 24.891\n\n        L 706.508 88.109\n        A 19.5 20.5 0 0 0 721.500 95.500\n\n        H 929\n      \"\n    />\n\n    <!-- ==================================================\n         CUERDA INTERMEDIA E INFERIOR\n         La tangente entre las poleas 63 y 64 pasa por arriba.\n         ================================================== -->\n\n    <path\n      class=\"ls52-fiber\"\n      d=\"\n        M 929 227.500\n        L 720.500 227.500\n        A 19.5 20.5 0 0 1 706.158 220.890\n\n        L 656.842 164.610\n        A 19.5 20.5 0 0 0 628.532 164.196\n\n        L 577.468 219.304\n        A 19.5 20.5 0 0 1 563.558 225.500\n\n        L 242.558 226.500\n        A 19.5 20.5 0 0 1 225.591 216.210\n\n        L 199.409 168.290\n        A 19.5 20.5 0 0 0 174.254 159.923\n\n        L 121.254 185.923\n        A 19.5 20.5 0 0 0 110.001 204.340\n\n        L 109.001 339.340\n        A 19.5 20.5 0 1 0 147.994 338.981\n\n        L 147.006 298.019\n        A 19.5 20.5 0 1 1 185.994 296.993\n\n        L 187.006 340.007\n        A 19.5 20.5 0 1 0 225.994 338.981\n\n        L 225.006 298.019\n        A 19.5 20.5 0 0 1 263.949 296.017\n\n        L 267.051 340.983\n        A 19.5 20.5 0 0 0 286.500 360.000\n\n        H 929\n      \"\n    />\n\n    <!-- ==================================================\n         POLEAS\n         Borde de 2.2 px y cuerpos sin barras interiores.\n         ================================================== -->\n\n    <g class=\"ls52-rollers\">\n      <!-- Nivel superior. -->\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"145.5\" cy=\"76\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"206.5\" cy=\"38\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"272.5\" cy=\"76\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"563.5\" cy=\"76\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"641.5\" cy=\"38\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"721.5\" cy=\"75\" rx=\"19.5\" ry=\"20.5\"/>\n\n      <!-- Nivel intermedio. -->\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"720.5\" cy=\"207\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"642.5\" cy=\"178.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"563.5\" cy=\"205\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"242.5\" cy=\"206\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"182.5\" cy=\"178.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"129.5\" cy=\"204.5\" rx=\"19.5\" ry=\"20.5\"/>\n\n      <!-- Nivel inferior. -->\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"128.5\" cy=\"339.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"166.5\" cy=\"297.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"206.5\" cy=\"339.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"244.5\" cy=\"297.5\" rx=\"19.5\" ry=\"20.5\"/>\n      <ellipse class=\"ls52-roller-body\"\n        cx=\"286.5\" cy=\"339.5\" rx=\"19.5\" ry=\"20.5\"/>\n    </g>\n\n    <!-- ==================================================\n         NUMERACIÓN CENTRADA\n         ================================================== -->\n\n    <g>\n      <text class=\"ls52-roller-number\" x=\"145.5\" y=\"76\">23</text>\n      <text class=\"ls52-roller-number\" x=\"206.5\" y=\"38\">24</text>\n      <text class=\"ls52-roller-number\" x=\"272.5\" y=\"76\">25</text>\n      <text class=\"ls52-roller-number\" x=\"563.5\" y=\"76\">26</text>\n      <text class=\"ls52-roller-number\" x=\"641.5\" y=\"38\">27</text>\n      <text class=\"ls52-roller-number\" x=\"721.5\" y=\"75\">28</text>\n\n      <text class=\"ls52-roller-number\" x=\"720.5\" y=\"207\">59</text>\n      <text class=\"ls52-roller-number\" x=\"642.5\" y=\"178.5\">60</text>\n      <text class=\"ls52-roller-number\" x=\"563.5\" y=\"205\">61</text>\n      <text class=\"ls52-roller-number\" x=\"242.5\" y=\"206\">62</text>\n      <text class=\"ls52-roller-number\" x=\"182.5\" y=\"178.5\">63</text>\n      <text class=\"ls52-roller-number\" x=\"129.5\" y=\"204.5\">64</text>\n\n      <text class=\"ls52-roller-number\" x=\"128.5\" y=\"339.5\">65</text>\n      <text class=\"ls52-roller-number\" x=\"166.5\" y=\"297.5\">66</text>\n      <text class=\"ls52-roller-number\" x=\"206.5\" y=\"339.5\">67</text>\n      <text class=\"ls52-roller-number\" x=\"244.5\" y=\"297.5\">68</text>\n      <text class=\"ls52-roller-number\" x=\"286.5\" y=\"339.5\">69</text>\n    </g>\n\n    <!-- ==================================================\n         TEXTOS\n         ================================================== -->\n\n    <g>\n      <text class=\"ls52-label\" x=\"131\" y=\"137\">CUBA 3</text>\n      <text class=\"ls52-label\" x=\"477\" y=\"138\">CUBA 4</text>\n      <text class=\"ls52-label\" x=\"813\" y=\"134\">CUBA 5</text>\n\n      <text class=\"ls52-label\" x=\"477\" y=\"270\">CUBA 15</text>\n      <text class=\"ls52-label\" x=\"808\" y=\"263\">CUBA 14</text>\n\n      <text class=\"ls52-label\" x=\"477\" y=\"428\">\n        CUBA DE ESTIRAMIENTO\n      </text>\n\n      <text class=\"ls52-steam-label\" x=\"67\" y=\"539\">\n        Vapor 15 bar\n      </text>\n\n      <text class=\"ls52-condensate-label\" x=\"67\" y=\"581\">\n        Condensado\n      </text>\n\n      <text class=\"ls52-footer\" x=\"883\" y=\"619\">\n        Estiramiento Lavadora Línea #5\n      </text>\n    </g>\n  </svg>\n</div>",
  "css": "html,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ls52-widget {\n  --ls52-metal: #D7D8DB;\n  --ls52-outline: #4E4E4E;\n  --ls52-liquid: #A0CFE9;\n  --ls52-fiber: #0A638F;\n  --ls52-steam: #930606;\n  --ls52-condensate: #4E4E4E;\n  --ls52-control: #01524F;\n  --ls52-valve: #0E0E55;\n  --ls52-text: #000000;\n\n  display: grid;\n  place-items: center;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n\n  background: transparent;\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  pointer-events: none;\n}\n\n.ls52-widget,\n.ls52-widget * {\n  box-sizing: border-box;\n  animation: none !important;\n  transition: none !important;\n}\n\n.ls52-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.ls52-metal-stop {\n  stop-color: var(--ls52-metal);\n}\n\n.ls52-liquid-stop {\n  stop-color: var(--ls52-liquid);\n}\n\n/* Cubas. */\n\n.ls52-tank {\n  filter: url(\"#ls52-tank-shadow\");\n}\n\n.ls52-tank-body {\n  fill: url(\"#ls52-tank-metal\");\n  stroke: var(--ls52-outline);\n  stroke-width: 1.8;\n  stroke-linejoin: round;\n}\n\n.ls52-tank-liquid {\n  fill: url(\"#ls52-liquid-gradient\");\n  stroke: none;\n}\n\n.ls52-tank-highlight {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 0.7;\n  stroke-linecap: round;\n  opacity: 0.48;\n}\n\n.ls52-tank-shade {\n  fill: none;\n  stroke: #555D69;\n  stroke-width: 0.65;\n  stroke-linecap: round;\n  opacity: 0.16;\n}\n\n/* Tuberías. */\n\n.ls52-steam,\n.ls52-condensate,\n.ls52-control {\n  fill: none;\n  stroke-width: 1.6;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ls52-steam {\n  stroke: var(--ls52-steam);\n}\n\n.ls52-condensate {\n  stroke: var(--ls52-condensate);\n}\n\n.ls52-control {\n  stroke: var(--ls52-control);\n}\n\n.ls52-main {\n  stroke-width: 2;\n}\n\n.ls52-valve-connection {\n  stroke-linecap: butt;\n}\n\n.ls52-control-node {\n  fill: var(--ls52-control);\n  stroke: none;\n}\n\n/* Válvulas transparentes. */\n\n.ls52-valve-body {\n  fill: none;\n  stroke: var(--ls52-valve);\n  stroke-width: 1.4;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ls52-valve-stem {\n  fill: none;\n  stroke: var(--ls52-valve);\n  stroke-width: 0.7;\n  stroke-linecap: butt;\n}\n\n.ls52-valve-actuator {\n  fill: var(--ls52-valve);\n  stroke: var(--ls52-valve);\n  stroke-width: 1;\n}\n\n/* Cuerda. */\n\n.ls52-fiber {\n  fill: none;\n  stroke: var(--ls52-fiber);\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Poleas sin barras ni anillos interiores. */\n\n.ls52-roller-body {\n  fill: url(\"#ls52-roller-metal\");\n  stroke: var(--ls52-outline);\n  stroke-width: 2.2;\n  filter: url(\"#ls52-roller-shadow\");\n}\n\n.ls52-roller-number {\n  fill: var(--ls52-text);\n  stroke: none;\n\n  font-family: \"IBM Plex Mono\", Consolas, monospace;\n  font-size: 13px;\n  font-weight: 700;\n\n  text-anchor: middle;\n  dominant-baseline: middle;\n}\n\n/* Textos. */\n\n.ls52-label {\n  fill: var(--ls52-text);\n  stroke: none;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.ls52-steam-label,\n.ls52-condensate-label {\n  stroke: none;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ls52-steam-label {\n  fill: var(--ls52-steam);\n}\n\n.ls52-condensate-label {\n  fill: var(--ls52-condensate);\n}\n\n.ls52-footer {\n  fill: var(--ls52-text);\n  stroke: none;\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
