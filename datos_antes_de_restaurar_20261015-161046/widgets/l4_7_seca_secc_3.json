{
  "kind": "l4_7_seca_secc_3",
  "nombre": "L4 7 SECA SECC 3",
  "html": "<div class=\"ss4-widget\">\n  <svg\n    class=\"ss4-svg\"\n    viewBox=\"0 0 891 567\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Secador sección 4. Zonas 4 y 5, Secador Línea número 3\"\n  >\n    <defs>\n\n      <!-- Metal satinado -->\n\n      <linearGradient\n        id=\"ss4-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"ss4-metal-stop\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"ss4-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Sombra ambiental y de contacto -->\n\n      <filter\n        id=\"ss4-roller-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!-- Polea grande estándar -->\n\n      <ellipse\n        id=\"ss4-roller\"\n        class=\"ss4-roller\"\n        cx=\"0\" cy=\"0\"\n        rx=\"41\" ry=\"43\"\n      />\n\n      <!-- Válvula proporcional vertical -->\n\n      <g id=\"ss4-valve\">\n        <path\n          class=\"ss4-valve-body\"\n          d=\"M -9 -9 H 9 L 0 0 Z\"\n        />\n\n        <path\n          class=\"ss4-valve-body\"\n          d=\"M -9 9 H 9 L 0 0 Z\"\n        />\n\n        <line\n          class=\"ss4-valve-link\"\n          x1=\"0\" y1=\"0\"\n          x2=\"17\" y2=\"0\"\n        />\n\n        <ellipse\n          class=\"ss4-valve-actuator\"\n          cx=\"17\" cy=\"0\"\n          rx=\"1.5\" ry=\"6.5\"\n        />\n      </g>\n\n    </defs>\n\n    <!-- ==================================================\n         ZONA 4: CIRCUITO SUPERIOR DE VAPOR\n         ================================================== -->\n\n    <path\n      class=\"ss4-steam\"\n      d=\"\n        M 101 348\n        V 289\n        L 47 207\n        V 40\n        H 248\n      \"\n    />\n\n    <!-- Calefactor superior izquierdo -->\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 95 40\n        V 18\n        L 106 28\n        L 116 18\n        V 57\n      \"\n    />\n\n    <!-- Calefactor superior derecho -->\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 248 40\n        V 17\n        L 258 27\n        L 268 17\n        V 57\n      \"\n    />\n\n    <!-- Retorno superior de condensado -->\n\n    <path\n      class=\"ss4-condensate\"\n      d=\"\n        M 116 57\n        H 350\n        V 133\n        L 421 233\n        V 520\n      \"\n    />\n\n    <!-- ==================================================\n         ZONA 4: CIRCUITO INFERIOR\n         ================================================== -->\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 101 306\n        H 299\n        V 283\n        L 309 293\n        L 320 283\n        V 323\n      \"\n    />\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 146 306\n        V 285\n        L 156 295\n        L 167 285\n        V 323\n      \"\n    />\n\n    <path\n      class=\"ss4-condensate\"\n      d=\"M 167 323 H 365 V 520\"\n    />\n\n    <!-- Segmento inferior de vapor -->\n\n    <path\n      class=\"ss4-steam\"\n      d=\"M 101 366 V 484\"\n    />\n\n    <!-- Control de Zona 4 -->\n\n    <path\n      class=\"ss4-control\"\n      d=\"M 259 245 V 357 H 120\"\n    />\n\n    <circle\n      class=\"ss4-control-node\"\n      cx=\"259\" cy=\"245\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ss4-valve\"\n      transform=\"translate(101 357)\"\n    />\n\n    <!-- ==================================================\n         ZONA 5: CIRCUITO SUPERIOR IZQUIERDO\n         ================================================== -->\n\n    <path\n      class=\"ss4-steam\"\n      d=\"\n        M 433 352\n        V 229\n        L 386 163\n        V 41\n        H 423\n      \"\n    />\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 423 41\n        V 17\n        L 434 28\n        L 444 17\n        V 56\n      \"\n    />\n\n    <path\n      class=\"ss4-condensate\"\n      d=\"\n        M 444 56\n        H 522\n        V 135\n        L 591 232\n        V 520\n      \"\n    />\n\n    <!-- ==================================================\n         ZONA 5: CIRCUITO INFERIOR IZQUIERDO\n         ================================================== -->\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 433 306\n        H 524\n        V 285\n        L 534 295\n        L 544 285\n        V 323\n      \"\n    />\n\n    <!-- Unión con el retorno vertical -->\n\n    <path\n      class=\"ss4-condensate\"\n      d=\"M 544 323 H 591\"\n    />\n\n    <!-- Segmento inferior de vapor -->\n\n    <path\n      class=\"ss4-steam\"\n      d=\"M 433 370 V 484\"\n    />\n\n    <!-- Control de Zona 5 -->\n\n    <path\n      class=\"ss4-control\"\n      d=\"M 597 246 V 361 H 452\"\n    />\n\n    <circle\n      class=\"ss4-control-node\"\n      cx=\"597\" cy=\"246\"\n      r=\"3.5\"\n    />\n\n    <use\n      href=\"#ss4-valve\"\n      transform=\"translate(433 361)\"\n    />\n\n    <!-- ==================================================\n         ZONA 5: CIRCUITO SUPERIOR DERECHO\n         ================================================== -->\n\n    <path\n      class=\"ss4-steam\"\n      d=\"\n        M 603 484\n        V 229\n        L 555 163\n        V 39\n        H 593\n      \"\n    />\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 593 39\n        V 17\n        L 603 27\n        L 613 17\n        V 56\n      \"\n    />\n\n    <path\n      class=\"ss4-condensate\"\n      d=\"\n        M 613 56\n        H 730\n        V 164\n        L 828 300\n        V 520\n      \"\n    />\n\n    <!-- ==================================================\n         ZONA 5: CIRCUITO INFERIOR DERECHO\n         ================================================== -->\n\n    <path\n      class=\"ss4-steam ss4-heater\"\n      d=\"\n        M 603 304\n        H 693\n        V 283\n        L 703 293\n        L 714 283\n        V 323\n      \"\n    />\n\n    <path\n      class=\"ss4-condensate\"\n      d=\"M 714 323 H 742 V 520\"\n    />\n\n    <!-- ==================================================\n         COLECTORES PRINCIPALES\n         ================================================== -->\n\n    <path\n      class=\"ss4-steam ss4-main\"\n      d=\"M 0 484 H 891\"\n    />\n\n    <path\n      class=\"ss4-condensate ss4-main\"\n      d=\"M 0 520 H 891\"\n    />\n\n    <!-- ==================================================\n         CUERDA\n         Recorrido continuo tangente a las nueve poleas.\n         ================================================== -->\n\n    <path\n      class=\"ss4-fiber\"\n      d=\"\n        M 51 286\n        L 66.363408 165.787523\n        A 41 43 0 0 1 147.993472 170.732730\n        L 149.006528 230.267270\n        A 41 43 0 0 0 230.724375 234.477598\n        L 238.275625 166.522402\n        A 41 43 0 0 1 320.000000 171.500000\n        L 320.000000 229.500000\n        A 42 43 0 0 0 403.797038 233.722223\n        L 410.205372 167.227406\n        A 41.5 43 0 0 1 492.973018 173.050330\n        L 491.027310 228.930789\n        A 41 43 0 0 0 572.576906 236.661502\n        L 582.423094 165.338498\n        A 41 43 0 0 1 663.971676 173.098060\n        L 662.028324 227.901940\n        A 41 43 0 0 0 743.801991 233.720936\n        L 750.063707 167.142268\n        A 14.5 14.5 0 0 1 764.161581 154.003950\n        L 850 152\n      \"\n    />\n\n    <!-- ==================================================\n         POLEAS GRANDES\n         Sin hélices, anillos interiores ni puntos laterales.\n         Se dibujan sobre la cuerda.\n         ================================================== -->\n\n    <g aria-label=\"Poleas grandes del secador\">\n\n      <!-- Polea 15 -->\n      <use\n        href=\"#ss4-roller\"\n        transform=\"translate(107 171.5)\"\n      />\n\n      <!-- Polea 16 -->\n      <use\n        href=\"#ss4-roller\"\n        transform=\"translate(190 229.5)\"\n      />\n\n      <!-- Polea 17 -->\n      <use\n        href=\"#ss4-roller\"\n        transform=\"translate(279 171.5)\"\n      />\n\n      <!-- Polea 18 -->\n      <ellipse\n        class=\"ss4-roller\"\n        cx=\"362\" cy=\"229.5\"\n        rx=\"42\" ry=\"43\"\n      />\n\n      <!-- Polea 19 -->\n      <ellipse\n        class=\"ss4-roller\"\n        cx=\"451.5\" cy=\"171.5\"\n        rx=\"41.5\" ry=\"43\"\n      />\n\n      <!-- Polea 20 -->\n      <use\n        href=\"#ss4-roller\"\n        transform=\"translate(532 230.5)\"\n      />\n\n      <!-- Polea 21 -->\n      <use\n        href=\"#ss4-roller\"\n        transform=\"translate(623 171.5)\"\n      />\n\n      <!-- Polea 22 -->\n      <use\n        href=\"#ss4-roller\"\n        transform=\"translate(703 229.5)\"\n      />\n\n    </g>\n\n    <!-- Polea pequeña de salida: sin número -->\n\n    <circle\n      class=\"ss4-roller\"\n      cx=\"764.5\" cy=\"168.5\"\n      r=\"14.5\"\n    />\n\n    <!-- ==================================================\n         NUMERACIÓN\n         Encima y centrada respecto a cada polea grande.\n         ================================================== -->\n\n    <g class=\"ss4-number\">\n      <text x=\"107\" y=\"120.5\">15</text>\n      <text x=\"190\" y=\"178.5\">16</text>\n      <text x=\"279\" y=\"120.5\">17</text>\n      <text x=\"362\" y=\"178.5\">18</text>\n      <text x=\"451.5\" y=\"120.5\">19</text>\n      <text x=\"532\" y=\"179.5\">20</text>\n      <text x=\"623\" y=\"120.5\">21</text>\n      <text x=\"703\" y=\"178.5\">22</text>\n    </g>\n\n    <!-- ==================================================\n         TEXTOS\n         ================================================== -->\n\n    <text\n      class=\"ss4-steam-label\"\n      x=\"12\" y=\"474\"\n    >\n      Vapor 15 bar\n    </text>\n\n    <text\n      class=\"ss4-condensate-label\"\n      x=\"13\" y=\"510\"\n    >\n      Condensado\n    </text>\n\n    <g class=\"ss4-zone-label\">\n      <text x=\"208\" y=\"507\">ZONA 4</text>\n      <text x=\"478\" y=\"507\">ZONA 5</text>\n    </g>\n\n    <text\n      class=\"ss4-footer\"\n      x=\"882\" y=\"555\"\n    >\n      Zonas 4 y 5 - Secador Línea #4\n    </text>\n\n  </svg>\n</div>",
  "css": ":root {\n  --ss4-font: \"Segoe UI\", Arial, sans-serif;\n  --ss4-number-font: \"IBM Plex Mono\", Consolas, monospace;\n\n  --ss4-metal: #D7D8DB;\n  --ss4-outline: #4E4E4E;\n  --ss4-fiber: #0A638F;\n\n  --ss4-steam: #930606;\n  --ss4-condensate: #4E4E4E;\n  --ss4-control: #01524F;\n  --ss4-valve: #0E0E55;\n  --ss4-text: #000000;\n\n  --ss4-roller-width: 2.2px;\n  --ss4-fiber-width: 1.8px;\n  --ss4-process-width: 1.6px;\n  --ss4-main-width: 2px;\n  --ss4-valve-width: 1.4px;\n}\n\n/* Entorno transparente */\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ss4-widget {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  font-family: var(--ss4-font);\n  pointer-events: none;\n}\n\n.ss4-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.ss4-widget,\n.ss4-widget * {\n  animation: none !important;\n  transition: none !important;\n}\n\n/* Metal satinado */\n\n.ss4-metal-stop {\n  stop-color: var(--ss4-metal);\n}\n\n/* Poleas */\n\n.ss4-roller {\n  fill: url(\"#ss4-roller-metal\");\n  stroke: var(--ss4-outline);\n  stroke-width: var(--ss4-roller-width);\n  filter: url(\"#ss4-roller-shadow\");\n}\n\n/* Cuerda */\n\n.ss4-fiber {\n  fill: none;\n  stroke: var(--ss4-fiber);\n  stroke-width: var(--ss4-fiber-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Tuberías */\n\n.ss4-steam,\n.ss4-condensate,\n.ss4-control {\n  fill: none;\n  stroke-width: var(--ss4-process-width);\n  stroke-linecap: butt;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ss4-steam {\n  stroke: var(--ss4-steam);\n}\n\n.ss4-condensate {\n  stroke: var(--ss4-condensate);\n}\n\n.ss4-control {\n  stroke: var(--ss4-control);\n}\n\n.ss4-main {\n  stroke-width: var(--ss4-main-width);\n  stroke-linecap: round;\n}\n\n.ss4-heater {\n  stroke-linecap: round;\n}\n\n.ss4-control-node {\n  fill: var(--ss4-control);\n  stroke: var(--ss4-control);\n  stroke-width: 1px;\n}\n\n/* Válvulas transparentes */\n\n.ss4-valve-body {\n  fill: none;\n  stroke: var(--ss4-valve);\n  stroke-width: var(--ss4-valve-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ss4-valve-link {\n  fill: none;\n  stroke: var(--ss4-valve);\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n}\n\n.ss4-valve-actuator {\n  fill: var(--ss4-valve);\n  stroke: var(--ss4-valve);\n  stroke-width: 1px;\n}\n\n/* Numeración encima de las poleas grandes */\n\n.ss4-number {\n  fill: var(--ss4-text);\n  stroke: none;\n  font-family: var(--ss4-number-font);\n  font-size: 13px;\n  font-weight: 700;\n  text-anchor: middle;\n  dominant-baseline: auto;\n  pointer-events: none;\n}\n\n/* Textos */\n\n.ss4-steam-label {\n  fill: var(--ss4-steam);\n  font-family: var(--ss4-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ss4-condensate-label {\n  fill: var(--ss4-condensate);\n  font-family: var(--ss4-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ss4-zone-label {\n  fill: var(--ss4-text);\n  font-family: var(--ss4-font);\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.ss4-footer {\n  fill: var(--ss4-text);\n  font-family: var(--ss4-font);\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
  "js": "\"use strict\";\n\n/*\n * SECADOR SECC. 3\n * Zonas 4 y 5 — Secador Línea #3.\n *\n * Widget gráfico completamente estático.\n *\n * Poleas con acabado metálico, sin hélices\n * ni puntos laterales.\n *\n * Solo las poleas grandes llevan números:\n * negros, de 13 px, situados encima y centrados.\n *\n * La polea pequeña de salida no lleva número.\n *\n * Cuerda tangente, dibujada detrás de las poleas.\n *\n * Válvulas transparentes con actuadores ovalados\n * y uniones horizontales de 0.7 px.\n *\n * No utiliza tags, variables del PLC, temporizadores,\n * animaciones ni recursos externos.\n */",
  "meta": {
