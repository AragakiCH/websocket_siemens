{
  "kind": "l3_1_lava_secc_1",
  "nombre": "L3 1 LAVA SECC 1",
  "html": "<div class=\"prestretch-widget\">\n  <svg\n    class=\"prestretch-svg\"\n    viewBox=\"0 0 885 525\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Cuba Pre-Estiramiento Lavadora Línea 2\"\n  >\n    <defs>\n      <!-- Contorno original de la cuba -->\n      <clipPath\n        id=\"pre1-tank-clip\"\n        clipPathUnits=\"userSpaceOnUse\"\n      >\n        <rect\n          x=\"84\"\n          y=\"239\"\n          width=\"756\"\n          height=\"37\"\n          rx=\"6\"\n          ry=\"6\"\n        />\n      </clipPath>\n\n      <!--\n        POLEAS: metal satinado.\n\n        Reflejo diagonal amplio y de bajo contraste.\n        Se conserva #D7D8DB como tono base.\n      -->\n      <linearGradient\n        id=\"pre1-roller-metal\"\n        x1=\"15%\"\n        y1=\"0%\"\n        x2=\"85%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"roller-metal-base\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"roller-metal-base\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- CUBA: reflejo suave sobre una superficie metálica -->\n      <linearGradient\n        id=\"pre1-tank-metal\"\n        x1=\"0%\"\n        y1=\"0%\"\n        x2=\"0%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#ECEEF0\" />\n        <stop offset=\"16%\" stop-color=\"#E2E4E7\" />\n        <stop offset=\"46%\" class=\"tank-metal-base\" />\n        <stop offset=\"62%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"84%\" class=\"tank-metal-base\" />\n        <stop offset=\"100%\" stop-color=\"#C6C8CD\" />\n      </linearGradient>\n\n      <!-- Franja azul: variación suave de profundidad -->\n      <linearGradient\n        id=\"pre1-liquid-gradient\"\n        x1=\"0%\"\n        y1=\"0%\"\n        x2=\"0%\"\n        y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#B3D9EE\" />\n        <stop offset=\"40%\" class=\"tank-liquid-base\" />\n        <stop offset=\"100%\" stop-color=\"#96C5E1\" />\n      </linearGradient>\n\n      <!--\n        SOMBRA DE POLEAS\n\n        Dos componentes calculados desde la silueta original:\n        una sombra ambiental suave y otra corta de contacto.\n      -->\n      <filter\n        id=\"pre1-roller-shadow\"\n        x=\"-30%\"\n        y=\"-30%\"\n        width=\"160%\"\n        height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\"\n          dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\"\n          dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!-- SOMBRA DE CUBA: ambiental y de contacto -->\n      <filter\n        id=\"pre1-tank-shadow\"\n        x=\"-3%\"\n        y=\"-35%\"\n        width=\"106%\"\n        height=\"185%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"2\"\n          result=\"tankAmbientBlur\"\n        />\n        <feOffset\n          in=\"tankAmbientBlur\"\n          dx=\"0\"\n          dy=\"2.5\"\n          result=\"tankAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.10\"\n          result=\"tankAmbientColor\"\n        />\n        <feComposite\n          in=\"tankAmbientColor\"\n          in2=\"tankAmbientOffset\"\n          operator=\"in\"\n          result=\"tankAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.5\"\n          result=\"tankContactBlur\"\n        />\n        <feOffset\n          in=\"tankContactBlur\"\n          dx=\"0\"\n          dy=\"0.8\"\n          result=\"tankContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.15\"\n          result=\"tankContactColor\"\n        />\n        <feComposite\n          in=\"tankContactColor\"\n          in2=\"tankContactOffset\"\n          operator=\"in\"\n          result=\"tankContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"tankAmbientShadow\" />\n          <feMergeNode in=\"tankContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!--\n        Sombra interior muy leve de la franja azul.\n        El efecto permanece dentro de su silueta.\n      -->\n      <filter\n        id=\"pre1-liquid-inset\"\n        x=\"-2%\"\n        y=\"-20%\"\n        width=\"104%\"\n        height=\"140%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.7\"\n          result=\"liquidBlur\"\n        />\n        <feOffset\n          in=\"liquidBlur\"\n          dx=\"0\"\n          dy=\"0.8\"\n          result=\"liquidOffset\"\n        />\n        <feComposite\n          in=\"SourceAlpha\"\n          in2=\"liquidOffset\"\n          operator=\"out\"\n          result=\"liquidInnerEdge\"\n        />\n        <feFlood\n          flood-color=\"#315F79\"\n          flood-opacity=\"0.16\"\n          result=\"liquidShadowColor\"\n        />\n        <feComposite\n          in=\"liquidShadowColor\"\n          in2=\"liquidInnerEdge\"\n          operator=\"in\"\n          result=\"liquidInnerShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"SourceGraphic\" />\n          <feMergeNode in=\"liquidInnerShadow\" />\n        </feMerge>\n      </filter>\n    </defs>\n\n    <!--\n      CUBA\n\n      Posición y dimensiones originales.\n      Franja azul con margen lateral e inferior de 4 unidades SVG.\n      Todo el conjunto queda detrás de la cuerda y las poleas.\n    -->\n    <g class=\"tank-group\">\n      <g clip-path=\"url(#pre1-tank-clip)\">\n        <rect\n          class=\"tank-upper\"\n          x=\"84\"\n          y=\"239\"\n          width=\"756\"\n          height=\"37\"\n        />\n\n        <rect\n          class=\"tank-lower\"\n          x=\"88\"\n          y=\"257.5\"\n          width=\"748\"\n          height=\"14.5\"\n          rx=\"3\"\n          ry=\"3\"\n        />\n\n        <!-- Reflejos de superficie, sin cambiar el contorno -->\n        <path\n          class=\"tank-top-highlight\"\n          d=\"M 91 240.2 L 833 240.2\"\n        />\n\n        <path\n          class=\"tank-bottom-shade\"\n          d=\"M 91 274.8 L 833 274.8\"\n        />\n      </g>\n\n      <rect\n        class=\"tank-outline\"\n        x=\"84\"\n        y=\"239\"\n        width=\"756\"\n        height=\"37\"\n        rx=\"6\"\n        ry=\"6\"\n      />\n    </g>\n\n    <!-- CONDENSADO -->\n    <g class=\"condensate-system\">\n      <!-- Estación izquierda -->\n      <path\n        class=\"condensate-line\"\n        d=\"M 115 276 L 115 476\"\n      />\n\n      <path\n        class=\"condensate-line\"\n        d=\"M 115 374 L 162 374 L 162 276\"\n      />\n\n      <!-- Estación central -->\n      <path\n        class=\"condensate-line\"\n        d=\"M 335 276 L 335 476\"\n      />\n\n      <!-- Estación derecha -->\n      <path\n        class=\"condensate-line\"\n        d=\"M 686 276 L 686 476\"\n      />\n\n      <path\n        class=\"condensate-line\"\n        d=\"M 686 374 L 731 374 L 731 276\"\n      />\n\n      <!-- Colector principal -->\n      <path\n        class=\"condensate-line condensate-main\"\n        d=\"M 854 476 L 21 476\"\n      />\n    </g>\n\n    <!-- VAPOR -->\n    <g class=\"steam-system\">\n      <!-- Estación izquierda -->\n      <path\n        class=\"steam-line\"\n        d=\"M 122 435 L 122 276\"\n      />\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 122 355 L 142 355 L 142 339\"\n      />\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"\n          M 142 321\n          L 142 264\n          L 152 274\n          L 162 264\n          L 162 276\n        \"\n      />\n\n      <!-- Estación central: sin línea dentro de la válvula -->\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"\n          M 355 435\n          L 355 355\n          L 354 339\n        \"\n      />\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"\n          M 354 321\n          L 354 264\n          L 344 274\n          L 335 264\n          L 335 276\n        \"\n      />\n\n      <!-- Estación derecha -->\n      <path\n        class=\"steam-line\"\n        d=\"M 694 435 L 694 276\"\n      />\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"M 694 355 L 713 355 L 713 339\"\n      />\n\n      <path\n        class=\"steam-line valve-connection\"\n        d=\"\n          M 713 321\n          L 713 264\n          L 722 274\n          L 731 264\n          L 731 276\n        \"\n      />\n\n      <!-- Colector principal -->\n      <path\n        class=\"steam-line steam-main\"\n        d=\"M 21 435 L 854 435\"\n      />\n    </g>\n\n    <!-- CONTROL -->\n    <g class=\"control-system\">\n      <path\n        class=\"control-line\"\n        d=\"M 225 264 L 225 330 L 159 330\"\n      />\n\n      <circle\n        class=\"control-node\"\n        cx=\"225\"\n        cy=\"264\"\n        r=\"3.5\"\n      />\n\n      <path\n        class=\"control-line\"\n        d=\"M 459 264 L 459 330 L 371 330\"\n      />\n\n      <circle\n        class=\"control-node\"\n        cx=\"459\"\n        cy=\"264\"\n        r=\"3.5\"\n      />\n\n      <path\n        class=\"control-line\"\n        d=\"M 771 264 L 771 330 L 730 330\"\n      />\n\n      <circle\n        class=\"control-node\"\n        cx=\"771\"\n        cy=\"264\"\n        r=\"3.5\"\n      />\n    </g>\n\n    <!--\n      VÁLVULAS\n\n      Cuerpos transparentes.\n      Actuadores ovalados: rx=3, ry=7.5.\n      Unión horizontal entre centros: 0.7 px.\n\n      El centro del actuador se sitúa en x=14:\n      su borde derecho queda en x=17, conservando la conexión\n      con las líneas de control existentes.\n    -->\n    <g class=\"valve-system\">\n      <!-- Válvula izquierda -->\n      <g\n        class=\"valve valve-vertical\"\n        transform=\"translate(142 330)\"\n      >\n        <line\n          class=\"valve-link\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"14\"\n          y2=\"0\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -9 -9 L 9 -9 L 0 0 Z\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -9 9 L 9 9 L 0 0 Z\"\n        />\n\n        <ellipse\n          class=\"valve-dot\"\n          cx=\"14\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n\n      <!-- Válvula central -->\n      <g\n        class=\"valve valve-vertical\"\n        transform=\"translate(354 330)\"\n      >\n        <line\n          class=\"valve-link\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"14\"\n          y2=\"0\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -9 -9 L 9 -9 L 0 0 Z\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -9 9 L 9 9 L 0 0 Z\"\n        />\n\n        <ellipse\n          class=\"valve-dot\"\n          cx=\"14\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n\n      <!-- Válvula derecha -->\n      <g\n        class=\"valve valve-vertical\"\n        transform=\"translate(713 330)\"\n      >\n        <line\n          class=\"valve-link\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"14\"\n          y2=\"0\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -9 -9 L 9 -9 L 0 0 Z\"\n        />\n\n        <path\n          class=\"valve-body\"\n          d=\"M -9 9 L 9 9 L 0 0 Z\"\n        />\n\n        <ellipse\n          class=\"valve-dot\"\n          cx=\"14\"\n          cy=\"0\"\n          rx=\"1.5\"\n          ry=\"6.5\"\n        />\n      </g>\n    </g>\n\n    <!-- CUERDA: recorrido original íntegro -->\n    <g class=\"fiber-group\">\n      <path\n        class=\"fiber\"\n        d=\"\n          M 45 0\n          L 146.3 173.9\n          A 20 20 0 0 1 148.9 185.9\n          L 145.1 225.0\n          A 21 21 0 0 0 187.0 226.5\n          L 186.0 184.5\n          A 21 21 0 0 1 227.9 186.0\n          L 224.1 225.0\n          A 21 21 0 0 0 266.0 227.0\n          L 266.0 184.0\n          A 20 20 0 0 1 287.418 164.050\n          L 367.582 249.950\n          A 20 20 0 0 1 369.0 250.0\n          L 566.0 249.0\n          A 20 20 0 0 1 582.1 240.9\n          L 632.9 172.1\n          A 20 20 0 0 1 669.0 183.5\n          L 670.0 227.5\n          A 21 21 0 0 0 712.0 225.5\n          L 709.1 185.4\n          A 20 20 0 0 1 749.0 184.5\n          L 748.0 226.5\n          A 21 21 0 0 0 790.0 225.5\n          L 787.1 185.4\n          A 20 20 0 0 1 789.3 174.8\n          L 880 0\n        \"\n      />\n    </g>\n\n    <!-- POLEAS: sin anillos interiores -->\n    <g class=\"rollers\">\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"129\" cy=\"184\" r=\"20\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"166\" cy=\"227\" r=\"21\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"207\" cy=\"184\" r=\"21\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"245\" cy=\"227\" r=\"21\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"286\" cy=\"184\" r=\"20\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"369\" cy=\"230\" r=\"20\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"566\" cy=\"229\" r=\"20\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"649\" cy=\"184\" r=\"20\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"691\" cy=\"227\" r=\"21\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"729\" cy=\"184\" r=\"20\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"769\" cy=\"227\" r=\"21\" />\n      </g>\n\n      <g class=\"roller-unit\">\n        <circle class=\"roller-body\" cx=\"807\" cy=\"184\" r=\"20\" />\n      </g>\n    </g>\n\n    <!-- NUMERACIÓN: 13 px, negro y centrado -->\n    <g class=\"roller-labels\">\n      <text class=\"roller-label\" x=\"129\" y=\"184\">1</text>\n      <text class=\"roller-label\" x=\"166\" y=\"227\">2</text>\n      <text class=\"roller-label\" x=\"207\" y=\"184\">3</text>\n      <text class=\"roller-label\" x=\"245\" y=\"227\">4</text>\n      <text class=\"roller-label\" x=\"286\" y=\"184\">5</text>\n      <text class=\"roller-label\" x=\"369\" y=\"230\">6</text>\n      <text class=\"roller-label\" x=\"566\" y=\"229\">7</text>\n      <text class=\"roller-label\" x=\"649\" y=\"184\">8</text>\n      <text class=\"roller-label\" x=\"691\" y=\"227\">9</text>\n      <text class=\"roller-label\" x=\"729\" y=\"184\">10</text>\n      <text class=\"roller-label\" x=\"769\" y=\"227\">11</text>\n      <text class=\"roller-label\" x=\"807\" y=\"184\">12</text>\n    </g>\n\n    <!-- TEXTOS -->\n    <g class=\"labels\">\n      <text\n        class=\"text-steam\"\n        x=\"20\"\n        y=\"427\"\n      >Vapor 15 bar</text>\n\n      <text\n        class=\"text-condensate\"\n        x=\"20\"\n        y=\"468\"\n      >Condensado</text>\n\n      <text\n        class=\"text-equipment\"\n        x=\"386\"\n        y=\"418\"\n      >CUBA PRE-ESTIRAMIENTO</text>\n\n      <text\n        class=\"text-footer\"\n        x=\"583\"\n        y=\"509\"\n      >Pre-Estiramiento Lavadora Línea #3</text>\n    </g>\n  </svg>\n</div>",
  "css": ":root {\n  /* Tipografía */\n  --pre-font-family: \"Segoe UI\", Arial, sans-serif;\n  --pre-number-font: \"IBM Plex Mono\", Consolas, monospace;\n\n  /* Textos */\n  --pre-text-primary: #000000;\n  --pre-text-secondary: #000000;\n\n  /* Cuerda */\n  --pre-fiber-color: #0A638F;\n\n  /* Poleas */\n  --pre-roller-fill: #D7D8DB;\n  --pre-roller-border: #4E4E4E;\n  --pre-roller-number: #000000;\n\n  /* Cuba */\n  --pre-tank-top: #D7D8DB;\n  --pre-tank-bottom: #A0CFE9;\n  --pre-tank-border: #223151;\n\n  /* Tuberías y control */\n  --pre-steam-color: #930606;\n  --pre-condensate-color: #4E4E4E;\n  --pre-control-color: #01524F;\n\n  /* Válvulas */\n  --pre-valve-color: #0E0E55;\n\n  /* Grosores */\n  --pre-fiber-width: 2.8px;\n  --pre-roller-border-width: 2.2px;\n  --pre-process-width: 1.6px;\n  --pre-process-main-width: 2px;\n  --pre-control-width: 1.6px;\n  --pre-tank-border-width: 1.4px;\n  --pre-valve-width: 1.4px;\n\n  /* Numeración del ZIP adjunto */\n  --pre-roller-number-size: 13px;\n}\n\n/* ==========================================================\n   ENTORNO TRANSPARENTE\n   ========================================================== */\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.prestretch-widget {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  font-family: var(--pre-font-family);\n  pointer-events: none;\n}\n\n.prestretch-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n/* Todo el acabado es estático */\n.prestretch-widget,\n.prestretch-widget * {\n  animation: none !important;\n  transition: none !important;\n}\n\n/* ==========================================================\n   COLORES BASE DE LOS DEGRADADOS\n   ========================================================== */\n\n.roller-metal-base {\n  stop-color: var(--pre-roller-fill);\n}\n\n.tank-metal-base {\n  stop-color: var(--pre-tank-top);\n}\n\n.tank-liquid-base {\n  stop-color: var(--pre-tank-bottom);\n}\n\n/* ==========================================================\n   CUBA: METAL SATINADO\n   ========================================================== */\n\n.tank-group {\n  filter: url(\"#pre1-tank-shadow\");\n}\n\n.tank-upper {\n  fill: url(\"#pre1-tank-metal\");\n  stroke: none;\n}\n\n.tank-lower {\n  fill: url(\"#pre1-liquid-gradient\");\n  stroke: none;\n  filter: url(\"#pre1-liquid-inset\");\n}\n\n.tank-outline {\n  fill: none;\n  stroke: var(--pre-tank-border);\n  stroke-width: var(--pre-tank-border-width);\n  stroke-linejoin: round;\n}\n\n/* Reflejos discretos sobre la superficie metálica */\n.tank-top-highlight {\n  fill: none;\n  stroke: #FFFFFF;\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n  opacity: 0.48;\n}\n\n.tank-bottom-shade {\n  fill: none;\n  stroke: #555D69;\n  stroke-width: 0.65px;\n  stroke-linecap: round;\n  opacity: 0.14;\n}\n\n/* ==========================================================\n   CUERDA\n   ========================================================== */\n\n.fiber {\n  fill: none;\n  stroke: var(--pre-fiber-color);\n  stroke-width: var(--pre-fiber-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* ==========================================================\n   POLEAS: METAL SATINADO SIN ANILLO INTERIOR\n   ========================================================== */\n\n.roller-body {\n  fill: url(\"#pre1-roller-metal\");\n  stroke: var(--pre-roller-border);\n  stroke-width: var(--pre-roller-border-width);\n  filter: url(\"#pre1-roller-shadow\");\n}\n\n.roller-label {\n  fill: var(--pre-roller-number);\n  font-family: var(--pre-number-font);\n  font-size: var(--pre-roller-number-size);\n  font-weight: 700;\n  text-anchor: middle;\n  dominant-baseline: middle;\n}\n\n/* ==========================================================\n   TUBERÍAS CONTINUAS\n   ========================================================== */\n\n.steam-line,\n.condensate-line,\n.control-line {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.steam-line {\n  stroke: var(--pre-steam-color);\n  stroke-width: var(--pre-process-width);\n}\n\n.condensate-line {\n  stroke: var(--pre-condensate-color);\n  stroke-width: var(--pre-process-width);\n}\n\n.steam-main,\n.condensate-main {\n  stroke-width: var(--pre-process-main-width);\n}\n\n/*\n * El trazo termina en el borde de la válvula.\n * No invade su interior transparente.\n */\n.valve-connection {\n  stroke-linecap: butt;\n}\n\n/* ==========================================================\n   CONTROL\n   ========================================================== */\n\n.control-line {\n  stroke: var(--pre-control-color);\n  stroke-width: var(--pre-control-width);\n}\n\n.control-node {\n  fill: var(--pre-control-color);\n  stroke: var(--pre-control-color);\n  stroke-width: 1px;\n}\n\n/* ==========================================================\n   VÁLVULAS TRANSPARENTES CON ACTUADOR OVALADO\n   ========================================================== */\n\n.valve-body {\n  fill: none;\n  stroke: var(--pre-valve-color);\n  stroke-width: var(--pre-valve-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Unión horizontal entre ambos centros */\n.valve-link {\n  fill: none;\n  stroke: var(--pre-valve-color);\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n}\n\n.valve-dot {\n  fill: var(--pre-valve-color);\n  stroke: var(--pre-valve-color);\n  stroke-width: 1px;\n}\n\n/* ==========================================================\n   TEXTOS\n   ========================================================== */\n\n.labels text {\n  font-family: var(--pre-font-family);\n}\n\n.text-steam {\n  fill: var(--pre-steam-color);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.text-condensate {\n  fill: var(--pre-condensate-color);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.text-equipment {\n  fill: var(--pre-text-primary);\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.text-footer {\n  fill: var(--pre-text-secondary);\n  font-size: 17px;\n  font-style: italic;\n  font-weight: 500;\n}",
  "js": "\"use strict\";\n\n/*\n * Cuba Pre-Estiramiento — Lavadora Línea 2.\n *\n * Widget gráfico completamente estático.\n *\n * El acabado metálico, los reflejos y las sombras se definen\n * mediante SVG y CSS, sin animaciones.\n *\n * No utiliza tags, variables del PLC, WIDGET, onWidgetUpdate,\n * temporizadores ni recursos externos.\n */",
