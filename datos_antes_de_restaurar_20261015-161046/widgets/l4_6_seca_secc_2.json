{
  "kind": "l4_6_seca_secc_2",
  "nombre": "L4 6 SECA SECC 2",
  "html": "<div class=\"ss2-widget\">\n  <svg\n    class=\"ss2-svg\"\n    viewBox=\"0 0 850 577\"\n    preserveAspectRatio=\"xMidYMid meet\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n    role=\"img\"\n    aria-label=\"Secador sección 2. Zona 3, Secador Línea número 3\"\n  >\n    <defs>\n\n      <!-- Metal satinado -->\n\n      <linearGradient\n        id=\"ss2-roller-metal\"\n        x1=\"15%\" y1=\"0%\"\n        x2=\"85%\" y2=\"100%\"\n      >\n        <stop offset=\"0%\" stop-color=\"#EFF0F2\" />\n        <stop offset=\"24%\" stop-color=\"#E2E3E6\" />\n        <stop offset=\"43%\" class=\"ss2-metal-stop\" />\n        <stop offset=\"56%\" stop-color=\"#E7E8EA\" />\n        <stop offset=\"74%\" class=\"ss2-metal-stop\" />\n        <stop offset=\"100%\" stop-color=\"#C3C5CA\" />\n      </linearGradient>\n\n      <!-- Sombra ambiental y de contacto -->\n\n      <filter\n        id=\"ss2-roller-shadow\"\n        x=\"-30%\" y=\"-30%\"\n        width=\"160%\" height=\"175%\"\n        color-interpolation-filters=\"sRGB\"\n      >\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"1.5\"\n          result=\"rollerAmbientBlur\"\n        />\n        <feOffset\n          in=\"rollerAmbientBlur\"\n          dx=\"0.3\" dy=\"2\"\n          result=\"rollerAmbientOffset\"\n        />\n        <feFlood\n          flood-color=\"#18212D\"\n          flood-opacity=\"0.12\"\n          result=\"rollerAmbientColor\"\n        />\n        <feComposite\n          in=\"rollerAmbientColor\"\n          in2=\"rollerAmbientOffset\"\n          operator=\"in\"\n          result=\"rollerAmbientShadow\"\n        />\n\n        <feGaussianBlur\n          in=\"SourceAlpha\"\n          stdDeviation=\"0.4\"\n          result=\"rollerContactBlur\"\n        />\n        <feOffset\n          in=\"rollerContactBlur\"\n          dx=\"0\" dy=\"0.65\"\n          result=\"rollerContactOffset\"\n        />\n        <feFlood\n          flood-color=\"#111820\"\n          flood-opacity=\"0.17\"\n          result=\"rollerContactColor\"\n        />\n        <feComposite\n          in=\"rollerContactColor\"\n          in2=\"rollerContactOffset\"\n          operator=\"in\"\n          result=\"rollerContactShadow\"\n        />\n\n        <feMerge>\n          <feMergeNode in=\"rollerAmbientShadow\" />\n          <feMergeNode in=\"rollerContactShadow\" />\n          <feMergeNode in=\"SourceGraphic\" />\n        </feMerge>\n      </filter>\n\n      <!-- Polea grande -->\n\n      <ellipse\n        id=\"ss2-roller\"\n        class=\"ss2-roller\"\n        cx=\"0\" cy=\"0\"\n        rx=\"41\" ry=\"43\"\n      />\n\n    </defs>\n\n    <!-- ==================================================\n         CIRCUITO SUPERIOR DE VAPOR\n         ================================================== -->\n\n    <path\n      class=\"ss2-steam\"\n      d=\"\n        M 164 159\n        L 145 132\n        V 38\n        H 409\n      \"\n    />\n\n    <!-- Calefactor superior izquierdo -->\n\n    <path\n      class=\"ss2-steam ss2-heater\"\n      d=\"\n        M 192 38\n        V 17\n        L 202 27\n        L 213 17\n        V 57\n      \"\n    />\n\n    <!-- Calefactor superior derecho -->\n\n    <path\n      class=\"ss2-steam ss2-heater\"\n      d=\"\n        M 409 38\n        V 18\n        L 419 28\n        L 429 18\n        V 57\n      \"\n    />\n\n    <!-- ==================================================\n         RETORNO SUPERIOR DE CONDENSADO\n         ================================================== -->\n\n    <path\n      class=\"ss2-condensate\"\n      d=\"\n        M 213 57\n        H 675\n        V 140\n        L 750 335\n        V 526\n      \"\n    />\n\n    <!-- ==================================================\n         COLUMNA CENTRAL\n         Tubería separada alrededor de la válvula.\n         ================================================== -->\n\n    <path\n      class=\"ss2-steam\"\n      d=\"M 200 223.4 V 349\"\n    />\n\n    <path\n      class=\"ss2-steam\"\n      d=\"M 200 367 V 485\"\n    />\n\n    <!-- ==================================================\n         CIRCUITO INFERIOR DE CALEFACCIÓN\n         ================================================== -->\n\n    <path\n      class=\"ss2-steam ss2-heater\"\n      d=\"\n        M 200 313\n        H 489\n        V 292\n        L 499 302\n        L 509 292\n        V 330\n      \"\n    />\n\n    <path\n      class=\"ss2-steam ss2-heater\"\n      d=\"\n        M 244 313\n        V 292\n        L 254 302\n        L 265 292\n        V 330\n      \"\n    />\n\n    <!-- Retorno inferior -->\n\n    <path\n      class=\"ss2-condensate\"\n      d=\"M 265 330 H 532 V 526\"\n    />\n\n    <!-- ==================================================\n         CONTROL\n         ================================================== -->\n\n    <path\n      class=\"ss2-control\"\n      d=\"M 346 261 V 358 H 219\"\n    />\n\n    <circle\n      class=\"ss2-control-node\"\n      cx=\"346\" cy=\"261\"\n      r=\"3.5\"\n    />\n\n    <!-- ==================================================\n         VÁLVULA PROPORCIONAL\n         ================================================== -->\n\n    <g transform=\"translate(200 358)\">\n      <path\n        class=\"ss2-valve-body\"\n        d=\"M -9 -9 H 9 L 0 0 Z\"\n      />\n\n      <path\n        class=\"ss2-valve-body\"\n        d=\"M -9 9 H 9 L 0 0 Z\"\n      />\n\n      <line\n        class=\"ss2-valve-link\"\n        x1=\"0\" y1=\"0\"\n        x2=\"17\" y2=\"0\"\n      />\n\n      <ellipse\n        class=\"ss2-valve-actuator\"\n        cx=\"17\" cy=\"0\"\n        rx=\"1.5\" ry=\"6.5\"\n      />\n    </g>\n\n    <!-- ==================================================\n         COLECTORES PRINCIPALES\n         ================================================== -->\n\n    <path\n      class=\"ss2-steam ss2-main\"\n      d=\"M 0 485 H 850\"\n    />\n\n    <path\n      class=\"ss2-condensate ss2-main\"\n      d=\"M 0 526 H 850\"\n    />\n\n    <!-- ==================================================\n         CUERDA\n         Recorrido continuo tangente a las poleas.\n         ================================================== -->\n\n    <path\n      class=\"ss2-fiber\"\n      d=\"\n        M 147 300\n        L 162.335288 175.012043\n        A 41 43 0 0 1 243.935646 182.908286\n        L 241.064354 236.591714\n        A 41 43 0 1 0 322.993581 239.760881\n        L 324.006419 179.739119\n        A 41 43 0 1 1 405.993233 181.281204\n        L 405.006767 238.218796\n        A 41 43 0 1 0 486.993233 238.218796\n        L 486.006767 181.281204\n        A 41 43 0 1 1 567.936825 182.886140\n        L 565.063175 237.113860\n        A 41 43 0 1 0 646.997639 239.961421\n        L 648 142\n      \"\n    />\n\n    <!-- ==================================================\n         POLEAS\n         Sin hélices, anillos interiores ni puntos laterales.\n         Se dibujan sobre la cuerda.\n         ================================================== -->\n\n    <g aria-label=\"Poleas del secador\">\n      <use\n        href=\"#ss2-roller\"\n        transform=\"translate(203 180.5)\"\n      />\n\n      <use\n        href=\"#ss2-roller\"\n        transform=\"translate(282 239)\"\n      />\n\n      <use\n        href=\"#ss2-roller\"\n        transform=\"translate(365 180.5)\"\n      />\n\n      <use\n        href=\"#ss2-roller\"\n        transform=\"translate(446 239)\"\n      />\n\n      <use\n        href=\"#ss2-roller\"\n        transform=\"translate(527 180.5)\"\n      />\n\n      <use\n        href=\"#ss2-roller\"\n        transform=\"translate(606 239.5)\"\n      />\n    </g>\n\n    <!-- ==================================================\n         NUMERACIÓN SOBRE CADA POLEA\n         Centrada respecto a su eje horizontal.\n         ================================================== -->\n\n    <g class=\"ss2-number\">\n      <text x=\"203\" y=\"129.5\">9</text>\n      <text x=\"282\" y=\"188\">10</text>\n      <text x=\"365\" y=\"129.5\">11</text>\n      <text x=\"446\" y=\"188\">12</text>\n      <text x=\"527\" y=\"129.5\">13</text>\n      <text x=\"606\" y=\"188.5\">14</text>\n    </g>\n\n    <!-- ==================================================\n         TEXTOS\n         ================================================== -->\n\n    <text\n      class=\"ss2-steam-label\"\n      x=\"19\" y=\"476\"\n    >\n      Vapor 15 bar\n    </text>\n\n    <text\n      class=\"ss2-condensate-label\"\n      x=\"20\" y=\"516\"\n    >\n      Condensado\n    </text>\n\n    <text\n      class=\"ss2-zone-label\"\n      x=\"453\" y=\"512\"\n    >\n      ZONA 3\n    </text>\n\n    <text\n      class=\"ss2-footer\"\n      x=\"837\" y=\"566\"\n    >\n      Zona 3 - Secador Línea #4\n    </text>\n\n  </svg>\n</div>",
  "css": ":root {\n  --ss2-font: \"Segoe UI\", Arial, sans-serif;\n  --ss2-number-font: \"IBM Plex Mono\", Consolas, monospace;\n\n  --ss2-metal: #D7D8DB;\n  --ss2-outline: #4E4E4E;\n  --ss2-fiber: #0A638F;\n\n  --ss2-steam: #930606;\n  --ss2-condensate: #4E4E4E;\n  --ss2-control: #01524F;\n  --ss2-valve: #0E0E55;\n  --ss2-text: #000000;\n\n  --ss2-roller-width: 2.2px;\n  --ss2-fiber-width: 1.8px;\n  --ss2-process-width: 1.6px;\n  --ss2-main-width: 2px;\n  --ss2-valve-width: 1.4px;\n}\n\n/* Entorno transparente */\n\nhtml,\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.ss2-widget {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: transparent;\n  font-family: var(--ss2-font);\n  pointer-events: none;\n}\n\n.ss2-svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background: transparent;\n  shape-rendering: geometricPrecision;\n}\n\n.ss2-widget,\n.ss2-widget * {\n  animation: none !important;\n  transition: none !important;\n}\n\n/* Metal satinado */\n\n.ss2-metal-stop {\n  stop-color: var(--ss2-metal);\n}\n\n/* Poleas */\n\n.ss2-roller {\n  fill: url(\"#ss2-roller-metal\");\n  stroke: var(--ss2-outline);\n  stroke-width: var(--ss2-roller-width);\n  filter: url(\"#ss2-roller-shadow\");\n}\n\n/* Cuerda */\n\n.ss2-fiber {\n  fill: none;\n  stroke: var(--ss2-fiber);\n  stroke-width: var(--ss2-fiber-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n/* Tuberías */\n\n.ss2-steam,\n.ss2-condensate,\n.ss2-control {\n  fill: none;\n  stroke-width: var(--ss2-process-width);\n  stroke-linecap: butt;\n  stroke-linejoin: round;\n  stroke-dasharray: none;\n}\n\n.ss2-steam {\n  stroke: var(--ss2-steam);\n}\n\n.ss2-condensate {\n  stroke: var(--ss2-condensate);\n}\n\n.ss2-control {\n  stroke: var(--ss2-control);\n}\n\n.ss2-main {\n  stroke-width: var(--ss2-main-width);\n  stroke-linecap: round;\n}\n\n.ss2-heater {\n  stroke-linecap: round;\n}\n\n.ss2-control-node {\n  fill: var(--ss2-control);\n  stroke: var(--ss2-control);\n  stroke-width: 1px;\n}\n\n/* Válvula transparente */\n\n.ss2-valve-body {\n  fill: none;\n  stroke: var(--ss2-valve);\n  stroke-width: var(--ss2-valve-width);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.ss2-valve-link {\n  fill: none;\n  stroke: var(--ss2-valve);\n  stroke-width: 0.7px;\n  stroke-linecap: round;\n}\n\n.ss2-valve-actuator {\n  fill: var(--ss2-valve);\n  stroke: var(--ss2-valve);\n  stroke-width: 1px;\n}\n\n/* Numeración por encima de las poleas */\n\n.ss2-number {\n  fill: var(--ss2-text);\n  stroke: none;\n  font-family: var(--ss2-number-font);\n  font-size: 13px;\n  font-weight: 700;\n  text-anchor: middle;\n  dominant-baseline: auto;\n  pointer-events: none;\n}\n\n/* Textos */\n\n.ss2-steam-label {\n  fill: var(--ss2-steam);\n  font-family: var(--ss2-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ss2-condensate-label {\n  fill: var(--ss2-condensate);\n  font-family: var(--ss2-font);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.ss2-zone-label {\n  fill: var(--ss2-text);\n  font-family: var(--ss2-font);\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.ss2-footer {\n  fill: var(--ss2-text);\n  font-family: var(--ss2-font);\n  font-size: 16px;\n  font-style: italic;\n  font-weight: 500;\n  text-anchor: end;\n}",
  "js": "\"use strict\";\n\n/*\n * SECADOR SECC. 2\n * Zona 3 — Secador Línea #3.\n *\n * Widget gráfico completamente estático.\n *\n * Poleas con acabado metálico, sin hélices\n * ni puntos laterales.\n *\n * Numeración negra de 13 px, situada encima de cada\n * polea y centrada respecto a su eje horizontal.\n *\n * Cuerda tangente, dibujada detrás de las poleas.\n *\n * Válvula transparente con actuador ovalado\n * y unión horizontal de 0.7 px.\n *\n * No utiliza tags, variables del PLC, temporizadores,\n * animaciones ni recursos externos.\n */",
