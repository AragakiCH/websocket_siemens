# ==========================================================================
# Copia este archivo como `.env` y ajusta los valores a tu red.
# Todas las variables usan el prefijo PLC_.
# ==========================================================================

# Arranque limpio: sin PLCs automaticos; se agregan desde la vista web.
PLC_AUTOSTART_PLCS=false

# Subred a escanear con el boton "Escanear red" (formato CIDR):
# PLC_DISCOVERY_SUBNET=192.168.50.0/24

# PLCs fijos que se conectan solos al arrancar (requiere autostart=true):
# PLC_AUTOSTART_PLCS=true
# PLC_STATIC_ENDPOINTS=opc.tcp://192.168.50.1:4840,opc.tcp://192.168.50.2:4840

# Intervalos de subscription OPC UA (ms):
# PLC_SAMPLING_INTERVAL_MS=1000
# PLC_PUBLISHING_INTERVAL_MS=500

# Nivel de log: DEBUG | INFO | WARNING
# PLC_LOG_LEVEL=INFO


# ==========================================================================
# ZONA HORARIA
# ==========================================================================
# Los datos SIEMPRE se guardan en UTC: el SourceTimestamp de OPC UA es UTC por
# especificacion, y guardar en UTC es lo unico que no se rompe con cambios de
# horario ni al comparar plantas de paises distintos.
#
# Esta variable es solo de VISUALIZACION: las lecturas del historico devuelven
# `ts` (UTC) y ademas `ts_local` ya convertido a esta zona.
#
# Por eso, si abres la tabla en phpMyAdmin, veras la hora UTC (en Peru, 5 horas
# por delante de la hora local). No es un error: es el dato correcto sin
# convertir.
#
# Nombre IANA. 'UTC' desactiva la conversion (ts_local == ts).
# Si el nombre no se puede resolver (en Windows hace falta el paquete
# `tzdata`: pip install tzdata), se usa la zona del propio equipo — NO UTC.
# PLC_TIMEZONE=America/Lima
#
# En que hora se ESCRIBE `ts` en la base de datos (historico, alarmas,
# recetas, ultimo acceso) y en que hora se interpreta al leer:
#   local -> la de PLC_TIMEZONE: lo que se ve en SSMS es la hora de la
#            planta. (Defecto.)
#   utc   -> como antes. Solo si varias plantas en zonas distintas comparten
#            la misma base.
# Cambiarlo con datos ya guardados los desplaza: decide al principio.
# PLC_HISTORICO_HORA=local

# En Windows puede faltar la base de datos de zonas horarias. Si en el log ves
# "Zona horaria no disponible; se usa UTC", instala:  pip install tzdata


# ==========================================================================
# MARCA DEL PLC
# ==========================================================================
# Marca POR DEFECTO de los PLCs que se dan de alta sin especificarla (arranque
# automatico y escaneo de red). Los PLCs agregados desde la vista web mandan
# siempre la suya, asi que puedes tener Siemens, Rexroth y Allen-Bradley a la
# vez sin tocar esto. Valores: siemens | rexroth | allenbradley
# PLC_VENDOR=siemens


# ==========================================================================
# SIEMENS sin OPC UA: S7comm por el puerto 102  (vendor=siemens)
# ==========================================================================
# Un S7-1500 tiene servidor OPC UA siempre. Un S7-1200 SOLO desde FW 4.4, y
# hay que activarlo (Propiedades -> OPC UA -> Servidor) y licenciarlo; un
# S7-300/400 nunca lo tiene. Para esos, S7comm (python-snap7, Python puro).
#
#   opcua   -> descubre los DB solo (defecto)
#   s7comm  -> lee DBs por direccion absoluta; la lista de tags la das tu
# PLC_SIEMENS_TRANSPORTE=opcua
# PLC_S7_RACK=0
# PLC_S7_SLOT=1                 # 1 en S7-1200/1500, 2 en S7-300
# PLC_S7_CONNECT_TIMEOUT=5.0
# PLC_S7_POLL_INTERVAL_MS=250   # S7comm no tiene subscription: siempre polling
#
# Lista de tags para S7comm (una por linea; en el .env, con \n):
#   nombre;DB1;offset;TIPO      offset con bit para BOOL (4.0); STRING[n]
# PLC_S7_TAGS=temperatura;DB1;0;REAL\nmarcha;DB1;4.0;BOOL
#
# EN TIA PORTAL, o no lee nada: (1) CPU -> Proteccion y seguridad -> marcar
# "Permitir acceso via comunicacion PUT/GET"; (2) en cada DB, DESMARCAR
# "Acceso optimizado al bloque"; (3) compilar y cargar. Los offsets salen de
# la columna "Offset" del editor del DB. Lo normal es agregar los PLC desde
# la vista (boton Identificar), no desde aqui.


# ==========================================================================
# ALLEN-BRADLEY / ROCKWELL Logix por EtherNet/IP  (vendor=allenbradley)
# ==========================================================================
# ControlLogix, CompactLogix, GuardLogix y Micro800, por CIP en el puerto
# 44818 (paquete pycomm3, pura Python: no hace falta RSLinx). NO hay usuario
# ni contrasena: EtherNet/IP no autentica. Solo IP y slot del procesador.
#
# Slot por defecto (0 en CompactLogix; en ControlLogix, el del modulo CPU).
# Cada PLC puede traer el suyo al darse de alta.
# PLC_AB_SLOT=0
# Micro800: sin slot en la ruta CIP.
# PLC_AB_MICRO800=false
# PLC_AB_CONNECT_TIMEOUT=5.0
#
# EtherNet/IP explicito no tiene subscription: siempre es POLLING en bloque
# (multi-service packet), emitiendo solo lo que cambia.
# PLC_AB_POLL_INTERVAL_MS=250
# PLC_AB_BULK_MAX=100
#
# Upload de tags: incluir los de programa (Program:Main.x) ademas de los del
# controlador; profundidad al aplanar UDT/TIMER/COUNTER; tope de elementos
# por array (un DINT[10000] no debe convertirse en diez mil tags).
# PLC_AB_INCLUIR_PROGRAMAS=true
# PLC_AB_BROWSE_DEPTH=3
# PLC_AB_MAX_ELEMENTOS_ARRAY=64
#
# Lista manual de tags (coma, ; o salto de linea). Si se indica, solo se
# exponen esos. Util para acotar o en Micro800 con firmware antiguo.
# PLC_AB_TAGS=Velocidad,Marcha,Program:Main.Ciclos


# ==========================================================================
# BOSCH REXROTH ctrlX CORE  (solo si usas PLCs Rexroth)
# ==========================================================================
# COMO se habla con el ctrlX:
#   datalayer  -> API REST del Data Layer por HTTPS (DEFECTO). Login con
#                 usuario/contrasena contra el identity-manager (JWT), lectura
#                 en bloque y eventos SSE. Sin OPC UA y SIN certificado de
#                 cliente que aceptar en el ctrlX. Es lo que ya funcionaba en
#                 WebSocket_RX, adaptado aqui.
#   opcua      -> el camino OPC UA de antes (asyncua + certificado).
# PLC_REXROTH_TRANSPORTE=datalayer

# Puerto HTTPS del ctrlX: 443 en hardware, 8443 en un COREvirtual con
# port-forwarding. Solo aplica a 'datalayer'. (El :4840 de OPC UA ya no se usa.)
# PLC_REXROTH_HTTPS_PORT=443

# El ctrlX trae un certificado HTTPS autofirmado; por defecto se acepta.
# Con una PKI propia en planta, ponlo en true.
# PLC_REXROTH_VERIFY_SSL=false

# Nodos por peticion de lectura en bloque (bulk-read).
# PLC_REXROTH_BULK_MAX=200

# El ctrlX NO admite sesiones anonimas: usuario y contrasena son obligatorios.
# Si los PLCs se agregan desde la vista web, estas variables no hacen falta:
# solo sirven como valores por defecto y para el arranque automatico.
# PLC_REXROTH_USERNAME=boschrexroth
# PLC_REXROTH_PASSWORD=boschrexroth

# Ruta de los datos dentro del Data Layer:
#   Datalayer/plc/app/<PLC_REXROTH_APP>/sym/<PLC_REXROTH_PROGRAM>
# PLC_REXROTH_APP=Application
# PLC_REXROTH_PROGRAM=PLC_PRG

# Profundidad maxima al recorrer estructuras anidadas dentro del programa:
# PLC_REXROTH_BROWSE_DEPTH=4

# ---- Solo con PLC_REXROTH_TRANSPORTE=opcua ------------------------------
# Certificado de cliente OPC UA. Si se dejan vacios se genera uno solo y se
# reutiliza (Windows: %LOCALAPPDATA%\HMI-Studio\opcua). IMPORTANTE: la primera
# vez hay que ACEPTAR ese certificado en la web del ctrlX
# (Settings -> Certificates & Keys -> OPC UA Server -> Trusted).
# PLC_REXROTH_CERT_PATH=C:\certs\client_cert.pem
# PLC_REXROTH_KEY_PATH=C:\certs\client_key.pem
# PLC_REXROTH_APPLICATION_URI=urn:psi:hmi-studio
# PLC_REXROTH_APPLICATION_NAME=HMI Studio
# PLC_REXROTH_CONNECT_TIMEOUT=8.0

# ---- Comun a los dos transportes -----------------------------------------
# Muestreo (ms): publishIntervalMs del SSE en 'datalayer', sampling interval
# de la subscription en 'opcua'. No tiene el minimo de 1000 ms del S7-1500.
# PLC_REXROTH_SAMPLING_INTERVAL_MS=100

# Fallback automatico a polling: si el SSE / la subscription no entrega ningun
# dato en estos segundos, se cierra y se lee por polling al intervalo indicado.
# PLC_REXROTH_SUBSCRIPTION_GRACE_S=5.0
# PLC_REXROTH_POLL_INTERVAL_MS=100

# Saltarse el intento de subscription e ir directo a polling (como el
# WebSocket_RX original). Util si tu ctrlX no soporta bien las subscriptions.
# PLC_REXROTH_FORCE_POLLING=false


# ==========================================================================
# MULTIUSUARIO
# ==========================================================================
# Exigir inicio de sesion en todo lo que modifique algo (PLCs, BD, diseno).
# Por defecto FALSE para no romper instalaciones existentes, pero en planta
# deberia estar en TRUE: si no, cualquiera que abra la URL puede borrar un
# PLC de produccion.
#
# Modo arranque: mientras NO exista ninguna cuenta, los endpoints de
# administracion quedan abiertos aunque esto sea true. Es la unica forma de
# poder configurar la BD donde viven los usuarios. En cuanto se crea la
# primera cuenta (que sera Supervisor), la puerta se cierra sola.
# PLC_AUTH_REQUERIDA=true

# Conexion donde vive la tabla `usuarios`. Vacio = la primera dada de alta.
# PLC_AUTH_DB_ID=local

# Prefijo de la tabla, si creaste el esquema con uno (planta1 -> planta1_usuarios)
# PLC_AUTH_TABLA_PREFIJO=

# Carpeta donde se persiste el estado (conexiones, proyectos, PLCs, auditoria).
# Por defecto <raiz del proyecto>/datos. Util para el ejecutable de escritorio
# (que corre desde una ruta de solo lectura) y para pruebas aisladas.
# PLC_DATOS_DIR=C:\ProgramData\PsiCore\datos

# Migracion automatica de la carpeta de datos.
#
# Si PLC_DATOS_DIR apunta a una carpeta VACIA, la aplicacion busca datos de
# una instalacion anterior y los COPIA alli (nunca los mueve). Eso es lo que
# hace que actualizar de version no pierda las conexiones ni las pantallas.
#
# Ponlo en false para una ejecucion que deba partir de cero de verdad: una
# carpeta temporal recien creada esta vacia, asi que sin esto una prueba
# "aislada" se trae la configuracion de produccion entera, incluida la clave
# de cifrado y las contrasenas de las bases de datos. Los scripts de tools/
# ya lo ponen solos.
# PLC_MIGRAR_DATOS=false

# ---------------------------------------------------------------------------
#  Motor de alarmas
# ---------------------------------------------------------------------------
# Evalua las reglas de `alarmas_def` contra los valores que llegan del PLC y
# escribe los eventos en `alarmas`. Se cuelga del mismo flujo que el
# historizador: no abre una segunda sesion OPC UA ni anade carga al PLC.
# Ver docs/ALARMAS.md.
#
# false silencia la evaluacion SIN borrar ninguna regla: las definiciones se
# conservan y se pueden seguir editando.
# PLC_ALARMAS_ENABLED=true

# Conexion donde viven `alarmas_def` y `alarmas`. Vacio = la de por defecto
# del CRUD, que es lo correcto con una sola base. Se separa por si el
# historico crece tanto que hay que llevarlo a otro servidor.
# PLC_ALARMAS_DB_ID=local
